        READ TABLE IT_INSP_DAT INTO WA_INSP_DAT WITH KEY CHARGJR = ITAB-CHARGJR POSISI = V_POSISI INSPTEXT = 'OTR' TIMES = 4 CYCLES = V_MAX_CYCLE.
