INITIALIZATION.
  TXT1 = 'Pending List Judgement Barrier'.
  TXT2 = 'Upload Barrier Judgement'.

AT SELECTION-SCREEN OUTPUT.
  CASE SY-DYNNR.
    WHEN 3000.
  ENDCASE.

AT SELECTION-SCREEN.
  CASE SY-DYNNR.
    WHEN 3000.
      CASE SY-UCOMM.
        WHEN 'CCAN'.
          CALL SELECTION-SCREEN 1000.
        WHEN 'CBAC'.
          CALL SELECTION-SCREEN 1000 .
        WHEN 'CRET'.
          IF S_GSTRP IS INITIAL.
            MESSAGE 'Please input one of inspection date !!' TYPE 'I'.
            LEAVE TO SCREEN 3000.
          ELSEIF V_ROLL IS INITIAL AND S_GSTRP IS INITIAL  AND V_FILM IS INITIAL AND V_ROLL IS INITIAL AND V_CHARGJ IS INITIAL.
            MESSAGE 'Please input at least one parameter !!' TYPE 'I'.
            LEAVE TO SCREEN 3000.
          ELSE.
            CLEAR : S_GSTRTP.
            REFRESH : S_GSTRTP.
            SELECT * INTO TABLE IT_MAP_CUTDATE FROM ZMAP_TYPE WHERE PROG = SY-REPID AND TYPE = 'BARRIER' AND OPT = 'CUT OVER' AND DELETION = ''.
            READ TABLE IT_MAP_CUTDATE INDEX 1.
            PERFORM CONVERT_DATE_INPUT USING IT_MAP_CUTDATE-VALUE CHANGING V_CUTDATE.
            IF IT_MAP_CUTDATE[] IS NOT INITIAL.
              READ TABLE IT_MAP_CUTDATE INDEX 1.
              IF SY-SUBRC EQ 0.
                LOOP AT S_GSTRP.
                  IF S_GSTRP-LOW LT V_CUTDATE.
                    MESSAGE IT_MAP_CUTDATE-TEXT5 TYPE 'I'.
                    LEAVE TO SCREEN 3000.
                  ENDIF.
                ENDLOOP.
              ENDIF.
            ENDIF.
            IF S_GSTRP IS NOT INITIAL.
              APPEND LINES OF S_GSTRP TO S_GSTRTP.
            ENDIF.
            PERFORM GET_INITIAL_DATA.
            PERFORM POPULATE_INSPECTION_DATA.
            PERFORM DELETE_NOT_YET.
            CLEAR : V_MESSAGE.
            IF IT_OUTPUT[] IS INITIAL.
              MESSAGE 'Data not found!' TYPE 'S' DISPLAY LIKE 'E'.
              LEAVE TO SCREEN 3000.
            ELSE.
              LEAVE TO SCREEN 0100.
            ENDIF.
          ENDIF.
      ENDCASE.
    WHEN 4000.
      CASE SY-UCOMM.
        WHEN 'CBAC'.
          CALL SELECTION-SCREEN 1000.
        WHEN 'CCAN'.
          CALL SELECTION-SCREEN 1000.
        WHEN 'CRET'.
          PERFORM UPLOAD_FILE.
      ENDCASE.
  ENDCASE.

AT SELECTION-SCREEN ON VALUE-REQUEST FOR FILENAME.
  CALL FUNCTION 'WS_FILENAME_GET'
    EXPORTING
      MODE             = 'O'
      TITLE            = 'Select File'
    IMPORTING
      FILENAME         = FILENAME
    EXCEPTIONS
      INV_WINSYS       = 1
      NO_BATCH         = 2
      SELECTION_CANCEL = 3
      SELECTION_ERROR  = 4
      OTHERS           = 5.

START-OF-SELECTION.
  IF V_RBP EQ 'X'.
    CALL SELECTION-SCREEN 3000.
  ELSEIF V_RBU EQ 'X'.
    CALL SELECTION-SCREEN 4000.
  ENDIF.

END-OF-SELECTION.

