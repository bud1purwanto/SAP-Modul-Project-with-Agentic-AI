*&---------------------------------------------------------------------*
*&      Form  UPDATE_JUDGEMENT_DELETE
*&---------------------------------------------------------------------*
FORM UPDATE_JUDGEMENT_DELETE.
  DATA: L_ANSWER TYPE C.
  DATA: LV_PRUEFLOS TYPE QALS-PRUEFLOS,
        LV_MULTIPLE_LOTS TYPE C.

  CLEAR: LV_PRUEFLOS, LV_MULTIPLE_LOTS.
  LOOP AT LT_ROW_NO.
    READ TABLE IT_OUTPUT INTO WA_OUTPUT INDEX LT_ROW_NO-ROW_ID.
    IF SY-SUBRC = 0.
      IF LV_PRUEFLOS IS INITIAL.
        LV_PRUEFLOS = WA_OUTPUT-PRUEFLOS.
      ELSEIF LV_PRUEFLOS <> WA_OUTPUT-PRUEFLOS.
        LV_MULTIPLE_LOTS = 'X'.
        EXIT.
      ENDIF.
    ENDIF.
  ENDLOOP.

  IF LV_MULTIPLE_LOTS = 'X'.
    MESSAGE 'Penghapusan (Delete) hanya dapat dilakukan dalam 1 Inspection Lot yang sama!' TYPE 'S' DISPLAY LIKE 'E'.
    EXIT.
  ENDIF.

  CALL METHOD G_GRID->REFRESH_TABLE_DISPLAY.
  CLEAR : ITAB, V_ERR .
  REFRESH : ITAB.
  LOOP AT IT_OUTPUT INTO WA_OUTPUT.
    WA_OUTPUT-ZSTAT = GREY.
    WA_OUTPUT-BOX = ''.
    WA_OUTPUT-ERR = ''.
    WA_OUTPUT-MESS = ''.
    MODIFY IT_OUTPUT FROM WA_OUTPUT INDEX SY-TABIX.
  ENDLOOP.
  LOOP AT LT_ROW_NO.
    READ TABLE IT_OUTPUT INTO WA_OUTPUT INDEX LT_ROW_NO-ROW_ID.
    WA_OUTPUT-BOX = 'X'.
    " --- NEW: Cek apakah Lot punya UD sebelumnya ---
    IF WA_OUTPUT-PRUEFLOS IS NOT INITIAL.
      SELECT SINGLE STAT35 INTO WA_OUTPUT-HAS_UD FROM QALS WHERE PRUEFLOS = WA_OUTPUT-PRUEFLOS.
      IF WA_OUTPUT-HAS_UD EQ 'X'.
        SELECT SINGLE VCODE VCODEGRP VAUSWAHLMG
          INTO (WA_OUTPUT-OLD_UD, WA_OUTPUT-OLD_CODEGRP,
                WA_OUTPUT-OLD_SELECTED_SET)
          FROM QAVE
          WHERE PRUEFLOS = WA_OUTPUT-PRUEFLOS.
      ENDIF.
    ENDIF.
    " -----------------------------------------------
    MODIFY IT_OUTPUT FROM WA_OUTPUT INDEX LT_ROW_NO-ROW_ID.
  ENDLOOP.
  APPEND LINES OF IT_OUTPUT TO ITAB.

  CALL FUNCTION 'POPUP_TO_CONFIRM'
    EXPORTING
      TITLEBAR              = 'Delete Confirmation'
      TEXT_QUESTION         = 'Are you sure you want to delete the selected values?'
      TEXT_BUTTON_1         = 'Yes'
      ICON_BUTTON_1         = 'ICON_OKAY'
      TEXT_BUTTON_2         = 'No'
      ICON_BUTTON_2         = 'ICON_CANCEL'
      DISPLAY_CANCEL_BUTTON = ' '
    IMPORTING
      ANSWER                = L_ANSWER.

  IF L_ANSWER NE '1'.
    CALL METHOD G_GRID->REFRESH_TABLE_DISPLAY.
    EXIT.
  ENDIF.

  PERFORM CONFIRMATION_DELETE.

  IF V_ERR NE 'X'.
    PERFORM REFRESH.
    PERFORM CHECK_ERROR.

    CLEAR : IT_OUTPUT.
    REFRESH : IT_OUTPUT.
    APPEND LINES OF ITAB TO IT_OUTPUT.
    CALL METHOD G_GRID->REFRESH_TABLE_DISPLAY.
  ENDIF.
ENDFORM.                    " UPDATE_JUDGEMENT_DELETE

*&---------------------------------------------------------------------*
*&      Form  CONFIRMATION_DELETE
*&---------------------------------------------------------------------*
FORM CONFIRMATION_DELETE.
  CLEAR: V_ERR, V_SIGN, V_NIK, V_ANSWER, V_DATE, V_POSISI.

  LOOP AT ITAB.
    ITAB-ZSTAT = GREY.
    ITAB-ERR  = ''.
    ITAB-MESS = ''.
    MODIFY ITAB.
  ENDLOOP.
  CLEAR : IT_OUTPUT.
  REFRESH : IT_OUTPUT.
  APPEND LINES OF ITAB TO IT_OUTPUT.
  IF NOT G_GRID IS INITIAL.
    CALL METHOD G_GRID->REFRESH_TABLE_DISPLAY.
  ENDIF.

  READ TABLE ITAB WITH KEY BOX = 'X'.
  IF SY-SUBRC EQ 0.
    PERFORM RESULT_RECORDING_DELETE USING SY-UNAME.
    PERFORM USAGE_DECISION.
    DELETE ITAB WHERE BOX = 'X' AND ERR NE 'X'.
  ENDIF.
ENDFORM.                    "CONFIRMATION_DELETE

*&---------------------------------------------------------------------*
*&      Form  RESULT_RECORDING_DELETE
*&---------------------------------------------------------------------*
FORM RESULT_RECORDING_DELETE USING P_NIK.
  DATA: V_MINCYCLE      TYPE I VALUE 1,
        V_NEW_POINT,
        V_INSPOINT      LIKE BAPI2045L4-INSPPOINT,
        V_PROC_EX(100)  TYPE C.

  DATA: INSPLOT         LIKE BAPI2045L2-INSPLOT,
        INSPOPER        LIKE BAPI2045L4-INSPOPER VALUE '0010',
        INSPOINT        LIKE BAPI2045L4-INSPPOINT,
        V_CODEGRUPPE    LIKE QPAC-CODEGRUPPE,
        V_WERK          LIKE QALS-WERK,
        V_TEMP_MEAN     TYPE P DECIMALS 3,
        V_MAX_CYCLE     TYPE I,
        V_TMPSTATUS     TYPE C LENGTH 2,
        LS_SUBRC        TYPE SY-SUBRC.

  "BAPI
  DATA: BAPIRETURN1     LIKE BAPIRETURN1  OCCURS 0 WITH HEADER LINE,
        BAPIRET2        LIKE BAPIRET2     OCCURS 0 WITH HEADER LINE.

  DATA: CHAR_RESULTS    LIKE BAPI2045D2   OCCURS 0 WITH HEADER LINE,
        SAMPLE_RESULTS  LIKE BAPI2045D3   OCCURS 0 WITH HEADER LINE,
        SINGLE_RESULTS  LIKE BAPI2045D4   OCCURS 0 WITH HEADER LINE,
        INSPPOINTS      LIKE BAPI2045L4   OCCURS 0 WITH HEADER LINE.

  FIELD-SYMBOLS:
    <FS_RECORD>     TYPE TY_CREATE,
    <FS_SINGLE>     TYPE BAPI2045D4,
    <FS_SAMPLE>     TYPE BAPI2045D3,
    <FS_CHAR>       TYPE BAPI2045D2.

  CLEAR : IT_RECORD, IT_PRUEFLOS.
  REFRESH : IT_RECORD, IT_PRUEFLOS.

  LOOP AT ITAB WHERE BOX EQ 'X'.
    DATA: LV_DEL_CHAR_NO TYPE QIBPMERKNR.
    IF ITAB-INSPECTION CS 'WVTR' OR ITAB-INSPECTION CS 'MVTR'.
      LV_DEL_CHAR_NO = ITAB-WVTR_CHAR.
    ELSEIF ITAB-INSPECTION CS 'OTR' OR ITAB-INSPECTION CS 'O2TR'.
      LV_DEL_CHAR_NO = ITAB-OTR_CHAR.
    ENDIF.
    IF LV_DEL_CHAR_NO IS INITIAL.
      LV_DEL_CHAR_NO = ITAB-MERKNR.
    ENDIF.

    V_MINCYCLE = 1.

    WHILE V_MINCYCLE LE ITAB-CYCLE.
      CLEAR IT_RECORD.
      IT_RECORD-MEAN_VAL      = 0.
      IT_RECORD-PRUEFLOS      = ITAB-PRUEFLOS.
      IT_RECORD-CHAR_NO       = LV_DEL_CHAR_NO.

      DATA: LV_REAL_PROBENR TYPE QASE-PROBENR.
      CLEAR LV_REAL_PROBENR.
      SELECT SINGLE PROBENR INTO LV_REAL_PROBENR
        FROM QASE
        WHERE PRUEFLOS = ITAB-PRUEFLOS
          AND MERKNR = LV_DEL_CHAR_NO
          AND STUECKNR = V_MINCYCLE.
      IF SY-SUBRC = 0.
        IT_RECORD-PROBENR = LV_REAL_PROBENR.
      ELSE.
        IT_RECORD-PROBENR = ITAB-TIMES.
      ENDIF.

      IT_RECORD-ZZCOUNTER     = V_MINCYCLE.
      IT_RECORD-VALUATION     = 'A'.
      IT_RECORD-INSPECTOR     = P_NIK.
      IT_RECORD-INSPECTION    = ITAB-INSPECTION.
      PERFORM CONVERT_DATE_INPUT USING ITAB-INSPDATE CHANGING IT_RECORD-DATE.
      CONDENSE IT_RECORD-MEAN_VAL.
      APPEND IT_RECORD.
      CLEAR IT_RECORD.
      ADD 1 TO V_MINCYCLE.
    ENDWHILE.
  ENDLOOP.

  IF IT_RECORD[] IS INITIAL.
    EXIT.
  ENDIF.

  CLEAR: IT_PRUEFLOS.
  REFRESH: IT_PRUEFLOS.
  IT_PRUEFLOS[]  = IT_RECORD[].
  DELETE ADJACENT DUPLICATES FROM IT_PRUEFLOS COMPARING PRUEFLOS PROBENR.

  LOOP AT IT_PRUEFLOS.
    "Cancel UD, Must be Canceled (Sama persis seperti ZQMI_BARRIER_APPROVAL)
    PERFORM CANCEL_UD USING IT_PRUEFLOS-PRUEFLOS CHANGING LS_SUBRC ITAB-MESS ITAB-ZSTAT ITAB-ERR.
    IF LS_SUBRC NE 0.
      MODIFY ITAB TRANSPORTING MESS ZSTAT ERR WHERE PRUEFLOS EQ IT_PRUEFLOS-PRUEFLOS AND INSPECTION EQ IT_PRUEFLOS-INSPECTION.
      CONTINUE.
    ENDIF.

    REFRESH: CHAR_RESULTS, SINGLE_RESULTS, INSPPOINTS.
    CLEAR: CHAR_RESULTS, SINGLE_RESULTS, INSPPOINTS, INSPLOT, INSPOINT, V_UD, V_NEW_POINT.

    INSPLOT   = IT_PRUEFLOS-PRUEFLOS.
    INSPOINT  = IT_PRUEFLOS-PROBENR.

    CALL FUNCTION 'BAPI_INSPOPER_GETDETAIL'
      EXPORTING
        INSPLOT             = INSPLOT
        INSPOPER            = INSPOPER
        READ_CHAR_RESULTS   = 'X'
        READ_SINGLE_RESULTS = 'X'
        READ_INSPPOINTS     = 'X'
        READ_SAMPLE_RESULTS = 'X'
        INSPPOINT_FROM      = INSPOINT
        MAX_INSPPOINTS      = 1
      TABLES
        CHAR_RESULTS        = CHAR_RESULTS
        SINGLE_RESULTS      = SINGLE_RESULTS
        SAMPLE_RESULTS      = SAMPLE_RESULTS
        INSPPOINTS          = INSPPOINTS.

    IF SY-SUBRC = 0.
      DELETE SINGLE_RESULTS WHERE ( RES_VALUE = '' AND CODE1 = '' ) AND RES_ATTR IS INITIAL.
      LOOP AT IT_RECORD ASSIGNING <FS_RECORD> WHERE PRUEFLOS = IT_PRUEFLOS-PRUEFLOS AND PROBENR = INSPOINT.
        READ TABLE SINGLE_RESULTS ASSIGNING <FS_SINGLE> WITH KEY INSPLOT    = INSPLOT
                                                                 INSPCHAR   = <FS_RECORD>-CHAR_NO
                                                                 INSPOPER   = INSPOPER
                                                                 INSPSAMPLE = <FS_RECORD>-PROBENR
                                                                 RES_NO     = <FS_RECORD>-ZZCOUNTER.
        IF SY-SUBRC = 0.
          IF <FS_RECORD>-MEAN_VAL CA 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.
            CLEAR: V_CODEGRUPPE, V_WERK.
            SELECT SINGLE QALS~WERK
              INTO V_WERK
              FROM QALS
             WHERE QALS~PRUEFLOS = INSPLOT.

            SELECT SINGLE QPMZ~AUSWMENGE1 INTO V_CODEGRUPPE
              FROM QPMZ
              JOIN QAMV ON QPMZ~MKMNR = QAMV~VERWMERKM
             WHERE QAMV~PRUEFLOS    = INSPLOT
               AND QAMV~MERKNR      = <FS_RECORD>-CHAR_NO
               AND QPMZ~ZAEHLER     = V_WERK.

            <FS_SINGLE>-CODE_GRP1   = V_CODEGRUPPE.
            <FS_SINGLE>-CODE1       = <FS_RECORD>-MEAN_VAL.
          ELSE.
            <FS_SINGLE>-RES_VALUE   = <FS_RECORD>-MEAN_VAL.
          ENDIF.
          <FS_SINGLE>-INSPECTOR     = <FS_RECORD>-INSPECTOR.
          <FS_SINGLE>-INSP_DATE     = <FS_RECORD>-DATE.
          <FS_SINGLE>-INSP_TIME     = SY-UZEIT.
          <FS_SINGLE>-RES_ATTR      = '/'.
        ELSE.
          CONTINUE.
        ENDIF.

        READ TABLE CHAR_RESULTS ASSIGNING <FS_CHAR> WITH KEY INSPLOT   = INSPLOT
                                                             INSPCHAR  = <FS_RECORD>-CHAR_NO
                                                             INSPOPER  = INSPOPER.
        IF SY-SUBRC = 0.
          CLEAR: <FS_CHAR>-CLOSED, <FS_CHAR>-EVALUATED, <FS_CHAR>-EVALUATION.
        ENDIF.

        READ TABLE SAMPLE_RESULTS ASSIGNING <FS_SAMPLE> WITH KEY INSPLOT   = INSPLOT
                                                                 INSPCHAR  = <FS_RECORD>-CHAR_NO
                                                                 INSPOPER  = INSPOPER
                                                                 INSPSAMPLE = <FS_RECORD>-PROBENR.
        IF SY-SUBRC = 0.
          CLEAR: <FS_SAMPLE>-CLOSED, <FS_SAMPLE>-EVALUATED, <FS_SAMPLE>-EVALUATION.
        ENDIF.
      ENDLOOP.

      DELETE SINGLE_RESULTS WHERE ( RES_VALUE = '' AND CODE1 = '' ) AND RES_ATTR IS INITIAL.

      REFRESH: BAPIRET2.
      CLEAR: BAPIRET2.

      READ TABLE INSPPOINTS INDEX 1.
      IF SY-SUBRC = 0.
        WA_INSPPOINTDATA = INSPPOINTS.
      ENDIF.
      CALL FUNCTION 'BAPI_INSPOPER_RECORDRESULTS'
        EXPORTING
          INSPLOT        = INSPLOT
          INSPOPER       = INSPOPER
          INSPPOINTDATA  = WA_INSPPOINTDATA
        TABLES
          CHAR_RESULTS   = CHAR_RESULTS
          SAMPLE_RESULTS = SAMPLE_RESULTS
          SINGLE_RESULTS = SINGLE_RESULTS
          RETURNTABLE    = BAPIRET2.

      LOOP AT BAPIRET2 WHERE TYPE = 'E' OR TYPE = 'A'.
        V_ERR = 'X'.
        EXIT.
      ENDLOOP.
      IF V_ERR = 'X'.
        READ TABLE BAPIRET2 WITH KEY TYPE = 'E'.
        IF SY-SUBRC <> 0. READ TABLE BAPIRET2 WITH KEY TYPE = 'A'. ENDIF.
        V_ERR = 'X'.
        LOOP AT ITAB WHERE PRUEFLOS = IT_PRUEFLOS-PRUEFLOS.
          ITAB-ZSTAT = ERROR.
          ITAB-ERR   = 'X'.
          ITAB-MESS  = BAPIRET2-MESSAGE.
          MODIFY ITAB.
        ENDLOOP.
      ELSE.
        CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
          EXPORTING
            WAIT = 'X'.
        " DELETE ITAB dipindah ke CONFIRMATION_DELETE agar USAGE_DECISION bisa berjalan
      ENDIF.
    ENDIF.
  ENDLOOP.
ENDFORM.                    "RESULT_RECORDING_DELETE