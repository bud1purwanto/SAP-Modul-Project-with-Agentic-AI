*&---------------------------------------------------------------------*
*&---------------------------------------------------------------------*
*&      Form  GET_INITIAL_DATA

*&---------------------------------------------------------------------*
FORM GET_INITIAL_DATA.
  DATA : V_CODEWVTR TYPE STRING,V_CODEOTR TYPE STRING.
  DATA : LV_THICK_CHAR TYPE C LENGTH 10.
  DATA : IT_AFPO LIKE AFPO OCCURS 0 WITH HEADER LINE.
  DATA : IT_TEMP_AFPO LIKE AFPO OCCURS 0 WITH HEADER LINE.
  DATA : IT_SROLL_TEMP LIKE IT_SROLL OCCURS 0 WITH HEADER LINE.
  DATA : IT_SROLL_TEMP2 LIKE IT_SROLL OCCURS 0 WITH HEADER LINE.
  DATA : IT_CHARACTERISTIC_JR LIKE IT_CHARACTERISTIC OCCURS 0 WITH HEADER LINE.
  DATA : IT_CHARJR_DESC LIKE IT_CHAR_DESC OCCURS 0 WITH HEADER LINE.
  DATA : BEGIN OF IT_CODE_TEMP OCCURS 0,
            ATWRT TYPE AUSP-ATWRT,
         END OF IT_CODE_TEMP.
  DATA : BEGIN OF IT_TEMP_BATCH OCCURS 0,
             MBLNR LIKE AUFM-MBLNR,
             MJAHR LIKE AUFM-MJAHR,
             MATNR LIKE AUFM-MATNR,
             WERKS LIKE AUFM-WERKS,
             CHARG LIKE AUFM-CHARG,
             BWART LIKE AUFM-BWART,
             AUFNR LIKE AUFM-AUFNR,
             MENGE LIKE AUFM-MENGE,
             MEINS LIKE AUFM-MEINS,
             SMBLN LIKE MSEG-SMBLN,
             SJAHR LIKE MSEG-SJAHR,
             SMBLP LIKE MSEG-SMBLP,
             OBJEK LIKE MCH1-CUOBJ_BM,
           END OF IT_TEMP_BATCH.
  DATA : IT_TEMP_BATCH_JR LIKE IT_TEMP_BATCH OCCURS 0 WITH HEADER LINE.
  DATA : IT_TEMP_BATCH_JC LIKE IT_TEMP_BATCH OCCURS 0 WITH HEADER LINE.
  DATA : IT_TEMP_BATCH_SR LIKE IT_TEMP_BATCH OCCURS 0 WITH HEADER LINE.
  DATA : IT_TEMP_BATCH_SC LIKE IT_TEMP_BATCH OCCURS 0 WITH HEADER LINE.
  DATA: LV_MATNR_J TYPE MATNR,
        LV_CHARG_J TYPE CHARG_D.
  SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_CABN FROM CABN WHERE ATNAM LIKE 'ZZ%'.
  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZTYPE'.
  IF SY-SUBRC EQ 0.
    V_ZZTYPE = IT_CABN-ATINN.
  ENDIF.
  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZTHICKNESS'.
  IF SY-SUBRC EQ 0.
    V_ZZTHICK = IT_CABN-ATINN.
  ENDIF.
  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZNOMORROLL'.
  IF SY-SUBRC EQ 0.
    V_ZZNOMORROLL = IT_CABN-ATINN.
  ENDIF.
  SELECT
    A~PRUEFLOS  AS PRUEFLOS
    A~ENSTEHDAT AS INSPDATE
    B~KURZTEXT  AS INSPECTION
    B~MERKNR    AS MERKNR
    A~MATNR     AS MATNR
    A~CHARG     AS CHARG
    B~VERWMERKM AS VERWMERKM
    B~MKVERSION AS MKVERSION
    A~WERK      AS WERK
    INTO CORRESPONDING FIELDS OF TABLE IT_OUTPUT
    FROM QALS AS A
    JOIN QAMV AS B ON B~PRUEFLOS EQ A~PRUEFLOS
    WHERE A~ERSTELDAT IN S_GSTRP
      AND A~WERK      IN V_WERKS
      AND ( B~KURZTEXT LIKE '%WVTR%'
         OR B~KURZTEXT LIKE '%MVTR%'
         OR B~KURZTEXT LIKE '%OTR%'
         OR B~KURZTEXT LIKE '%O2TR%' ).
  SORT IT_OUTPUT BY PRUEFLOS INSPECTION.
  DELETE ADJACENT DUPLICATES FROM IT_OUTPUT COMPARING PRUEFLOS INSPECTION.
  REFRESH IT_MAP_INSP_CHAR.
  IF IT_OUTPUT[] IS NOT INITIAL.
    SELECT MAPL~MATNR MERKNR VERWMERKM MKVERSION STPRUMF QPMK_ZAEHL AS ZAEHLER VERWMERKM AS MKMNR KURZTEXT AS SORTFELD SOLLWERT TOLERANZOB TOLERANZUN DELKZ PRUEFEINH
         INTO (WA_MAP_INSP_CHAR-MATNR, WA_MAP_INSP_CHAR-MERKNR, WA_MAP_INSP_CHAR-VERWMERKM, WA_MAP_INSP_CHAR-MKVERSION, WA_MAP_INSP_CHAR-STPRUMF, WA_MAP_INSP_CHAR-ZAEHLER, WA_MAP_INSP_CHAR-MKMNR, WA_MAP_INSP_CHAR-SORTFELD, WA_MAP_INSP_CHAR-SOLLWERT,
       WA_MAP_INSP_CHAR-TOLERANZOB, WA_MAP_INSP_CHAR-TOLERANZUN, WA_MAP_INSP_CHAR-DELKZ, WA_MAP_INSP_CHAR-PRUEFEINH)
           FROM MAPL
           JOIN PLKO ON PLKO~PLNTY EQ MAPL~PLNTY AND PLKO~PLNNR EQ MAPL~PLNNR AND PLKO~PLNAL EQ MAPL~PLNAL
           JOIN PLMK ON PLKO~PLNTY EQ PLMK~PLNTY AND PLKO~PLNNR EQ PLMK~PLNNR AND PLKO~ZAEHL EQ PLMK~PLNKN
           JOIN QDSV ON PLMK~STICHPRVER EQ QDSV~STICHPRVER
           FOR ALL ENTRIES IN IT_OUTPUT
       WHERE MAPL~WERKS EQ IT_OUTPUT-WERK
            AND MAPL~MATNR EQ IT_OUTPUT-MATNR
            AND PLMK~VERWMERKM EQ IT_OUTPUT-VERWMERKM
            AND PLKO~KTEXT LIKE '%After Slitting%'
            AND MAPL~LOEKZ NE 'X'.
      APPEND WA_MAP_INSP_CHAR TO IT_MAP_INSP_CHAR.
    ENDSELECT.
  ENDIF.
  REFRESH IT_QASE.
  IF IT_OUTPUT[] IS NOT INITIAL.
    SELECT PRUEFLOS
           MERKNR
           PROBENR
           STUECKNR
           MESSWERT
           MBEWERTG
           ATTRIBUT
           PRUEFDATUV AS BUDAT
           PRUEFER
      INTO CORRESPONDING FIELDS OF TABLE IT_QASE
      FROM QASE
      FOR ALL ENTRIES IN IT_OUTPUT
      WHERE PRUEFLOS = IT_OUTPUT-PRUEFLOS.
  ENDIF.
  " --- NEW: Masukkan data awal ke IT_COMPARE ---
  REFRESH IT_COMPARE.
  IT_COMPARE[] = IT_QASE[].
  " ---------------------------------------------
  IF IT_OUTPUT[] IS NOT INITIAL.
    SELECT
    CHARG
    AUSP~ATINN
    AUSP~ATWRT
    AUSP~ATFLV
    INTO CORRESPONDING FIELDS OF TABLE IT_CHAR
    FROM MCH1
    JOIN AUSP  ON AUSP~OBJEK EQ MCH1~CUOBJ_BM
     FOR ALL ENTRIES IN IT_OUTPUT
   WHERE MATNR EQ IT_OUTPUT-MATNR
     AND CHARG EQ IT_OUTPUT-CHARG
     AND KLART EQ '023'
     AND AUSP~ATINN IN (V_ZZTYPE, V_ZZNOMORROLL, V_ZZTHICK).
  ENDIF.
  TYPES: BEGIN OF TY_BATCH_CACHE,
           ROLL_JR TYPE STRING,
           MATNR_J TYPE MCH1-MATNR,
           CHARG_J TYPE MCH1-CHARG,
         END OF TY_BATCH_CACHE.
  DATA: LT_BATCH_CACHE TYPE TABLE OF TY_BATCH_CACHE,
        LS_BATCH_CACHE TYPE TY_BATCH_CACHE,
        LT_STR TYPE TABLE OF STRING,
        LV_STR TYPE STRING,
        LV_ROLL_JR_TEMP TYPE STRING.
  CLEAR LT_BATCH_CACHE[].

  TYPES: BEGIN OF TY_CYCLE_CACHE,
           MATNR TYPE MAPL-MATNR,
           WERKS TYPE MAPL-WERKS,
           VERWMERKM TYPE PLMK-VERWMERKM,
           STPRUMF TYPE QDSV-STPRUMF,
         END OF TY_CYCLE_CACHE.
  DATA: LT_CYCLE TYPE TABLE OF TY_CYCLE_CACHE,
        LS_CYCLE TYPE TY_CYCLE_CACHE.

  IF IT_OUTPUT[] IS NOT INITIAL.
    SELECT MAPL~MATNR MAPL~WERKS PLMK~VERWMERKM QDSV~STPRUMF
      INTO TABLE LT_CYCLE
      FROM MAPL
      JOIN PLKO ON PLKO~PLNTY = MAPL~PLNTY AND PLKO~PLNNR = MAPL~PLNNR AND PLKO~PLNAL = MAPL~PLNAL
      JOIN PLMK ON PLKO~PLNTY = PLMK~PLNTY AND PLKO~PLNNR = PLMK~PLNNR AND PLKO~ZAEHL = PLMK~PLNKN
      JOIN QDSV ON PLMK~STICHPRVER = QDSV~STICHPRVER
      FOR ALL ENTRIES IN IT_OUTPUT
     WHERE MAPL~WERKS = IT_OUTPUT-WERK
       AND MAPL~MATNR = IT_OUTPUT-MATNR
       AND PLMK~VERWMERKM = IT_OUTPUT-VERWMERKM
       AND PLKO~KTEXT LIKE '%After Slitting%'
       AND MAPL~LOEKZ NE 'X'.
    SORT LT_CYCLE BY MATNR WERKS VERWMERKM.
  ENDIF.

  LOOP AT IT_OUTPUT INTO WA_OUTPUT.
    READ TABLE IT_CHAR WITH KEY CHARG = WA_OUTPUT-CHARG ATINN = V_ZZTYPE.
    IF SY-SUBRC EQ 0.
      WA_OUTPUT-TYPE = IT_CHAR-ATWRT.
    ENDIF.
    READ TABLE IT_CHAR WITH KEY CHARG = WA_OUTPUT-CHARG ATINN = V_ZZTHICK.
    IF SY-SUBRC EQ 0.
      WA_OUTPUT-THICK = IT_CHAR-ATFLV.
    ENDIF.
    READ TABLE IT_CHAR WITH KEY CHARG = WA_OUTPUT-CHARG ATINN = V_ZZNOMORROLL.
    IF SY-SUBRC EQ 0.
      WA_OUTPUT-ROLL = IT_CHAR-ATWRT.
    ENDIF.
    LV_THICK_CHAR = WA_OUTPUT-THICK.
    CONDENSE LV_THICK_CHAR.
    CONCATENATE WA_OUTPUT-TYPE '-' LV_THICK_CHAR INTO WA_OUTPUT-TYPE.

    " FILTER: TYPE (Film Type JR)
    IF V_FILM IS NOT INITIAL AND WA_OUTPUT-TYPE NOT IN V_FILM.
      DELETE IT_OUTPUT.
      CONTINUE.
    ENDIF.

    WA_OUTPUT-ZSTAT = GREY.

    " 1. Ekstrak ROLL_JR dengan cara Split
    CLEAR: LV_ROLL_JR_TEMP, LT_STR[].
    SPLIT WA_OUTPUT-ROLL AT SPACE INTO TABLE LT_STR.
    LOOP AT LT_STR INTO LV_STR.
      IF SY-TABIX <= 4.
        IF LV_ROLL_JR_TEMP IS INITIAL.
          LV_ROLL_JR_TEMP = LV_STR.
        ELSE.
          CONCATENATE LV_ROLL_JR_TEMP LV_STR INTO LV_ROLL_JR_TEMP SEPARATED BY SPACE.
        ENDIF.
      ELSE.
        EXIT.
      ENDIF.
    ENDLOOP.

    " 2. Cek Cache atau Panggil BAPI
    CLEAR: LV_MATNR_J, LV_CHARG_J.
    READ TABLE LT_BATCH_CACHE INTO LS_BATCH_CACHE WITH KEY ROLL_JR = LV_ROLL_JR_TEMP.
    IF SY-SUBRC = 0.
      LV_MATNR_J = LS_BATCH_CACHE-MATNR_J.
      LV_CHARG_J = LS_BATCH_CACHE-CHARG_J.
    ELSE.
      CALL FUNCTION 'ZQM_GET_BATCH_JR_BY_SR'
        EXPORTING
          CHARG_S = WA_OUTPUT-CHARG
        IMPORTING
          MATNR_J = LV_MATNR_J
          CHARG_J = LV_CHARG_J.
      LS_BATCH_CACHE-ROLL_JR = LV_ROLL_JR_TEMP.
      LS_BATCH_CACHE-MATNR_J = LV_MATNR_J.
      LS_BATCH_CACHE-CHARG_J = LV_CHARG_J.
      APPEND LS_BATCH_CACHE TO LT_BATCH_CACHE.
    ENDIF.

    IF LV_CHARG_J IS NOT INITIAL.
      " Tetap memanggil fungsi ini (jika dibutuhkan) atau bisa langsung WA_OUTPUT-ROLL_JR = LV_ROLL_JR_TEMP
      " Kita set ROLL_JR langsung dari hasil split karena lebih akurat sesuai instruksi user
      WA_OUTPUT-ROLL_JR = LV_ROLL_JR_TEMP.
      WA_OUTPUT-CHARGJR = LV_CHARG_J.
    ELSE.
      DELETE IT_OUTPUT.
      CONTINUE.
    ENDIF.

    " FILTER: ROLL_JR dan CHARGJR
    IF V_ROLL IS NOT INITIAL AND WA_OUTPUT-ROLL_JR NOT IN V_ROLL.
      DELETE IT_OUTPUT.
      CONTINUE.
    ENDIF.
    IF V_CHARGJ IS NOT INITIAL AND WA_OUTPUT-CHARGJR NOT IN V_CHARGJ.
      DELETE IT_OUTPUT.
      CONTINUE.
    ENDIF.
    DATA: LV_INVALID_ROW TYPE FLAG.
    LV_INVALID_ROW = ''.
    LOOP AT IT_QASE WHERE PRUEFLOS = WA_OUTPUT-PRUEFLOS AND MERKNR   = WA_OUTPUT-MERKNR.
      IF IT_QASE-ATTRIBUT IS NOT INITIAL AND IT_QASE-ATTRIBUT NE ' ' AND IT_QASE-ATTRIBUT NE '/'.
        LV_INVALID_ROW = 'X'.
        EXIT.
      ELSEIF IT_QASE-ATTRIBUT EQ '/'.
        LV_INVALID_ROW = 'X'.
        EXIT.
      ENDIF.
      CASE IT_QASE-STUECKNR.
        WHEN 1.
          WA_OUTPUT-VALUE1 = IT_QASE-MESSWERT.
        WHEN 2.
          WA_OUTPUT-VALUE2 = IT_QASE-MESSWERT.
        WHEN 3.
          WA_OUTPUT-VALUE3 = IT_QASE-MESSWERT.
        WHEN 4.
          WA_OUTPUT-VALUE4 = IT_QASE-MESSWERT.
      ENDCASE.
    ENDLOOP.
    IF LV_INVALID_ROW EQ 'X'.
      DELETE IT_OUTPUT.
      CONTINUE.
    ENDIF.
    READ TABLE IT_MAP_INSP_CHAR INTO WA_MAP_INSP_CHAR WITH KEY MATNR = WA_OUTPUT-MATNR VERWMERKM = WA_OUTPUT-VERWMERKM.
    IF SY-SUBRC EQ 0.
      IF WA_OUTPUT-VALUE1 IS INITIAL AND
         WA_OUTPUT-VALUE2 IS INITIAL AND
         WA_OUTPUT-VALUE3 IS INITIAL AND
         WA_OUTPUT-VALUE4 IS INITIAL.
        WA_OUTPUT-STATUS = 'NOT YET'.
      ELSE.
        DATA: LV_V1 TYPE STRING, LV_V2 TYPE STRING, LV_V3 TYPE STRING, LV_V4 TYPE STRING.
        LV_V4 = WA_OUTPUT-VALUE4. CONDENSE LV_V4.
        LV_V3 = WA_OUTPUT-VALUE3. CONDENSE LV_V3.
        LV_V2 = WA_OUTPUT-VALUE2. CONDENSE LV_V2.
        LV_V1 = WA_OUTPUT-VALUE1. CONDENSE LV_V1.

        IF LV_V4 NE '' AND LV_V4 NE '0.000'.
          WA_OUTPUT-LAST_VALUE = WA_OUTPUT-VALUE4.
        ELSEIF LV_V3 NE '' AND LV_V3 NE '0.000'.
          WA_OUTPUT-LAST_VALUE = WA_OUTPUT-VALUE3.
        ELSEIF LV_V2 NE '' AND LV_V2 NE '0.000'.
          WA_OUTPUT-LAST_VALUE = WA_OUTPUT-VALUE2.
        ELSEIF LV_V1 NE '' AND LV_V1 NE '0.000'.
          WA_OUTPUT-LAST_VALUE = WA_OUTPUT-VALUE1.
        ELSE.
          CLEAR WA_OUTPUT-LAST_VALUE.
        ENDIF.

        IF WA_OUTPUT-LAST_VALUE IS NOT INITIAL AND WA_OUTPUT-LAST_VALUE NE '0.000' AND WA_OUTPUT-LAST_VALUE NE ' '.
          WA_OUTPUT-STATUS = 'OK'.
          IF WA_OUTPUT-LAST_VALUE < WA_MAP_INSP_CHAR-TOLERANZUN OR WA_OUTPUT-LAST_VALUE > WA_MAP_INSP_CHAR-TOLERANZOB.
            WA_OUTPUT-STATUS = 'NOT OK'.
          ENDIF.
        ELSE.
          WA_OUTPUT-STATUS = 'NOT YET'.
        ENDIF.
      ENDIF.
    ELSE.
      WA_OUTPUT-STATUS = 'NO MASTER'.
    ENDIF.

    " --- MENGAMBIL CYCLE (STPRUMF) DARI MASTER DATA ---
    CLEAR WA_OUTPUT-CYCLE.
    READ TABLE LT_CYCLE INTO LS_CYCLE WITH KEY MATNR = WA_OUTPUT-MATNR
                                               WERKS = WA_OUTPUT-WERK
                                               VERWMERKM = WA_OUTPUT-VERWMERKM BINARY SEARCH.
    IF SY-SUBRC = 0.
      WA_OUTPUT-CYCLE = LS_CYCLE-STPRUMF.
    ENDIF.
    " --------------------------------------------------
    MODIFY IT_OUTPUT FROM WA_OUTPUT.
  ENDLOOP.
ENDFORM.                    " GET_INITIAL_DATA

*&---------------------------------------------------------------------*
*&      Form  DISPLAY_DATA

*&---------------------------------------------------------------------*
FORM DISPLAY_DATA CHANGING PT_OUTTAB LIKE IT_OUTPUT[]
                                  PT_FIELDCAT TYPE LVC_T_FCAT.
  IF G_GRID IS INITIAL.
    CREATE OBJECT G_CUSTOM_CONTAINER
      EXPORTING
        CONTAINER_NAME = G_CONTAINER.
    CREATE OBJECT G_GRID
      EXPORTING
        I_PARENT = G_CUSTOM_CONTAINER.
    PERFORM BUILD_FIELDCAT CHANGING PT_FIELDCAT.
    GS_LAYOUT-SEL_MODE = 'A'.
    GS_LAYOUT-STYLEFNAME = 'CELLTAB'.
    CALL METHOD G_GRID->SET_TABLE_FOR_FIRST_DISPLAY
      EXPORTING
        IS_LAYOUT            = GS_LAYOUT
        IT_TOOLBAR_EXCLUDING = LT_EXCLUDE
        I_SAVE               = 'A'
      CHANGING
        IT_FIELDCATALOG      = PT_FIELDCAT
        IT_OUTTAB            = IT_OUTPUT.
  ELSE.
    CALL METHOD G_GRID->REFRESH_TABLE_DISPLAY.
  ENDIF.
  CALL METHOD G_GRID->SET_READY_FOR_INPUT
    EXPORTING
      I_READY_FOR_INPUT = 1.
  DATA : T_OBJECT TYPE REF TO CLASS1.
  CREATE OBJECT T_OBJECT.
  SET HANDLER T_OBJECT->HANDLE FOR G_GRID.
ENDFORM.                    " DISPLAY_DATA

*&---------------------------------------------------------------------*
*&      Form  BUILD_FIELDCAT

*&---------------------------------------------------------------------*
FORM BUILD_FIELDCAT CHANGING PT_FIELDCAT TYPE LVC_T_FCAT.
  DATA LS_FCAT TYPE LVC_S_FCAT.
  DATA: LV_MAX_CYCLE TYPE I VALUE 0,
        LV_CYCLE_INT TYPE I.
  FIELD-SYMBOLS: <FS_OUTPUT_CAT> LIKE LINE OF IT_OUTPUT.

  LOOP AT IT_OUTPUT ASSIGNING <FS_OUTPUT_CAT>.
    LV_CYCLE_INT = <FS_OUTPUT_CAT>-CYCLE.
    IF LV_CYCLE_INT > LV_MAX_CYCLE.
      LV_MAX_CYCLE = LV_CYCLE_INT.
    ENDIF.
  ENDLOOP.
  IF LV_MAX_CYCLE < 1.
    LV_MAX_CYCLE = 1.
  ENDIF.
  LS_FCAT-FIELDNAME = 'ZSTAT'.
  LS_FCAT-REPTEXT   = 'Indicator'.
  LS_FCAT-OUTPUTLEN = 6.
  LS_FCAT-JUST      = 'C'.
  APPEND LS_FCAT TO PT_FIELDCAT.
  CLEAR LS_FCAT.
  LS_FCAT-FIELDNAME = 'INSPDATE'.
  LS_FCAT-REPTEXT   = 'Inspection Date'.
  LS_FCAT-OUTPUTLEN = 15.
  LS_FCAT-JUST      = 'C'.
  APPEND LS_FCAT TO PT_FIELDCAT.
  CLEAR LS_FCAT.
  LS_FCAT-FIELDNAME = 'INSPECTION'.
  LS_FCAT-REPTEXT   = 'INSPECTION'.
  LS_FCAT-OUTPUTLEN = 6.
  LS_FCAT-JUST      = 'C'.
  APPEND LS_FCAT TO PT_FIELDCAT.
  CLEAR LS_FCAT.
  LS_FCAT-FIELDNAME = 'ROLL_JR'.
  LS_FCAT-REPTEXT   = 'No. Roll JR'.
  LS_FCAT-OUTPUTLEN = 15.
  LS_FCAT-JUST      = 'C'.
  APPEND LS_FCAT TO PT_FIELDCAT.
  CLEAR LS_FCAT.
  LS_FCAT-FIELDNAME = 'ROLL'.
  LS_FCAT-REPTEXT   = 'No. Roll SR'.
  LS_FCAT-OUTPUTLEN = 15.
  LS_FCAT-JUST      = 'C'.
  APPEND LS_FCAT TO PT_FIELDCAT.
  CLEAR LS_FCAT.
  LS_FCAT-FIELDNAME = 'TYPE'.
  LS_FCAT-REPTEXT   = 'TYPE'.
  LS_FCAT-OUTPUTLEN = 8.
  LS_FCAT-JUST      = 'C'.
  APPEND LS_FCAT TO PT_FIELDCAT.
  CLEAR LS_FCAT.
  LS_FCAT-FIELDNAME = 'STATUS'.
  LS_FCAT-REPTEXT   = 'STATUS'.
  LS_FCAT-OUTPUTLEN = 8.
  LS_FCAT-JUST      = 'C'.
  APPEND LS_FCAT TO PT_FIELDCAT.
  CLEAR LS_FCAT.
  LS_FCAT-FIELDNAME = 'CYCLE'.
  LS_FCAT-REPTEXT   = 'CYCLE'.
  LS_FCAT-OUTPUTLEN = 5.
  LS_FCAT-JUST      = 'C'.
  APPEND LS_FCAT TO PT_FIELDCAT.
  CLEAR LS_FCAT.
  IF LV_MAX_CYCLE >= 1.
    LS_FCAT-FIELDNAME = 'VALUE1'.
    LS_FCAT-REPTEXT   = 'VALUE1'.
    LS_FCAT-REF_TABLE = 'LIKP'.
    LS_FCAT-REF_FIELD = 'VOLUM'.
    LS_FCAT-SCRTEXT_S = 'VAL1'.
    LS_FCAT-SCRTEXT_M = 'VAL1'.
    LS_FCAT-OUTPUTLEN = 7.
    LS_FCAT-JUST      = 'C'.
    IF SY-DYNNR EQ '0100'.
      LS_FCAT-EDIT      = 'X'.
    ENDIF.
    APPEND LS_FCAT TO PT_FIELDCAT.
    CLEAR LS_FCAT.
  ENDIF.

  IF LV_MAX_CYCLE >= 2.
    LS_FCAT-FIELDNAME = 'VALUE2'.
    LS_FCAT-REPTEXT   = 'VALUE2'.
    LS_FCAT-REF_TABLE = 'LIKP'.
    LS_FCAT-REF_FIELD = 'VOLUM'.
    LS_FCAT-SCRTEXT_S = 'VAL2'.
    LS_FCAT-SCRTEXT_M = 'VAL2'.
    LS_FCAT-OUTPUTLEN = 7.
    LS_FCAT-JUST      = 'C'.
    IF SY-DYNNR EQ '0100'.
      LS_FCAT-EDIT      = 'X'.
    ENDIF.
    APPEND LS_FCAT TO PT_FIELDCAT.
    CLEAR LS_FCAT.
  ENDIF.

  IF LV_MAX_CYCLE >= 3.
    LS_FCAT-FIELDNAME = 'VALUE3'.
    LS_FCAT-REPTEXT   = 'VALUE3'.
    LS_FCAT-REF_TABLE = 'LIKP'.
    LS_FCAT-REF_FIELD = 'VOLUM'.
    LS_FCAT-SCRTEXT_S = 'VAL3'.
    LS_FCAT-SCRTEXT_M = 'VAL3'.
    LS_FCAT-OUTPUTLEN = 7.
    LS_FCAT-JUST      = 'C'.
    IF SY-DYNNR EQ '0100'.
      LS_FCAT-EDIT      = 'X'.
    ENDIF.
    APPEND LS_FCAT TO PT_FIELDCAT.
    CLEAR LS_FCAT.
  ENDIF.

  IF LV_MAX_CYCLE >= 4.
    LS_FCAT-FIELDNAME = 'VALUE4'.
    LS_FCAT-REPTEXT   = 'VALUE4'.
    LS_FCAT-REF_TABLE = 'LIKP'.
    LS_FCAT-REF_FIELD = 'VOLUM'.
    LS_FCAT-SCRTEXT_S = 'VAL4'.
    LS_FCAT-SCRTEXT_M = 'VAL4'.
    LS_FCAT-OUTPUTLEN = 7.
    LS_FCAT-JUST      = 'C'.
    IF SY-DYNNR EQ '0100'.
      LS_FCAT-EDIT      = 'X'.
    ENDIF.
    APPEND LS_FCAT TO PT_FIELDCAT.
    CLEAR LS_FCAT.
  ENDIF.

  LS_FCAT-FIELDNAME = 'LAST_VALUE'.
  LS_FCAT-REPTEXT   = 'Last Value'.
  LS_FCAT-REF_TABLE = 'LIKP'.
  LS_FCAT-REF_FIELD = 'VOLUM'.
  LS_FCAT-SCRTEXT_S = 'L.VAL'.
  LS_FCAT-SCRTEXT_M = 'L.VAL'.
  LS_FCAT-OUTPUTLEN = 10.
  LS_FCAT-JUST      = 'C'.
  APPEND LS_FCAT TO PT_FIELDCAT.
  CLEAR LS_FCAT.
  LS_FCAT-FIELDNAME = 'MESS'.
  LS_FCAT-REPTEXT   = 'Message Log'.
  LS_FCAT-OUTPUTLEN = 50.
  APPEND LS_FCAT TO PT_FIELDCAT.
  CLEAR LS_FCAT.
ENDFORM.                    " BUILD_FIELDCAT

*&---------------------------------------------------------------------*
*&      Form  GET_DETAIL_CHARACTERISTIC

*&---------------------------------------------------------------------*
FORM GET_DETAIL_CHARACTERISTIC USING MATNR CHARG ATINN CHANGING VALUE.
  DATA: V_ATWRT TYPE ATWRT,
         V_ATFLV TYPE ATFLV.
  SELECT SINGLE ATWRT ATFLV INTO (V_ATWRT, V_ATFLV)
    FROM MCH1
    JOIN AUSP ON AUSP~OBJEK EQ MCH1~CUOBJ_BM
   WHERE MATNR EQ MATNR
     AND CHARG EQ CHARG
     AND ATINN EQ ATINN.
  IF V_ATFLV IS NOT INITIAL.
    VALUE = V_ATFLV.
  ELSE.
    VALUE = V_ATWRT.
  ENDIF.
ENDFORM.                    "GET_DETAIL_CHARACTERISTIC

*&---------------------------------------------------------------------*
*&      Module  PBO  OUTPUT

*&---------------------------------------------------------------------*
MODULE PBO_0100 OUTPUT.
  SET PF-STATUS 'GUI_0100'.
  SET TITLEBAR 'STANDARD'.
  PERFORM DELETE_CANCELLED_LOTS.
  SORT IT_OUTPUT BY INSPDATE INSPECTION ROLL TIMES SORT_KEY ASCENDING.

  PERFORM DISPLAY_DATA CHANGING IT_OUTPUT GT_FIELDCAT.
  IF G_GRID IS BOUND.
    CALL METHOD G_GRID->REFRESH_TABLE_DISPLAY.
  ENDIF.
ENDMODULE.                 " PBO  OUTPUT
*----------------------------------------------------------------------*
*  MODULE PBO_0200 OUTPUT
*----------------------------------------------------------------------*
MODULE PBO_0200 OUTPUT.
  SET PF-STATUS 'GUI_0200'.
  SET TITLEBAR 'STANDARD'.
  PERFORM DELETE_CANCELLED_LOTS.
  SORT IT_OUTPUT BY INSPDATE INSPECTION ROLL TIMES SORT_KEY ASCENDING.
  PERFORM DISPLAY_DATA CHANGING IT_OUTPUT GT_FIELDCAT.
  IF G_GRID IS BOUND.
    CALL METHOD G_GRID->REFRESH_TABLE_DISPLAY.
  ENDIF.
ENDMODULE.                    "PBO_0200 OUTPUT

*&---------------------------------------------------------------------*
*&      Module  PAI  INPUT

*&---------------------------------------------------------------------*
MODULE PAI_0100 INPUT.
  IF G_GRID IS INITIAL.
    CALL FUNCTION 'GET_GLOBALS_FROM_SLVC_FULLSCR'
      IMPORTING
        E_GRID = G_GRID.
  ENDIF.
  IF NOT G_GRID IS INITIAL.
    CALL METHOD G_GRID->CHECK_CHANGED_DATA.
  ENDIF.
  CASE SY-UCOMM.
    WHEN 'EXIT'.
      LEAVE TO SCREEN 3000.
    WHEN 'CANCEL'.
      LEAVE TO SCREEN 3000.
    WHEN 'CBAC'.
      LEAVE TO SCREEN 3000.
    WHEN 'XLSX'.
      PERFORM DOWNLOAD_TEMPLATE.
    WHEN 'UPLOAD'.
      SET SCREEN 0.
      CALL SELECTION-SCREEN 4000.
    WHEN 'SUBMIT'.
      PERFORM UPDATE_JUDGEMENT.
    WHEN 'DELETE'.
      PERFORM UPDATE_JUDGEMENT_DELETE.
  ENDCASE.
ENDMODULE.                 " PAI  INPUT
*----------------------------------------------------------------------*
*  MODULE PAI_0200 INPUT
*----------------------------------------------------------------------*
MODULE PAI_0200 INPUT.
  IF G_GRID IS INITIAL.
    CALL FUNCTION 'GET_GLOBALS_FROM_SLVC_FULLSCR'
      IMPORTING
        E_GRID = G_GRID.
  ENDIF.
  IF NOT G_GRID IS INITIAL.
    CALL METHOD G_GRID->CHECK_CHANGED_DATA.
  ENDIF.
  CASE SY-UCOMM.
    WHEN 'EXIT2'.
      LEAVE TO SCREEN 4000.
    WHEN 'CANCEL2'.
      LEAVE TO SCREEN 4000.
    WHEN 'CBAC'.
      LEAVE TO SCREEN 4000.
    WHEN 'SUBMIT2'.
      PERFORM UPDATE_JUDGEMENT.
  ENDCASE.
ENDMODULE.                 " PAI  INPUT

*&---------------------------------------------------------------------*
*&      Form  GENERATE_ESTIMATION_DATE

*&---------------------------------------------------------------------*
FORM GENERATE_ESTIMATION_DATE TABLES T_TABLE LIKE IT_OUTPUT.
  FIELD-SYMBOLS: <FS_OUTPUT> LIKE LINE OF T_TABLE.
  CLEAR:WA_OUTPUT.
  CLEAR : IT_MAP_ESTIMATION_DATE.
  REFRESH : IT_MAP_ESTIMATION_DATE.
  SELECT * INTO TABLE IT_MAP_ESTIMATION_DATE FROM ZMAP_TYPE WHERE PROG = SY-REPID AND TYPE = 'BARRIER' AND OPT = 'ESTDATE' AND DELETION = ''.
  IF IT_MAP_ESTIMATION_DATE[] IS NOT INITIAL.
    LOOP AT T_TABLE ASSIGNING <FS_OUTPUT> WHERE INSPDATE NE ''.
      CLEAR : WA_MAP_ESTIMATION_DATE.
      READ TABLE IT_MAP_ESTIMATION_DATE INTO WA_MAP_ESTIMATION_DATE WITH KEY VALUE = <FS_OUTPUT>-INSPECTION.
      PERFORM CONVERT_DATE_INPUT USING <FS_OUTPUT>-INSPDATE CHANGING V_DATE.
      CASE <FS_OUTPUT>-TIMES.
        WHEN '1'.
          V_DATE = V_DATE + WA_MAP_ESTIMATION_DATE-TEXT1.
        WHEN '2'.
          V_DATE  = V_DATE + WA_MAP_ESTIMATION_DATE-TEXT2.
        WHEN '3'.
          V_DATE = V_DATE + WA_MAP_ESTIMATION_DATE-TEXT3.
        WHEN '4'.
          V_DATE = V_DATE + WA_MAP_ESTIMATION_DATE-TEXT4.
      ENDCASE.
      <FS_OUTPUT>-INSPDATE2 = V_DATE.
      <FS_OUTPUT>-INSPDATE = V_DATE.
    ENDLOOP.
  ENDIF.
ENDFORM.                    " GENERATE_ESTIMATION_DATE

*&---------------------------------------------------------------------*
*&      Form  POPULATE_INSPECTION_DATA

*&---------------------------------------------------------------------*
FORM POPULATE_INSPECTION_DATA .
  " JANGAN hapus/clear IT_COMPARE di sini agar data dari GET_INITIAL_DATA tetap bertahan
  CLEAR : V_TFILL, V_VALUE, IT_INSP_DAT, WA_INSP_DAT.
  REFRESH : IT_INSP_DAT.
  DESCRIBE TABLE IT_BATCHSR_SAMPLE LINES V_TFILL.
  LOOP AT IT_BATCHSR_SAMPLE.
    PERFORM SET_INDICATOR USING SY-TABIX V_TFILL 2 V_PROC_EX 'Get Inspection...'.
    PERFORM GET_INSPECTION USING IT_BATCHSR_SAMPLE-CHARGSR IT_BATCHSR_SAMPLE-MATNRSR IT_BATCHSR_SAMPLE-CHARGJR 'X'.
  ENDLOOP.
  " ... (Sisa kode di bawahnya tetap sama) ...
  FIELD-SYMBOLS: <FS_OUTPUT> LIKE LINE OF IT_OUTPUT.
  CLEAR:WA_MAP_INSP_CHAR.
  LOOP AT IT_OUTPUT ASSIGNING <FS_OUTPUT>.
    CLEAR : INSP_CHAR, INSP_MIC, INSP_VER, V_CYCLES, WA_MAP_INSP_CHAR,V_INSPTEXT, V_INSPCHAR.
    READ TABLE IT_BATCHSR_SAMPLE WITH KEY CHARGSR = <FS_OUTPUT>-CHARG.
    CLEAR : WA_MAP_INSP_CHAR.
    LOOP AT IT_MAP_INSP_CHAR INTO WA_MAP_INSP_CHAR WHERE MATNR = IT_BATCHSR_SAMPLE-MATNRSR.
      IF WA_MAP_INSP_CHAR-VERWMERKM CS 'WVTR' OR WA_MAP_INSP_CHAR-VERWMERKM CS 'MVTR'.
        <FS_OUTPUT>-WVTR_CHAR    = WA_MAP_INSP_CHAR-MERKNR.
        <FS_OUTPUT>-WVTR_MIC     = WA_MAP_INSP_CHAR-VERWMERKM.
        <FS_OUTPUT>-WVTR_VERSION = WA_MAP_INSP_CHAR-MKVERSION.
      ELSEIF WA_MAP_INSP_CHAR-VERWMERKM CS 'OTR' OR WA_MAP_INSP_CHAR-VERWMERKM CS 'O2TR'.
        <FS_OUTPUT>-OTR_CHAR     = WA_MAP_INSP_CHAR-MERKNR.
        <FS_OUTPUT>-OTR_MIC      = WA_MAP_INSP_CHAR-VERWMERKM.
        <FS_OUTPUT>-OTR_VERSION  = WA_MAP_INSP_CHAR-MKVERSION.
      ENDIF.
    ENDLOOP.
    IF <FS_OUTPUT>-INSPECTION CS 'WVTR' OR <FS_OUTPUT>-INSPECTION CS 'MVTR'.
      V_INSPTEXT = <FS_OUTPUT>-WVTR_MIC.
      V_INSPCHAR = <FS_OUTPUT>-WVTR_CHAR.
    ELSEIF <FS_OUTPUT>-INSPECTION CS 'OTR' OR <FS_OUTPUT>-INSPECTION CS 'O2TR'.
      V_INSPTEXT = <FS_OUTPUT>-OTR_MIC.
      V_INSPCHAR = <FS_OUTPUT>-OTR_CHAR.
    ENDIF.
    CLEAR : V_TFILL.
    DESCRIBE TABLE IT_INSP_DAT LINES V_TFILL.
    LOOP AT IT_INSP_DAT INTO WA_INSP_DAT WHERE CHARGJR = <FS_OUTPUT>-CHARGJR AND TIMES = <FS_OUTPUT>-TIMES AND POSISI CS <FS_OUTPUT>-POSISI AND MASTERINSP CS V_INSPTEXT.
      PERFORM SET_INDICATOR USING SY-TABIX V_TFILL 3 V_PROC_EX 'Get Status...'.
      CLEAR : WA_MAP_INSP_CHAR.
      LOOP AT IT_MAP_INSP_CHAR INTO WA_MAP_INSP_CHAR WHERE  MKMNR = WA_INSP_DAT-MASTERINSP AND MERKNR EQ WA_INSP_DAT-INSPTYPE.
        CASE WA_INSP_DAT-CYCLES.
          WHEN 1.
            <FS_OUTPUT>-VALUE1 = WA_INSP_DAT-VALUE.
          WHEN 2.
            <FS_OUTPUT>-VALUE2 = WA_INSP_DAT-VALUE.
          WHEN 3.
            <FS_OUTPUT>-VALUE3 = WA_INSP_DAT-VALUE.
          WHEN 4.
            <FS_OUTPUT>-VALUE4 = WA_INSP_DAT-VALUE.
        ENDCASE.
        <FS_OUTPUT>-STATUS = 'OK'.
        IF WA_INSP_DAT-VALUE < WA_MAP_INSP_CHAR-TOLERANZUN OR WA_INSP_DAT-VALUE > WA_MAP_INSP_CHAR-TOLERANZOB.
          <FS_OUTPUT>-STATUS = 'NOT OK'.
        ENDIF.
      ENDLOOP.
      <FS_OUTPUT>-PRUEFLOS = WA_INSP_DAT-INSPLOT.
      <FS_OUTPUT>-AUFPL    = WA_INSP_DAT-AUFPL.
      <FS_OUTPUT>-WERKS    = WA_INSP_DAT-PLANT.
      <FS_OUTPUT>-APRV_STATUS = WA_INSP_DAT-STATUS.
      IF <FS_OUTPUT>-INSPECTION CS 'WVTR' OR <FS_OUTPUT>-INSPECTION CS 'MVTR'.
        <FS_OUTPUT>-APRV_STATUS2 = WA_INSP_DAT-STATUS(2).
      ELSEIF <FS_OUTPUT>-INSPECTION CS 'OTR' OR <FS_OUTPUT>-INSPECTION CS 'O2TR'.
        <FS_OUTPUT>-APRV_STATUS2 = WA_INSP_DAT-STATUS+2(2).
      ENDIF.
      CASE <FS_OUTPUT>-APRV_STATUS2.
        WHEN 'NG'.
          <FS_OUTPUT>-APRV_STATUS2 = 'REJECTED'.
        WHEN 'OK'.
          <FS_OUTPUT>-APRV_STATUS2 = 'APPROVED'.
        WHEN 'NO'.
          <FS_OUTPUT>-APRV_STATUS2 = 'CREATED'.
      ENDCASE.
      SELECT QASE~PRUEFLOS MERKNR PROBENR STUECKNR MESSWERT MBEWERTG PRUEFDATUV AS BUDAT ATTRIBUT
        APPENDING CORRESPONDING FIELDS OF TABLE IT_COMPARE
        FROM QASE
        JOIN QALS ON QALS~PRUEFLOS = QASE~PRUEFLOS
       WHERE QASE~PRUEFLOS EQ WA_INSP_DAT-INSPLOT.
    ENDLOOP.
    READ TABLE IT_BATCHSR_SAMPLE WITH KEY CHARGSR = <FS_OUTPUT>-CHARG.
    IF SY-SUBRC EQ 0.
      <FS_OUTPUT>-MATNR    = IT_BATCHSR_SAMPLE-MATNRSR.
      <FS_OUTPUT>-WERKS    = IT_BATCHSR_SAMPLE-WERKS.
    ENDIF.
    CASE <FS_OUTPUT>-POSISI.
      WHEN 'R'.
        <FS_OUTPUT>-SORT_KEY = 1.
      WHEN 'C'.
        <FS_OUTPUT>-SORT_KEY = 2.
      WHEN 'L'.
        <FS_OUTPUT>-SORT_KEY = 3.
    ENDCASE.
    SELECT SINGLE ZZPROLL INTO <FS_OUTPUT>-ROLL_INSP FROM QALS WHERE PRUEFLOS EQ <FS_OUTPUT>-PRUEFLOS.
    IF <FS_OUTPUT>-ROLL_INSP IS NOT INITIAL.
      IF <FS_OUTPUT>-ROLL_INSP NE <FS_OUTPUT>-ROLL.
        CONCATENATE 'Inpection Lot position' <FS_OUTPUT>-POSISI 'used in JR' <FS_OUTPUT>-ROLL_INSP 'while now JR is' <FS_OUTPUT>-ROLL INTO V_MESSAGE SEPARATED BY SPACE.
        <FS_OUTPUT>-MESS  = V_MESSAGE.
        <FS_OUTPUT>-ZSTAT = WARNING.
      ENDIF.
    ENDIF.
  ENDLOOP.

  " Filter out invalidated records (ATTRIBUT = '/')
  DATA: LV_INVALID TYPE FLAG,
        WA_OUT     LIKE LINE OF IT_OUTPUT,
        WA_COMP    LIKE LINE OF IT_COMPARE.
  LOOP AT IT_OUTPUT INTO WA_OUT.
    LV_INVALID = ''.
    LOOP AT IT_COMPARE INTO WA_COMP WHERE PRUEFLOS = WA_OUT-PRUEFLOS
                                      AND PROBENR  = WA_OUT-TIMES
                                      AND ( MERKNR = WA_OUT-WVTR_CHAR OR MERKNR = WA_OUT-OTR_CHAR ).
      IF WA_COMP-ATTRIBUT EQ '/'.
        LV_INVALID = 'X'.
        EXIT.
      ENDIF.
    ENDLOOP.
    IF LV_INVALID EQ 'X'.
      DELETE IT_OUTPUT.
    ENDIF.
  ENDLOOP.

ENDFORM.                    "POPULATE_INSPECTION_DATA

*&---------------------------------------------------------------------*
*&      Form  GET_JUDGEMENT_STATUS

*&---------------------------------------------------------------------*
FORM GET_JUDGEMENT_STATUS  USING    INSP_VAL
                                    SHIP_LEVEL
                                    CUST_LEVEL
                                    MANGT_LEVEL
                           CHANGING STATUS.
  STATUS = 'OK'.
  IF INSP_VAL < MANGT_LEVEL OR INSP_VAL > CUST_LEVEL .
    STATUS = 'NOT OK'.
  ENDIF.
ENDFORM.                    " GET_JUDGEMENT_STATUS

*&---------------------------------------------------------------------*
*&      Form  UPDATE_JUDGEMENT

*&---------------------------------------------------------------------*
FORM UPDATE_JUDGEMENT.
  CALL METHOD G_GRID->REFRESH_TABLE_DISPLAY.
  CLEAR : ITAB, V_ERR .
  REFRESH : ITAB.
  LOOP AT IT_OUTPUT INTO WA_OUTPUT.
    WA_OUTPUT-ZSTAT = GREY.
    WA_OUTPUT-BOX = ''.
    WA_OUTPUT-ERR = ''.
    WA_OUTPUT-MESS = ''.
    MODIFY IT_OUTPUT FROM WA_OUTPUT INDEX SY-TABIX.
  ENDLOOP.
  LOOP AT LT_ROW_NO.
    READ TABLE IT_OUTPUT INTO WA_OUTPUT INDEX LT_ROW_NO-ROW_ID.
    WA_OUTPUT-BOX = 'X'.
    " --- NEW: Cek apakah Lot punya UD sebelumnya ---
    IF WA_OUTPUT-PRUEFLOS IS NOT INITIAL.
      SELECT SINGLE STAT35 INTO WA_OUTPUT-HAS_UD FROM QALS WHERE PRUEFLOS = WA_OUTPUT-PRUEFLOS.
      IF WA_OUTPUT-HAS_UD EQ 'X'.
        SELECT SINGLE VCODE VCODEGRP VAUSWAHLMG
          INTO (WA_OUTPUT-OLD_UD, WA_OUTPUT-OLD_CODEGRP,
                WA_OUTPUT-OLD_SELECTED_SET)
          FROM QAVE
          WHERE PRUEFLOS = WA_OUTPUT-PRUEFLOS.
      ENDIF.
    ENDIF.
    " -----------------------------------------------
    MODIFY IT_OUTPUT FROM WA_OUTPUT INDEX LT_ROW_NO-ROW_ID.
  ENDLOOP.
  APPEND LINES OF IT_OUTPUT TO ITAB.
  PERFORM CONFIRMATION.
  IF V_ERR NE 'X'.
    PERFORM RESULT_RECORDING.
    DATA L_TMP_MERKNR TYPE QMERKNR.
    DATA L_INSPSAMPLE2 LIKE BAPI2045D4-INSPSAMPLE.
    DATA L_INSPSAMPLE LIKE BAPI2045D4-INSPSAMPLE.

    PERFORM PROCESS_DELAYING.
    PERFORM USAGE_DECISION.
    PERFORM REFRESH.
    PERFORM CHECK_ERROR.

    " --- NEW: Auto update ALV after transaction ---
    CLEAR : IT_OUTPUT.
    REFRESH : IT_OUTPUT.
    APPEND LINES OF ITAB TO IT_OUTPUT.
    " ----------------------------------------------
  ENDIF.
ENDFORM.                    " UPDATE_JUDGEMENT

*&---------------------------------------------------------------------*
*&      Form  GET_DATA_PREVIEW

*&---------------------------------------------------------------------*
*&---------------------------------------------------------------------*
*&      Form  GET_DATA_PREVIEW
*&---------------------------------------------------------------------*
*&---------------------------------------------------------------------*
*&      Form  GET_DATA_PREVIEW
*&---------------------------------------------------------------------*
FORM GET_DATA_PREVIEW.
  DATA: LT_ROLL_PARTS TYPE TABLE OF STRING,
        LV_ROLL_PART  TYPE STRING,
        LV_PART_COUNT TYPE I,
        LV_LEN        TYPE I.
  DATA: V_CODEWVTR TYPE STRING, V_CODEOTR TYPE STRING.
  DATA: LV_V1 TYPE STRING, LV_V2 TYPE STRING, LV_V3 TYPE STRING, LV_V4 TYPE STRING.

  REFRESH: IT_COMPARE, ITAB, IT_INSP_DAT, IT_MAP_INSP_CHAR.
  CLEAR: IT_COMPARE, V_MATEXCLUDE, IT_INSP_DAT, WA_INSP_DAT, WA_MAP_INSP_CHAR.
  SORT IT_UPLOAD BY ROLL INSPDATE TYPE TIMES ASCENDING.

  TYPES: BEGIN OF TY_BATCH_SR,
           ATWRT    TYPE AUSP-ATWRT,
           MATNR    TYPE MCH1-MATNR,
           CHARG    TYPE MCH1-CHARG,
           CUOBJ_BM TYPE MCH1-CUOBJ_BM,
         END OF TY_BATCH_SR.
  DATA: LT_BATCH_SR TYPE TABLE OF TY_BATCH_SR,
        LS_BATCH_SR TYPE TY_BATCH_SR.

  TYPES: BEGIN OF TY_BATCH_JR,
           ATWRT TYPE AUSP-ATWRT,
           CHARG TYPE MCH1-CHARG,
           ERSDA TYPE MCH1-ERSDA,
         END OF TY_BATCH_JR.
  DATA: LT_BATCH_JR TYPE TABLE OF TY_BATCH_JR,
        LS_BATCH_JR TYPE TY_BATCH_JR.

  TYPES: BEGIN OF TY_QALS_BULK,
           PRUEFLOS TYPE QALS-PRUEFLOS,
           CHARG    TYPE QALS-CHARG,
           MATNR    TYPE QALS-MATNR,
           WERK     TYPE QALS-WERK,
           AUFPL    TYPE QALS-AUFPL,
           ZZPROLL  TYPE QALS-ZZPROLL,
         END OF TY_QALS_BULK.
  DATA: LT_QALS_BULK TYPE TABLE OF TY_QALS_BULK,
        LS_QALS_BULK TYPE TY_QALS_BULK.

  TYPES: BEGIN OF TY_QAMV_BULK,
           PRUEFLOS  TYPE QAMV-PRUEFLOS,
           MERKNR    TYPE QAMV-MERKNR,
           VERWMERKM TYPE QAMV-VERWMERKM,
           MKVERSION TYPE QAMV-MKVERSION,
           KURZTEXT  TYPE QAMV-KURZTEXT,
         END OF TY_QAMV_BULK.
  DATA: LT_QAMV_BULK TYPE TABLE OF TY_QAMV_BULK,
        LS_QAMV_BULK TYPE TY_QAMV_BULK.

  PERFORM GET_ATINN USING 'ZZNOMORROLL' CHANGING V_ATINN.

  " --- 1. BULK GET BATCH SR FROM AUSP + MCH1 (Fast Index N1: KLART = 023) ---
  IF IT_UPLOAD[] IS NOT INITIAL.
    SELECT AUSP~ATWRT MCH1~MATNR MCH1~CHARG MCH1~CUOBJ_BM
      INTO TABLE LT_BATCH_SR
      FROM MCH1
      JOIN AUSP ON AUSP~OBJEK = MCH1~CUOBJ_BM
      FOR ALL ENTRIES IN IT_UPLOAD
     WHERE AUSP~ATWRT = IT_UPLOAD-ROLL
       AND AUSP~KLART = '023'
       AND AUSP~MAFID = 'O'
       AND AUSP~ATINN = V_ATINN.
    SORT LT_BATCH_SR BY ATWRT.
  ENDIF.

  " --- 2. BULK GET BATCH JR FROM AUSP + MCH1 ---
  IF IT_UPLOAD[] IS NOT INITIAL.
    SELECT AUSP~ATWRT MCH1~CHARG MCH1~ERSDA
      INTO TABLE LT_BATCH_JR
      FROM MCH1
      JOIN AUSP ON AUSP~OBJEK = MCH1~CUOBJ_BM
      FOR ALL ENTRIES IN IT_UPLOAD
     WHERE AUSP~ATWRT = IT_UPLOAD-ROLL_JR
       AND MCH1~FVDT1 = '00000000'
       AND AUSP~KLART = '023'
       AND AUSP~MAFID = 'O'
       AND AUSP~ATINN = V_ATINN.
    SORT LT_BATCH_JR BY ATWRT ASCENDING ERSDA DESCENDING.
  ENDIF.

  " --- 3. BULK GET QALS (INSPECTION LOT) ---
  IF LT_BATCH_SR[] IS NOT INITIAL.
    SELECT PRUEFLOS CHARG MATNR WERK AUFPL ZZPROLL
      INTO TABLE LT_QALS_BULK
      FROM QALS
      FOR ALL ENTRIES IN LT_BATCH_SR
     WHERE CHARG = LT_BATCH_SR-CHARG.
    SORT LT_QALS_BULK BY CHARG.
  ENDIF.

  " --- 4. BULK GET QAMV (LOT CHARACTERISTICS) ---
  IF LT_QALS_BULK[] IS NOT INITIAL.
    SELECT PRUEFLOS MERKNR VERWMERKM MKVERSION KURZTEXT
      INTO TABLE LT_QAMV_BULK
      FROM QAMV
      FOR ALL ENTRIES IN LT_QALS_BULK
     WHERE PRUEFLOS = LT_QALS_BULK-PRUEFLOS.
    SORT LT_QAMV_BULK BY PRUEFLOS MERKNR.
  ENDIF.

  " --- 5. BULK GET ROUTING MASTER CHARACTERISTICS (MAPL + PLKO + PLMK + QDSV) ---
  IF LT_QALS_BULK[] IS NOT INITIAL.
    SELECT MAPL~MATNR PLMK~MERKNR PLMK~VERWMERKM PLMK~MKVERSION QDSV~STPRUMF
           QPMK_ZAEHL AS ZAEHLER PLMK~VERWMERKM AS MKMNR KURZTEXT AS SORTFELD
           SOLLWERT TOLERANZOB TOLERANZUN DELKZ PRUEFEINH
      INTO CORRESPONDING FIELDS OF TABLE IT_MAP_INSP_CHAR
      FROM MAPL
      JOIN PLKO ON PLKO~PLNTY EQ MAPL~PLNTY AND PLKO~PLNNR EQ MAPL~PLNNR AND PLKO~PLNAL EQ MAPL~PLNAL
      JOIN PLMK ON PLKO~PLNTY EQ PLMK~PLNTY AND PLKO~PLNNR EQ PLMK~PLNNR AND PLKO~ZAEHL EQ PLMK~PLNKN
      JOIN QDSV ON PLMK~STICHPRVER EQ QDSV~STICHPRVER
      FOR ALL ENTRIES IN LT_QALS_BULK
     WHERE MAPL~WERKS EQ LT_QALS_BULK-WERK
       AND MAPL~MATNR EQ LT_QALS_BULK-MATNR
       AND PLKO~KTEXT LIKE '%After Slitting%'
       AND MAPL~LOEKZ NE 'X'.
    SORT IT_MAP_INSP_CHAR BY MATNR VERWMERKM.
  ENDIF.

  " --- 6. BULK GET QASE (EXISTING RESULTS) ---
  IF LT_QALS_BULK[] IS NOT INITIAL.
    SELECT PRUEFLOS MERKNR PROBENR STUECKNR MESSWERT MBEWERTG PRUEFDATUV AS BUDAT ATTRIBUT
      INTO CORRESPONDING FIELDS OF TABLE IT_COMPARE
      FROM QASE
      FOR ALL ENTRIES IN LT_QALS_BULK
     WHERE PRUEFLOS = LT_QALS_BULK-PRUEFLOS.
    SORT IT_COMPARE BY PRUEFLOS MERKNR PROBENR STUECKNR.
  ENDIF.

  " --- 7. MAIN LOOP: IN-MEMORY PROCESSING (ZERO DATABASE SELECT INSIDE) ---
  LOOP AT IT_UPLOAD.
    CLEAR: IT_QASE, IT_WVTR, IT_OTR, V_PRUEFLOS, INSP_CHAR, V_DATE.
    REFRESH: IT_QASE, IT_WVTR, IT_OTR.
    V_MINCYCLE = 1.
    REPLACE ALL OCCURRENCES OF '/' IN IT_UPLOAD-INSPDATE WITH '.'.
    IF IT_UPLOAD-INSPDATE2 IS INITIAL OR IT_UPLOAD-INSPDATE2 EQ ''.
      PERFORM CONVERT_DATE_INPUT USING IT_UPLOAD-INSPDATE CHANGING IT_UPLOAD-INSPDATE2.
    ENDIF.
    MOVE-CORRESPONDING IT_UPLOAD TO ITAB.
    ITAB-ZSTAT = GREY.

    " Parse Roll Position and Times
    CLEAR LT_ROLL_PARTS.
    SPLIT ITAB-ROLL AT SPACE INTO TABLE LT_ROLL_PARTS.
    DESCRIBE TABLE LT_ROLL_PARTS LINES LV_PART_COUNT.
    IF LV_PART_COUNT >= 7.
      READ TABLE LT_ROLL_PARTS INTO LV_ROLL_PART INDEX 5.
      LV_LEN = STRLEN( LV_ROLL_PART ).
      LV_LEN = LV_LEN - 1.
      IF LV_LEN >= 0.
        ITAB-POSISI = LV_ROLL_PART+LV_LEN(1).
      ENDIF.
      READ TABLE LT_ROLL_PARTS INTO LV_ROLL_PART INDEX 7.
      IF LV_ROLL_PART CO '0123456789'.
        ITAB-TIMES = LV_ROLL_PART.
      ENDIF.
    ENDIF.

    REPLACE ALL OCCURRENCES OF '|' IN ITAB-POSISI WITH SPACE.
    CASE ITAB-POSISI.
      WHEN 'R'.
        ITAB-SORT_KEY = 1.
      WHEN 'C'.
        ITAB-SORT_KEY = 2.
      WHEN 'L'.
        ITAB-SORT_KEY = 3.
    ENDCASE.

    " Read Batch Jumbo Roll from pre-fetched LT_BATCH_JR
    READ TABLE LT_BATCH_JR INTO LS_BATCH_JR WITH KEY ATWRT = ITAB-ROLL_JR BINARY SEARCH.
    IF SY-SUBRC = 0.
      ITAB-CHARGJR = LS_BATCH_JR-CHARG.
    ENDIF.

    IF ITAB-CHARGJR IS INITIAL.
      ITAB-ZSTAT = ERROR.
      ITAB-MESS  = 'Batch jumbo roll not found!'.
      ITAB-ERR   = 'X'.
      APPEND ITAB.
      CLEAR ITAB.
      CONTINUE.
    ENDIF.

    " Read Batch Slit Roll from pre-fetched LT_BATCH_SR
    READ TABLE LT_BATCH_SR INTO LS_BATCH_SR WITH KEY ATWRT = ITAB-ROLL BINARY SEARCH.
    IF SY-SUBRC = 0.
      ITAB-CHARG = LS_BATCH_SR-CHARG.
      ITAB-MATNR = LS_BATCH_SR-MATNR.
    ENDIF.

    IF ITAB-CHARG IS INITIAL.
      ITAB-ZSTAT = ERROR.
      ITAB-MESS  = 'Batch slit roll not found!'.
      ITAB-ERR   = 'X'.
      APPEND ITAB.
      CLEAR ITAB.
      CONTINUE.
    ENDIF.

    CONCATENATE 'S' ITAB-MATNR+2(3) 'WVTR' INTO V_CODEWVTR.
    CONCATENATE 'S' ITAB-MATNR+2(3) 'OTR' INTO V_CODEOTR.

    IF ITAB-INSPDATE2 IS NOT INITIAL AND ITAB-INSPDATE2 <> '00000000'.
      ITAB-INSPDATE = ITAB-INSPDATE2.
    ENDIF.

    " Read Inspection Lot from pre-fetched LT_QALS_BULK
    READ TABLE LT_QALS_BULK INTO LS_QALS_BULK WITH KEY CHARG = ITAB-CHARG BINARY SEARCH.
    IF SY-SUBRC = 0.
      ITAB-PRUEFLOS  = LS_QALS_BULK-PRUEFLOS.
      ITAB-AUFPL     = LS_QALS_BULK-AUFPL.
      ITAB-WERKS     = LS_QALS_BULK-WERK.
      ITAB-ROLL_INSP = LS_QALS_BULK-ZZPROLL.
      IF ITAB-ROLL_INSP IS NOT INITIAL AND ITAB-ROLL_INSP NE ITAB-ROLL.
        CONCATENATE 'Inpection Lot position' ITAB-POSISI 'used in JR' ITAB-ROLL_INSP 'while now JR is' ITAB-ROLL INTO V_MESSAGE SEPARATED BY SPACE.
        ITAB-MESS  = V_MESSAGE.
        ITAB-ZSTAT = WARNING.
      ENDIF.
    ENDIF.

    " Match Characteristic from QAMV or Master Routing
    IF ITAB-PRUEFLOS IS NOT INITIAL.
      LOOP AT LT_QAMV_BULK INTO LS_QAMV_BULK WHERE PRUEFLOS = ITAB-PRUEFLOS.
        IF LS_QAMV_BULK-VERWMERKM CS 'WVTR' OR LS_QAMV_BULK-VERWMERKM CS 'MVTR'.
          ITAB-WVTR_CHAR    = LS_QAMV_BULK-MERKNR.
          ITAB-WVTR_MIC     = LS_QAMV_BULK-VERWMERKM.
          ITAB-WVTR_VERSION = LS_QAMV_BULK-MKVERSION.
        ELSEIF LS_QAMV_BULK-VERWMERKM CS 'OTR' OR LS_QAMV_BULK-VERWMERKM CS 'O2TR'.
          ITAB-OTR_CHAR    = LS_QAMV_BULK-MERKNR.
          ITAB-OTR_MIC     = LS_QAMV_BULK-VERWMERKM.
          ITAB-OTR_VERSION = LS_QAMV_BULK-MKVERSION.
        ENDIF.
        IF LS_QAMV_BULK-VERWMERKM CS ITAB-INSPECTION OR LS_QAMV_BULK-VERWMERKM CS ITAB-TYPE.
          ITAB-MERKNR = LS_QAMV_BULK-MERKNR.
        ENDIF.
      ENDLOOP.
    ELSE.
      LOOP AT IT_MAP_INSP_CHAR INTO WA_MAP_INSP_CHAR WHERE MATNR = ITAB-MATNR.
        IF WA_MAP_INSP_CHAR-VERWMERKM CS 'WVTR' OR WA_MAP_INSP_CHAR-VERWMERKM CS 'MVTR'.
          ITAB-WVTR_CHAR    = WA_MAP_INSP_CHAR-MERKNR.
          ITAB-WVTR_MIC     = WA_MAP_INSP_CHAR-VERWMERKM.
          ITAB-WVTR_VERSION = WA_MAP_INSP_CHAR-MKVERSION.
        ELSEIF WA_MAP_INSP_CHAR-VERWMERKM CS 'OTR' OR WA_MAP_INSP_CHAR-VERWMERKM CS 'O2TR'.
          ITAB-OTR_CHAR    = WA_MAP_INSP_CHAR-MERKNR.
          ITAB-OTR_MIC     = WA_MAP_INSP_CHAR-VERWMERKM.
          ITAB-OTR_VERSION = WA_MAP_INSP_CHAR-MKVERSION.
        ENDIF.
        IF WA_MAP_INSP_CHAR-VERWMERKM CS ITAB-INSPECTION OR WA_MAP_INSP_CHAR-VERWMERKM CS ITAB-TYPE.
          ITAB-MERKNR = WA_MAP_INSP_CHAR-MERKNR.
        ENDIF.
      ENDLOOP.
    ENDIF.

    IF ITAB-MERKNR IS INITIAL.
      IF ITAB-INSPECTION CS 'WVTR' OR ITAB-INSPECTION CS 'MVTR'.
        ITAB-MERKNR = ITAB-WVTR_CHAR.
      ELSEIF ITAB-INSPECTION CS 'OTR' OR ITAB-INSPECTION CS 'O2TR'.
        ITAB-MERKNR = ITAB-OTR_CHAR.
      ENDIF.
    ENDIF.

    " Get Cycle limit STPRUMF from master routing
    READ TABLE IT_MAP_INSP_CHAR INTO WA_MAP_INSP_CHAR WITH KEY MATNR = ITAB-MATNR VERWMERKM = ITAB-WVTR_MIC.
    IF SY-SUBRC NE 0.
      READ TABLE IT_MAP_INSP_CHAR INTO WA_MAP_INSP_CHAR WITH KEY MATNR = ITAB-MATNR VERWMERKM = ITAB-OTR_MIC.
    ENDIF.
    IF SY-SUBRC EQ 0 AND WA_MAP_INSP_CHAR-STPRUMF IS NOT INITIAL.
      ITAB-CYCLE = WA_MAP_INSP_CHAR-STPRUMF.
    ENDIF.

    " Coloring Column
    IF ITAB-WVTR_CHAR IS NOT INITIAL AND ITAB-OTR_CHAR IS NOT INITIAL.
      V_MINCYCLE = 1.
      WHILE V_MINCYCLE LE 4.
        PERFORM GENERATE_COLUMN_NAME USING ITAB-INSPECTION ITAB-PRUEFLOS ITAB-TIMES V_MINCYCLE.
        ADD 1 TO V_MINCYCLE.
      ENDWHILE.
    ENDIF.

    " Check Exclude
    LOOP AT IT_COMPARE WHERE PRUEFLOS = ITAB-PRUEFLOS AND MERKNR = ITAB-MERKNR.
      IF IT_COMPARE-ATTRIBUT IS NOT INITIAL AND IT_COMPARE-ATTRIBUT NE ' '.
        V_EXCLUDE = 'X'.
        EXIT.
      ENDIF.
    ENDLOOP.

    " Calculate Last Value and Status
    CLEAR: WA_MAP_INSP_CHAR.
    READ TABLE IT_MAP_INSP_CHAR WITH KEY MERKNR = ITAB-MERKNR INTO WA_MAP_INSP_CHAR.

    LV_V4 = ITAB-VALUE4. CONDENSE LV_V4.
    LV_V3 = ITAB-VALUE3. CONDENSE LV_V3.
    LV_V2 = ITAB-VALUE2. CONDENSE LV_V2.
    LV_V1 = ITAB-VALUE1. CONDENSE LV_V1.

    IF LV_V4 NE '' AND LV_V4 NE '0.000'.
      ITAB-LAST_VALUE = ITAB-VALUE4.
    ELSEIF LV_V3 NE '' AND LV_V3 NE '0.000'.
      ITAB-LAST_VALUE = ITAB-VALUE3.
    ELSEIF LV_V2 NE '' AND LV_V2 NE '0.000'.
      ITAB-LAST_VALUE = ITAB-VALUE2.
    ELSEIF LV_V1 NE '' AND LV_V1 NE '0.000'.
      ITAB-LAST_VALUE = ITAB-VALUE1.
    ELSE.
      CLEAR ITAB-LAST_VALUE.
    ENDIF.

    IF ITAB-LAST_VALUE IS NOT INITIAL AND ITAB-LAST_VALUE NE '0.000' AND ITAB-LAST_VALUE NE ' '.
      ITAB-STATUS = 'OK'.
      IF ITAB-LAST_VALUE < WA_MAP_INSP_CHAR-TOLERANZUN OR ITAB-LAST_VALUE > WA_MAP_INSP_CHAR-TOLERANZOB.
        ITAB-STATUS = 'NOT OK'.
      ENDIF.
    ELSE.
      ITAB-STATUS = 'NOT YET'.
    ENDIF.

    IF V_EXCLUDE = 'X'.
      IF V_MATEXCLUDE NS ITAB-TYPE.
        CONCATENATE V_MATEXCLUDE ',' ITAB-TYPE INTO V_MATEXCLUDE.
      ENDIF.
    ELSE.
      APPEND ITAB.
    ENDIF.
    CLEAR ITAB.
  ENDLOOP.

  PERFORM GENERATE_ESTIMATION_DATE TABLES ITAB.
  CLEAR : V_MESSAGE.
  DELETE ADJACENT DUPLICATES FROM IT_MAP_INSP_CHAR.
  SORT ITAB BY INSPDATE INSPDATE ROLL TIMES SORT_KEY ASCENDING.
ENDFORM.                    "GET_DATA_PREVIEW

*&---------------------------------------------------------------------*
*&      Form  GENERATE_COLUMN_NAME

*&---------------------------------------------------------------------*
FORM GENERATE_COLUMN_NAME USING TYPE PRUEFLOS POINT CYCLE.
  CLEAR: V_COLUMN, CELL_COLOUR.
  IF TYPE CS 'WVTR' OR TYPE CS 'MVTR'.
    INSP_CHAR = ITAB-WVTR_CHAR.
  ELSEIF TYPE CS 'OTR' OR TYPE CS 'O2TR'.
    INSP_CHAR = ITAB-OTR_CHAR.
  ENDIF.
  LV_CYCLE_STR = CYCLE.
  CONDENSE LV_CYCLE_STR.
  CONCATENATE 'VALUE' LV_CYCLE_STR INTO V_COLUMN.
  READ TABLE IT_COMPARE WITH KEY PRUEFLOS = PRUEFLOS MERKNR = INSP_CHAR PROBENR = POINT STUECKNR = CYCLE.
  IF SY-SUBRC NE 0.
    ASSIGN COMPONENT V_COLUMN OF STRUCTURE ITAB TO <FS_VALUE>.
    IF <FS_VALUE> NE 0 OR <FS_VALUE> IS NOT INITIAL.
      CELL_COLOUR     = 5.
      ITAB-EDIT       = 'X'.
    ENDIF.
  ELSEIF SY-SUBRC EQ 0.
    ASSIGN COMPONENT V_COLUMN OF STRUCTURE ITAB TO <FS_VALUE>.
    IF <FS_VALUE> NE 0 OR <FS_VALUE> IS NOT INITIAL.
      IF IT_COMPARE-ATTRIBUT IS NOT INITIAL.                                            "Yellow (If Deleted Result Record
        CELL_COLOUR   = 3.
      ELSEIF <FS_VALUE> NE IT_COMPARE-MESSWERT AND IT_COMPARE-ATTRIBUT IS INITIAL.  "Green (If Change and there are different data
        CELL_COLOUR   = 5.
      ELSEIF <FS_VALUE> EQ IT_COMPARE-MESSWERT
         AND IT_COMPARE-ATTRIBUT IS INITIAL.                                             "Green (If Change and there are different data
        CELL_COLOUR   = 3.
      ENDIF.
    ENDIF.
  ELSE.
    ASSIGN COMPONENT V_COLUMN OF STRUCTURE ITAB TO <FS_VALUE>.
    IF <FS_VALUE> NE 0 OR <FS_VALUE> IS NOT INITIAL.                      "Red (Create or Change not be uploaded
      CELL_COLOUR     = 6.
    ENDIF.
  ENDIF.
  IF CELL_COLOUR IS NOT INITIAL.
    PERFORM SET_CELL_COLOURS TABLES ITAB-CELL_COLOR USING V_COLUMN CELL_COLOUR.
  ENDIF.
  UNASSIGN <FS_VALUE>.
ENDFORM.                    "GENERATE_COLUMN_NAME

