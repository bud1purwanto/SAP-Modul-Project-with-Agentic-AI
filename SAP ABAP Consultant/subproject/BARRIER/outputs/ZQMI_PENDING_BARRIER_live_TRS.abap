*&---------------------------------------------------------------------*
*&      Form  CONVERT_DATE_INPUT

*&---------------------------------------------------------------------*
FORM CONVERT_DATE_INPUT USING I_DATE CHANGING O_DATE.
  DATA: IT_SPLIT TYPE TABLE OF STRING.
  DATA: LV_DATE TYPE STRING,
        LV_PART1 TYPE STRING,
        LV_PART2 TYPE STRING,
        LV_PART3 TYPE STRING,
        LV_LINES TYPE I.

  CLEAR O_DATE.
  LV_DATE = I_DATE.

  " Replace slashes and hyphens with dots
  REPLACE ALL OCCURRENCES OF '/' IN LV_DATE WITH '.'.
  REPLACE ALL OCCURRENCES OF '-' IN LV_DATE WITH '.'.

  IF LV_DATE CS '.'.
    SPLIT LV_DATE AT '.' INTO TABLE IT_SPLIT.
    DESCRIBE TABLE IT_SPLIT LINES LV_LINES.

    IF LV_LINES = 3.
      READ TABLE IT_SPLIT INTO LV_PART1 INDEX 1.
      READ TABLE IT_SPLIT INTO LV_PART2 INDEX 2.
      READ TABLE IT_SPLIT INTO LV_PART3 INDEX 3.

      CONDENSE LV_PART1. CONDENSE LV_PART2. CONDENSE LV_PART3.

      IF STRLEN( LV_PART1 ) = 1. CONCATENATE '0' LV_PART1 INTO LV_PART1. ENDIF.
      IF STRLEN( LV_PART2 ) = 1. CONCATENATE '0' LV_PART2 INTO LV_PART2. ENDIF.
      IF STRLEN( LV_PART3 ) = 1. CONCATENATE '0' LV_PART3 INTO LV_PART3. ENDIF.

      IF STRLEN( LV_PART1 ) = 4.
        " Format: YYYY.MM.DD
        CONCATENATE LV_PART1 LV_PART2 LV_PART3 INTO O_DATE.
      ELSEIF STRLEN( LV_PART3 ) = 4.
        " Format: DD.MM.YYYY
        CONCATENATE LV_PART3 LV_PART2 LV_PART1 INTO O_DATE.
      ELSE.
        O_DATE = I_DATE.
      ENDIF.
    ELSE.
      O_DATE = I_DATE.
    ENDIF.
  ELSE.
    CONDENSE LV_DATE.
    IF STRLEN( LV_DATE ) = 8.
      IF LV_DATE(4) >= '1900' AND LV_DATE(4) <= '2100'.
        O_DATE = LV_DATE.
      ELSE.
        CONCATENATE LV_DATE+4(4) LV_DATE+2(2) LV_DATE(2) INTO O_DATE.
      ENDIF.
    ELSE.
      O_DATE = LV_DATE.
    ENDIF.
  ENDIF.

  CONDENSE O_DATE.
ENDFORM.                    "CONVERT_DATE_INPUT

*&---------------------------------------------------------------------*
*&      Form  CONVERT_DATE_OUTPUT

*&---------------------------------------------------------------------*
FORM CONVERT_DATE_OUTPUT USING I_DATE CHANGING O_DATE.
  DATA: LV_DATE TYPE STRING.
  LV_DATE = I_DATE.
  CONDENSE LV_DATE.
  IF STRLEN( LV_DATE ) = 8 AND LV_DATE CO '0123456789'.
    CONCATENATE LV_DATE+6(2) '.' LV_DATE+4(2) '.' LV_DATE(4) INTO O_DATE.
  ELSE.
    O_DATE = I_DATE.
  ENDIF.
ENDFORM.                    "CONVERT_DATE_OUTPUT

*&---------------------------------------------------------------------*
*&      Form  CANCEL_UD

*&---------------------------------------------------------------------*
FORM CANCEL_UD USING PRUEFLOS CHANGING LS_SUBRC MESS ZSTAT ERR.
  CLEAR: UDSTAT, LS_SUBRC.
  REFRESH : MESSTAB, BDCDATA.
  "Check UD Status
  SELECT SINGLE QALS~STAT35
    INTO UDSTAT
    FROM QALS
   WHERE PRUEFLOS = PRUEFLOS.
  "If Not UD
  IF UDSTAT NE 'X'.
    LS_SUBRC = 0.
    EXIT.
  ENDIF.
  PERFORM BDC_DYNPRO      USING 'SAPMQEVA'          '0100'.
  PERFORM BDC_FIELD       USING 'BDC_CURSOR'        'QALS-PRUEFLOS'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'        '/00'.
  PERFORM BDC_FIELD       USING 'QALS-PRUEFLOS'     PRUEFLOS.
  PERFORM BDC_DYNPRO      USING 'SAPMQEVA'          '0200'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'        '=+FC1'.
  PERFORM BDC_FIELD       USING 'BDC_CURSOR'        'RQEVA-MHD_01'.
  PERFORM BDC_DYNPRO      USING 'SAPLSPO1'          '0500'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'        '=OPT1'.
  PERFORM BDC_DYNPRO      USING 'SAPMQEVA'          '0200'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'        '=BU'.
  PERFORM BDC_FIELD       USING 'BDC_CURSOR'        'RQEVA-MHD_01'.
  PERFORM BDC_DYNPRO      USING 'SAPLSTXX'          '1100'.
  PERFORM BDC_FIELD       USING 'BDC_CURSOR'        'RSTXT-TXLINE(02)'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'        '=TXBA'.
  OPT-DISMODE   = 'N'.
  OPT-UPDMODE   = 'S'.
  OPT-DEFSIZE   = 'X'.
  OPT-RACOMMIT  = 'X'.
  OPT-NOBINPT   = ''.
  CALL TRANSACTION 'QA12' USING BDCDATA OPTIONS FROM OPT MESSAGES INTO MESSTAB.
  READ TABLE MESSTAB WITH KEY MSGTYP = 'E'.
  IF SY-SUBRC = 0.
    SELECT SINGLE TEXT INTO MESS FROM T100 WHERE SPRSL = 'E' AND ARBGB = MESSTAB-MSGID AND MSGNR = MESSTAB-MSGNR.
    REPLACE FIRST OCCURRENCE OF '&' IN MESS WITH MESSTAB-MSGV2.
    REPLACE FIRST OCCURRENCE OF '&' IN MESS WITH MESSTAB-MSGV1.
    CONCATENATE 'Cancel UD:' MESS INTO MESS SEPARATED BY SPACE.
    ZSTAT    = ERROR.
    ERR      = 'X'.
    LS_SUBRC = -1.
  ELSE.
    COMMIT WORK AND WAIT.
    LS_SUBRC = 0.
  ENDIF.
  PERFORM PROCESS_DELAYING.
  IF SY-DYNNR EQ '0100'.
    CLEAR : IT_OUTPUT.
    REFRESH : IT_OUTPUT.
    APPEND LINES OF ITAB TO IT_OUTPUT.
    IF NOT G_GRID IS INITIAL.
      CALL METHOD G_GRID->REFRESH_TABLE_DISPLAY.
    ENDIF.
  ENDIF.
ENDFORM.                    "CANCEL_UD

*&---------------------------------------------------------------------*
*&      Form  PROCESS_DELAYING

*&---------------------------------------------------------------------*
*---------------------------------------------
*  WAIT_UD_CLEARED - tunggu berbasis STATUS.
*  CANCEL_UD pakai QA12 dgn RACOMMIT, jadi
*  update task commit asinkron: QALS-STAT35
*  bisa belum settle saat set UD dipanggil.
*  Race melebar bila MVTR & OTR sekaligus
*  (2x volume result rec). Polling max 20 dtk
*  sampai STAT35 benar2 kosong di DB.
*---------------------------------------------
FORM WAIT_UD_CLEARED USING P_LOT CHANGING P_CLEARED.
  DATA: L_ST TYPE QALS-STAT35.

  CLEAR P_CLEARED.
  DO 30 TIMES.
    CLEAR L_ST.
    SELECT SINGLE STAT35
      INTO L_ST
      FROM QALS BYPASSING BUFFER
      WHERE PRUEFLOS = P_LOT.
    IF SY-SUBRC NE 0 OR L_ST NE 'X'.
      P_CLEARED = 'X'.
      EXIT.
    ENDIF.
    WAIT UP TO 1 SECONDS.
  ENDDO.
ENDFORM.                    "WAIT_UD_CLEARED

*&---------------------------------------------------------------------*
*&      Form  VERIFY_UD_RESTORED
*&---------------------------------------------------------------------*
FORM VERIFY_UD_RESTORED USING P_LOT P_CODEGRP P_CODE
                              P_SELECTED_SET
                        CHANGING P_RESTORED.
  DATA: L_STAT35       TYPE QALS-STAT35,
        L_CODE         TYPE QAVE-VCODE,
        L_CODEGRP      TYPE QAVE-VCODEGRP,
        L_SELECTED_SET TYPE QAVE-VAUSWAHLMG.

  CLEAR P_RESTORED.
  DO 10 TIMES.
    CLEAR: L_STAT35, L_CODE, L_CODEGRP, L_SELECTED_SET.
    SELECT SINGLE QALS~STAT35 QAVE~VCODE QAVE~VCODEGRP
                  QAVE~VAUSWAHLMG
      INTO (L_STAT35, L_CODE, L_CODEGRP, L_SELECTED_SET)
      FROM QALS
      LEFT JOIN QAVE ON QAVE~PRUEFLOS = QALS~PRUEFLOS
      WHERE QALS~PRUEFLOS = P_LOT.
    IF SY-SUBRC EQ 0 AND L_STAT35 EQ 'X'
       AND L_CODE EQ P_CODE
       AND L_CODEGRP EQ P_CODEGRP
       AND ( P_SELECTED_SET IS INITIAL
          OR L_SELECTED_SET EQ P_SELECTED_SET ).
      P_RESTORED = 'X'.
      EXIT.
    ENDIF.
    WAIT UP TO 1 SECONDS.
  ENDDO.
ENDFORM.                    "VERIFY_UD_RESTORED

*&---------------------------------------------------------------------*
*&      Form  PROCESS_DELAYING
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM PROCESS_DELAYING .
  WAIT UP TO 1 SECONDS. "ADD DELAY TIME
ENDFORM.                    "PROCESS_DELAYING

*&---------------------------------------------------------------------*
*&      Form  CHECK_ERROR

*&---------------------------------------------------------------------*
FORM CHECK_ERROR .
  LOOP AT ITAB WHERE BOX = 'X' AND ERR = ''.
    ITAB-MESS = 'Transaction Success'.
    ITAB-ZSTAT  = SUCCES.
    MODIFY ITAB.
    CLEAR ITAB.
  ENDLOOP.
  CLEAR : IT_OUTPUT.
  REFRESH : IT_OUTPUT.
  APPEND LINES OF ITAB TO IT_OUTPUT.
  SORT IT_OUTPUT BY ROLL INSPECTION SORT_KEY ASCENDING.
  IF NOT G_GRID IS INITIAL.
    DATA: LS_STABLE TYPE LVC_S_STBL.
    LS_STABLE-ROW = 'X'.
    LS_STABLE-COL = 'X'.
    CALL METHOD G_GRID->REFRESH_TABLE_DISPLAY
      EXPORTING
        IS_STABLE = LS_STABLE.
    CALL METHOD CL_GUI_CFW=>FLUSH.
  ENDIF.
ENDFORM.                    " CHECK_ERROR

*&---------------------------------------------------------------------*
*&      Form  SET_INDICATOR

*&---------------------------------------------------------------------*
FORM SET_INDICATOR  USING INDEX COUNT_INDEX PROCESS COUNT_PROCESS TEXT.
  DATA: PERCENT TYPE P.
  CLEAR: PERCENT.
  PERCENT =  ( ( INDEX + ( COUNT_INDEX * PROCESS ) - COUNT_INDEX ) / ( COUNT_INDEX * COUNT_PROCESS ) )  * 100.
  CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
    EXPORTING
      PERCENTAGE = PERCENT
      TEXT       = TEXT.
ENDFORM.                    " SET_INDICATOR

*&---------------------------------------------------------------------*
*&      Form  UPLOAD_FILE

*&---------------------------------------------------------------------*
FORM UPLOAD_FILE .
  MOVE FILENAME TO FILENAME1.
  CLEAR : IT_UPLOAD.
  REFRESH : IT_UPLOAD.
  CALL FUNCTION 'GUI_UPLOAD'
    EXPORTING
      FILENAME            = FILENAME1
      FILETYPE            = 'ASC'
      HAS_FIELD_SEPARATOR = 'X'
    TABLES
      DATA_TAB            = IT_UPLOAD
    EXCEPTIONS
      CONVERSION_ERROR    = 1
      INVALID_TABLE_WIDTH = 2
      INVALID_TYPE        = 3
      NO_BATCH            = 4
      UNKNOWN_ERROR       = 5
      FILE_OPEN_ERROR     = 6
      FILE_READ_ERROR     = 7
      OTHERS              = 8.
  IF SY-SUBRC <> 0.
    MESSAGE 'File cannot be opened!' TYPE 'S' DISPLAY LIKE 'E'.
    EXIT.
  ENDIF.
  PERFORM GET_DATA_PREVIEW.
  DATA: LT_ROLL_PARTS TYPE TABLE OF STRING.
  REFRESH : IT_OUTPUT.
  APPEND LINES OF ITAB TO IT_OUTPUT.
  PERFORM DISPLAY_DATA CHANGING IT_OUTPUT GT_FIELDCAT.
  LEAVE TO SCREEN 200.
ENDFORM.                    " UPLOAD_FILE

*&---------------------------------------------------------------------*
*&      Form  RESULT_RECORDING

*&---------------------------------------------------------------------*
FORM RESULT_RECORDING.
  DATA L_TMP_MERKNR TYPE QMERKNR.
  DATA L_INSPSAMPLE2 LIKE BAPI2045D4-INSPSAMPLE.
  DATA L_INSPSAMPLE LIKE BAPI2045D4-INSPSAMPLE.
  "Collect Data Result Recording
  DATA : V_NEXT_TIMES TYPE I.
  DATA : RETURNTABLE_BAPI TYPE TABLE OF BAPIRET2 WITH HEADER LINE.
  DATA : ERROR_MESSAGES TYPE STRING.
  DATA : V_PREV_TIMES TYPE I.
  DATA : V_TMPSTATUS TYPE C LENGTH 2.
  CLEAR: V_ERR.
  SORT ITAB BY ROLL PRUEFLOS INSPECTION TIMES SORT_KEY ASCENDING.

  DESCRIBE TABLE ITAB LINES V_TFILL.

  LOOP AT ITAB WHERE BOX EQ 'X' AND ERR NE 'X' AND PRUEFLOS IS NOT INITIAL.
    CLEAR: V_COLUMN,V_NEXT_TIMES.
    PERFORM SET_INDICATOR USING SY-TABIX V_TFILL 3 V_PROC_EX 'Collecting Sample...'.
    " Pastikan INSP_CHAR terisi dengan benar (sesuaikan dengan logikmu)

    L_TMP_MERKNR = ITAB-MERKNR.
    INSP_CHAR = L_TMP_MERKNR.
    V_MINCYCLE = 1.
    WHILE V_MINCYCLE LE 4.
      CLEAR IT_RECORD.
      CLEAR : V_ERR.
      LV_MINCYCLE_STR = V_MINCYCLE.
      CONDENSE LV_MINCYCLE_STR.
      CONCATENATE 'VALUE' LV_MINCYCLE_STR INTO V_COLUMN.
      "Upload Data
      ASSIGN COMPONENT V_COLUMN OF STRUCTURE ITAB TO <FS_VALUE>.
      IF <FS_VALUE> NE 0 OR <FS_VALUE> IS NOT INITIAL.
        " Pengecekan limit cycle disesuaikan dengan nilai STPRUMF dari master data
        IF V_MINCYCLE > ITAB-CYCLE.
          ITAB-ZSTAT = ERROR.
          ITAB-ERR = 'X'.
          ITAB-MESS = 'Cannot input more than maximum cycles !'.
          MODIFY ITAB.
          V_ERR = 'X'.
          DELETE IT_RECORD WHERE PRUEFLOS = ITAB-PRUEFLOS AND CHAR_NO = INSP_CHAR AND PROBENR = ITAB-TIMES.
          EXIT.
        ELSE.
          IT_RECORD-MEAN_VAL      = <FS_VALUE>.
          IT_RECORD-PRUEFLOS      = ITAB-PRUEFLOS.
          IT_RECORD-CHAR_NO       = INSP_CHAR.
          IT_RECORD-PROBENR       = ITAB-TIMES.
          IT_RECORD-ZZCOUNTER     = V_MINCYCLE.
          IT_RECORD-VALUATION     = 'A'.
          IT_RECORD-INSPECTOR     = V_NIK.
          IT_RECORD-INSPECTION    = ITAB-INSPECTION.
          PERFORM CONVERT_DATE_INPUT USING ITAB-INSPDATE CHANGING IT_RECORD-DATE.
          CONDENSE IT_RECORD-MEAN_VAL.
          READ TABLE IT_COMPARE WITH KEY PRUEFLOS   = IT_RECORD-PRUEFLOS
                                         MERKNR     = IT_RECORD-CHAR_NO
                                         PROBENR    = IT_RECORD-PROBENR
                                         STUECKNR   = IT_RECORD-ZZCOUNTER.
          IF ( SY-SUBRC NE 0 ) OR  ( SY-SUBRC EQ 0 AND IT_RECORD-MEAN_VAL NE IT_COMPARE-MESSWERT ) .
            V_NEXT_TIMES = ITAB-TIMES + 1.
            V_PREV_TIMES = ITAB-TIMES - 1.
            CLEAR : V_TMPSTATUS.
            IF ITAB-INSPECTION CS 'WVTR' OR ITAB-INSPECTION CS 'MVTR'.
              V_TMPSTATUS = ITAB-APRV_STATUS(2).
            ELSEIF ITAB-INSPECTION CS 'OTR' OR ITAB-INSPECTION CS 'O2TR'.
              V_TMPSTATUS = ITAB-APRV_STATUS+2(2).
            ENDIF.
            IF V_TMPSTATUS EQ 'OK'.
              READ TABLE IT_COMPARE INTO WA_TEMP_COMPARE WITH KEY PRUEFLOS = IT_RECORD-PRUEFLOS PROBENR = V_NEXT_TIMES MERKNR = INSP_CHAR.
              IF SY-SUBRC  EQ 0.
                ITAB-ZSTAT = ERROR.
                ITAB-ERR = 'X'.
                ITAB-MESS = 'This record value is already approved !'.
                V_ERR = 'X'.
                MODIFY ITAB.
              ELSE.
                CLEAR : WA_TEMP_RECORD.
                READ TABLE IT_RECORD INTO WA_TEMP_RECORD WITH KEY PRUEFLOS = ITAB-PRUEFLOS CHAR_NO = INSP_CHAR PROBENR = V_PREV_TIMES.
                IF SY-SUBRC EQ 0.
                  ITAB-ZSTAT = ERROR.
                  ITAB-ERR = 'X'.
                  ITAB-MESS = 'Record value failed, previous times is updated !'.
                  V_ERR = 'X'.
                  MODIFY ITAB.
                ENDIF.
              ENDIF.
            ELSEIF V_TMPSTATUS EQ ''.
              CLEAR : WA_TEMP_RECORD.
              READ TABLE IT_RECORD INTO WA_TEMP_RECORD WITH KEY PRUEFLOS = ITAB-PRUEFLOS CHAR_NO = INSP_CHAR PROBENR = V_PREV_TIMES.
              IF SY-SUBRC EQ 0.
                ITAB-ZSTAT = ERROR.
                ITAB-ERR = 'X'.
                ITAB-MESS = 'Record value failed, previous times is updated !'.
                V_ERR = 'X'.
                MODIFY ITAB.
              ENDIF.
            ENDIF.
            IF V_ERR NE 'X'.
              APPEND IT_RECORD.
              CLEAR IT_RECORD.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
      ADD 1 TO V_MINCYCLE.
    ENDWHILE.
    MODIFY ITAB.
  ENDLOOP.
  IF IT_RECORD[] IS INITIAL.
    EXIT.
  ENDIF.
  CLEAR: IT_PRUEFLOS.
  REFRESH: IT_PRUEFLOS.
  IT_PRUEFLOS[]  = IT_RECORD[].
  DELETE ADJACENT DUPLICATES FROM IT_PRUEFLOS COMPARING PRUEFLOS PROBENR.

  " --- CACHE FOR RESULT RECORDING BAPI ---
  TYPES: BEGIN OF TY_JEST_STAT,
           PRUEFLOS TYPE QALS-PRUEFLOS,
           TXT04    TYPE TJ02T-TXT04,
         END OF TY_JEST_STAT.
  DATA: LT_JEST_STAT TYPE TABLE OF TY_JEST_STAT,
        LS_JEST_STAT TYPE TY_JEST_STAT.

  TYPES: BEGIN OF TY_QAPP,
           PRUEFLOS TYPE QAPP-PRUEFLOS,
           PROBENR  TYPE QAPP-PROBENR,
           VCODE    TYPE QAPP-VCODE,
         END OF TY_QAPP.
  DATA: LT_QAPP TYPE TABLE OF TY_QAPP,
        LS_QAPP TYPE TY_QAPP.

  TYPES: BEGIN OF TY_QPMZ_CACHE,
           PRUEFLOS TYPE QALS-PRUEFLOS,
           CHAR_NO  TYPE QAMV-MERKNR,
           WERK     TYPE QALS-WERK,
           AUSWMENGE1 TYPE QPMZ-AUSWMENGE1,
         END OF TY_QPMZ_CACHE.
  DATA: LT_QPMZ_CACHE TYPE TABLE OF TY_QPMZ_CACHE,
        LS_QPMZ_CACHE TYPE TY_QPMZ_CACHE.

  TYPES: BEGIN OF TY_QALS_WERK,
           PRUEFLOS TYPE QALS-PRUEFLOS,
           WERK     TYPE QALS-WERK,
         END OF TY_QALS_WERK.
  DATA: LT_QALS_WERK TYPE TABLE OF TY_QALS_WERK,
        LS_QALS_WERK TYPE TY_QALS_WERK.

  TYPES: BEGIN OF TY_QPMZ_DB,
           PRUEFLOS TYPE QALS-PRUEFLOS,
           MERKNR   TYPE QAMV-MERKNR,
           WERK     TYPE QPMZ-ZAEHLER,
           AUSWMENGE1 TYPE QPMZ-AUSWMENGE1,
         END OF TY_QPMZ_DB.
  DATA: LT_QPMZ_DB TYPE TABLE OF TY_QPMZ_DB,
        LS_QPMZ_DB TYPE TY_QPMZ_DB.

  IF IT_PRUEFLOS[] IS NOT INITIAL.
    SELECT QALS~PRUEFLOS TJ02T~TXT04
      INTO TABLE LT_JEST_STAT
      FROM JEST
      JOIN QALS  ON JEST~OBJNR = QALS~OBJNR
      JOIN TJ02T ON JEST~STAT  = TJ02T~ISTAT
      FOR ALL ENTRIES IN IT_PRUEFLOS
     WHERE QALS~PRUEFLOS = IT_PRUEFLOS-PRUEFLOS
       AND TJ02T~SPRAS = 'E'.
    SORT LT_JEST_STAT BY PRUEFLOS TXT04.

    SELECT PRUEFLOS PROBENR VCODE
      INTO TABLE LT_QAPP
      FROM QAPP
      FOR ALL ENTRIES IN IT_PRUEFLOS
     WHERE PRUEFLOS = IT_PRUEFLOS-PRUEFLOS
       AND PROBENR  = IT_PRUEFLOS-PROBENR.
    SORT LT_QAPP BY PRUEFLOS PROBENR.
  ENDIF.

  IF IT_RECORD[] IS NOT INITIAL.
    SELECT PRUEFLOS WERK INTO TABLE LT_QALS_WERK FROM QALS FOR ALL ENTRIES IN IT_RECORD WHERE PRUEFLOS = IT_RECORD-PRUEFLOS.
    SORT LT_QALS_WERK BY PRUEFLOS.
    FIELD-SYMBOLS: <FS_REC_TMP> LIKE LINE OF IT_RECORD.
    LOOP AT IT_RECORD ASSIGNING <FS_REC_TMP> WHERE MEAN_VAL CA 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.
      LS_QPMZ_CACHE-PRUEFLOS = <FS_REC_TMP>-PRUEFLOS.
      LS_QPMZ_CACHE-CHAR_NO  = <FS_REC_TMP>-CHAR_NO.
      READ TABLE LT_QALS_WERK INTO LS_QALS_WERK WITH KEY PRUEFLOS = <FS_REC_TMP>-PRUEFLOS BINARY SEARCH.
      IF SY-SUBRC = 0.
        LS_QPMZ_CACHE-WERK = LS_QALS_WERK-WERK.
      ENDIF.
      APPEND LS_QPMZ_CACHE TO LT_QPMZ_CACHE.
    ENDLOOP.
    SORT LT_QPMZ_CACHE BY PRUEFLOS CHAR_NO WERK.
    DELETE ADJACENT DUPLICATES FROM LT_QPMZ_CACHE COMPARING PRUEFLOS CHAR_NO WERK.

    IF LT_QPMZ_CACHE[] IS NOT INITIAL.
      SELECT QAMV~PRUEFLOS QAMV~MERKNR QPMZ~ZAEHLER AS WERK QPMZ~AUSWMENGE1
        INTO TABLE LT_QPMZ_DB
        FROM QPMZ
        JOIN QAMV ON QPMZ~MKMNR = QAMV~VERWMERKM
        FOR ALL ENTRIES IN LT_QPMZ_CACHE
        WHERE QAMV~PRUEFLOS = LT_QPMZ_CACHE-PRUEFLOS
          AND QAMV~MERKNR   = LT_QPMZ_CACHE-CHAR_NO
          AND QPMZ~ZAEHLER  = LT_QPMZ_CACHE-WERK.
      SORT LT_QPMZ_DB BY PRUEFLOS MERKNR WERK.

      FIELD-SYMBOLS: <FS_QPMZ> LIKE LINE OF LT_QPMZ_CACHE.
      LOOP AT LT_QPMZ_CACHE ASSIGNING <FS_QPMZ>.
        READ TABLE LT_QPMZ_DB INTO LS_QPMZ_DB WITH KEY PRUEFLOS = <FS_QPMZ>-PRUEFLOS MERKNR = <FS_QPMZ>-CHAR_NO WERK = <FS_QPMZ>-WERK BINARY SEARCH.
        IF SY-SUBRC = 0.
          <FS_QPMZ>-AUSWMENGE1 = LS_QPMZ_DB-AUSWMENGE1.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDIF.
  " ------------------------------------------

  DESCRIBE TABLE IT_PRUEFLOS LINES V_TFILL.

  LOOP AT IT_PRUEFLOS.
    CLEAR : V_CANCELLED, V_NCANCELLED.
    LOOP AT LT_JEST_STAT INTO LS_JEST_STAT WHERE PRUEFLOS = IT_PRUEFLOS-PRUEFLOS.
      IF LS_JEST_STAT-TXT04 = 'LKD' OR LS_JEST_STAT-TXT04 = 'MCAN' OR LS_JEST_STAT-TXT04 = 'LTCA' OR
         LS_JEST_STAT-TXT04 = 'LOLK' OR LS_JEST_STAT-TXT04 = 'ARBL' OR LS_JEST_STAT-TXT04 = 'ARCH' OR
         LS_JEST_STAT-TXT04 = 'RE01' OR LS_JEST_STAT-TXT04 = 'RE02' OR LS_JEST_STAT-TXT04 = 'RE03' OR
         LS_JEST_STAT-TXT04 = 'CANC'.
        ADD 1 TO V_CANCELLED.
      ELSE.
        ADD 1 TO V_NCANCELLED.
      ENDIF.
    ENDLOOP.

    "Inspection Lot Status Cancel
    IF  V_CANCELLED = V_NCANCELLED.
      ITAB-MESS  = 'RR: Upload Failed, Inspection Lot on cancel status.'.
      ITAB-ZSTAT = ERROR.
      ITAB-ERR   = 'X'.
      MODIFY ITAB TRANSPORTING MESS ZSTAT ERR WHERE PRUEFLOS EQ IT_PRUEFLOS-PRUEFLOS AND TIMES EQ IT_PRUEFLOS-PROBENR AND INSPECTION EQ IT_PRUEFLOS-INSPECTION.
      CONTINUE.
    ENDIF.
    PERFORM SET_INDICATOR USING SY-TABIX V_TFILL 4 V_PROC_EX 'Uploading Sample...'.
    "Cancel UD, Must be Canceled
    PERFORM CANCEL_UD USING IT_PRUEFLOS-PRUEFLOS CHANGING LS_SUBRC ITAB-MESS ITAB-ZSTAT ITAB-ERR.
    IF LS_SUBRC NE 0.
      MODIFY ITAB TRANSPORTING MESS ZSTAT ERR WHERE PRUEFLOS EQ IT_PRUEFLOS-PRUEFLOS AND INSPECTION EQ IT_PRUEFLOS-INSPECTION.
      CONTINUE.
    ENDIF.
    REFRESH: CHAR_RESULTS, SINGLE_RESULTS, CHAR_REQUIREMENTS, INSPPOINTS, SAMPLE_RESULTS.
    CLEAR: CHAR_RESULTS, SINGLE_RESULTS, CHAR_REQUIREMENTS, INSPPOINTS, SAMPLE_RESULTS, INSPLOT, INSPOINT, V_UD, V_NEW_POINT, WA_INSPPOINTDATA.
    INSPLOT   = IT_PRUEFLOS-PRUEFLOS.
    INSPOINT  = IT_PRUEFLOS-PROBENR.
    "Check Inspection Point
    READ TABLE LT_QAPP INTO LS_QAPP WITH KEY PRUEFLOS = INSPLOT PROBENR = INSPOINT BINARY SEARCH.
    IF SY-SUBRC = 0.
      V_INSPOINT = LS_QAPP-PROBENR.
      V_UD = LS_QAPP-VCODE.
    ELSE.
      INSPPOINTS-INSPLOT    = INSPLOT.
      INSPPOINTS-INSPOPER   = INSPOPER.
      INSPPOINTS-INSPPOINT  = INSPOINT.
      INSPPOINTS-USERC1     = INSPOINT.
      INSPPOINTS-USERC2     = INSPOINT.
      INSPPOINTS-USERN1     = INSPOINT.
      INSPPOINTS-USERN2     = INSPOINT.
      INSPPOINTS-INSPECTOR  = V_NIK.
      INSPPOINTS-PSEL_SET   = ITAB-WERKS.
      INSPPOINTS-SEL_SET    = V_SELECTED.
      INSPPOINTS-CODE_GRP   = V_SELECTED.
      LV_NO_STR = V_NO.
      CONDENSE LV_NO_STR.
      CONCATENATE LV_NO_STR LV_NO_STR INTO INSPPOINTS-CODE.
      APPEND INSPPOINTS.

      "Create Inspection Point
      CLEAR BAPIRETURN1.
      CALL FUNCTION 'BAPI_INSPPOINT_CREATEFROMDATA'
        EXPORTING
          DATA      = INSPPOINTS
        IMPORTING
          INSPLOT   = INSPLOT
          INSPOPER  = INSPOPER
          INSPPOINT = INSPOINT
          RETURN    = BAPIRETURN1.

      APPEND BAPIRETURN1.
      READ TABLE  BAPIRETURN1 WITH KEY TYPE = 'E'.
      IF SY-SUBRC EQ 0 AND ( BAPIRETURN1-ID <> 'Q5' OR BAPIRETURN1-NUMBER <> '013' ).
        CONCATENATE 'Point:' BAPIRETURN1-MESSAGE INTO ITAB-MESS SEPARATED BY SPACE.
        ITAB-ZSTAT = ERROR.
        ITAB-ERR   = 'X'.
        MODIFY ITAB TRANSPORTING MESS ZSTAT ERR WHERE PRUEFLOS EQ IT_PRUEFLOS-PRUEFLOS AND TIMES EQ IT_PRUEFLOS-PROBENR AND INSPECTION EQ IT_PRUEFLOS-INSPECTION.
        CONTINUE.
      ELSE.
        INSPLOT  = IT_PRUEFLOS-PRUEFLOS.
        INSPOINT = IT_PRUEFLOS-PROBENR.
        INSPOPER = '0010'.
        PERFORM BAPI_COMMIT.

        V_NEW_POINT = 'X'.
      ENDIF.
    ENDIF.

    CALL FUNCTION 'BAPI_INSPOPER_GETDETAIL'
      EXPORTING
        INSPLOT                = INSPLOT
        INSPOPER               = INSPOPER
        READ_CHAR_REQUIREMENTS = 'X'
        READ_CHAR_RESULTS      = 'X'
        READ_SINGLE_RESULTS    = 'X'
        READ_INSPPOINTS        = 'X'
        READ_SAMPLE_RESULTS    = 'X'
        INSPPOINT_FROM         = INSPOINT
        MAX_INSPPOINTS         = 1
      TABLES
        CHAR_REQUIREMENTS      = CHAR_REQUIREMENTS
        CHAR_RESULTS           = CHAR_RESULTS
        SINGLE_RESULTS         = SINGLE_RESULTS
        SAMPLE_RESULTS         = SAMPLE_RESULTS
        INSPPOINTS             = INSPPOINTS.
    IF 1 = 1. "Always process (BAPI_INSPOPER_GETDETAIL always SY-SUBRC=0)
      LOOP AT IT_RECORD ASSIGNING <FS_RECORD> WHERE PRUEFLOS = IT_PRUEFLOS-PRUEFLOS AND PROBENR = INSPOINT.
        READ TABLE CHAR_REQUIREMENTS WITH KEY INSPCHAR = <FS_RECORD>-CHAR_NO.
        IF SY-SUBRC = 0 AND CHAR_REQUIREMENTS-SINGLE_RES = 'X'.


          L_INSPSAMPLE2 = <FS_RECORD>-PROBENR.
          READ TABLE SAMPLE_RESULTS ASSIGNING <FS_SAMPLE> WITH KEY INSPLOT = INSPLOT
                                                                   INSPCHAR = <FS_RECORD>-CHAR_NO
                                                                   INSPOPER = INSPOPER
                                                                   INSPSAMPLE = L_INSPSAMPLE2.
          IF SY-SUBRC <> 0.
            L_INSPSAMPLE2 = '000000'.
            READ TABLE SAMPLE_RESULTS ASSIGNING <FS_SAMPLE> WITH KEY INSPLOT = INSPLOT
                                                                     INSPCHAR = <FS_RECORD>-CHAR_NO
                                                                     INSPOPER = INSPOPER
                                                                     INSPSAMPLE = L_INSPSAMPLE2.
          ENDIF.
          IF SY-SUBRC = 0.
            <FS_SAMPLE>-CLOSED      = 'X'.
            <FS_SAMPLE>-EVALUATED   = 'E'.
            <FS_SAMPLE>-EVALUATION  = 'A'.
          ENDIF.

          " 1. CEK APAKAH SINGLE RESULT SUDAH ADA. JIKA BELUM, BUAT BARIS BARU (APPEND)

          L_INSPSAMPLE = <FS_RECORD>-PROBENR.

          READ TABLE SINGLE_RESULTS ASSIGNING <FS_SINGLE> WITH KEY INSPLOT = INSPLOT
                                                                   INSPCHAR = <FS_RECORD>-CHAR_NO
                                                                   INSPOPER = INSPOPER
                                                                   INSPSAMPLE = L_INSPSAMPLE
                                                                   RES_NO = <FS_RECORD>-ZZCOUNTER.
          IF SY-SUBRC <> 0.
            L_INSPSAMPLE = '000000'.
            READ TABLE SINGLE_RESULTS ASSIGNING <FS_SINGLE> WITH KEY INSPLOT = INSPLOT
                                                                     INSPCHAR = <FS_RECORD>-CHAR_NO
                                                                     INSPOPER = INSPOPER
                                                                     INSPSAMPLE = L_INSPSAMPLE
                                                                     RES_NO = <FS_RECORD>-ZZCOUNTER.
          ENDIF.

          IF SY-SUBRC <> 0.
            APPEND INITIAL LINE TO SINGLE_RESULTS ASSIGNING <FS_SINGLE>.
            <FS_SINGLE>-INSPLOT    = INSPLOT.
            <FS_SINGLE>-INSPCHAR   = <FS_RECORD>-CHAR_NO.
            <FS_SINGLE>-INSPOPER   = INSPOPER.
            <FS_SINGLE>-INSPSAMPLE = L_INSPSAMPLE.
            <FS_SINGLE>-RES_NO     = <FS_RECORD>-ZZCOUNTER.
          ENDIF.
          " 2. ISI VALUE KE SINGLE RESULT
          IF <FS_RECORD>-MEAN_VAL CA 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.
            CLEAR: V_CODEGRUPPE, V_WERK.
            READ TABLE LT_QALS_WERK INTO LS_QALS_WERK WITH KEY PRUEFLOS = INSPLOT BINARY SEARCH.
            IF SY-SUBRC = 0.
              V_WERK = LS_QALS_WERK-WERK.
              READ TABLE LT_QPMZ_CACHE INTO LS_QPMZ_CACHE WITH KEY PRUEFLOS = INSPLOT CHAR_NO = <FS_RECORD>-CHAR_NO WERK = V_WERK BINARY SEARCH.
              IF SY-SUBRC = 0.
                V_CODEGRUPPE = LS_QPMZ_CACHE-AUSWMENGE1.
              ENDIF.
            ENDIF.
            <FS_SINGLE>-CODE_GRP1   = V_CODEGRUPPE.
            <FS_SINGLE>-CODE1       = <FS_RECORD>-MEAN_VAL.
          ELSE.
            <FS_SINGLE>-RES_VALUE   = <FS_RECORD>-MEAN_VAL.
          ENDIF.
          <FS_SINGLE>-INSPECTOR     = <FS_RECORD>-INSPECTOR.
          <FS_SINGLE>-INSP_DATE     = <FS_RECORD>-DATE.
          <FS_SINGLE>-INSP_TIME     = SY-UZEIT.
        ELSE.
          " 2. SUMMARIZED RESULT CHARACTERISTIC
          READ TABLE CHAR_RESULTS ASSIGNING <FS_CHAR> WITH KEY INSPLOT = INSPLOT
                                                               INSPCHAR = <FS_RECORD>-CHAR_NO
                                                               INSPOPER = INSPOPER.
          IF SY-SUBRC = 0.
            IF <FS_RECORD>-MEAN_VAL CA 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.
              CLEAR: V_CODEGRUPPE, V_WERK.
              READ TABLE LT_QALS_WERK INTO LS_QALS_WERK WITH KEY PRUEFLOS = INSPLOT BINARY SEARCH.
              IF SY-SUBRC = 0.
                V_WERK = LS_QALS_WERK-WERK.
                READ TABLE LT_QPMZ_CACHE INTO LS_QPMZ_CACHE WITH KEY PRUEFLOS = INSPLOT CHAR_NO = <FS_RECORD>-CHAR_NO WERK = V_WERK BINARY SEARCH.
                IF SY-SUBRC = 0.
                  V_CODEGRUPPE = LS_QPMZ_CACHE-AUSWMENGE1.
                ENDIF.
              ENDIF.
              <FS_CHAR>-CODE_GRP1 = V_CODEGRUPPE.
              <FS_CHAR>-CODE1     = <FS_RECORD>-MEAN_VAL.
            ELSE.
              <FS_CHAR>-MEAN_VALUE = <FS_RECORD>-MEAN_VAL.
              <FS_CHAR>-ORIGINAL_INPUT = <FS_RECORD>-MEAN_VAL.
            ENDIF.
            <FS_CHAR>-INSPECTOR     = <FS_RECORD>-INSPECTOR.
            <FS_CHAR>-START_DATE    = <FS_RECORD>-DATE.
            <FS_CHAR>-START_TIME    = SY-UZEIT.
          ENDIF.
        ENDIF.
        " 3. UPDATE JUGA CHAR_RESULTS AGAR MIC TERTUTUP (CLOSED) (UNTUK KEDUANYA)
        READ TABLE CHAR_RESULTS ASSIGNING <FS_CHAR> WITH KEY INSPLOT   = INSPLOT
                                                             INSPCHAR  = <FS_RECORD>-CHAR_NO
                                                             INSPOPER  = INSPOPER.
        IF SY-SUBRC = 0.
          <FS_CHAR>-EVALUATION    = <FS_RECORD>-VALUATION.
          <FS_CHAR>-CLOSED        = 'X'.
          <FS_CHAR>-EVALUATED     = 'X'.
        ENDIF.
        "------------------------------------------
      ENDLOOP.
      " Hapus Single Result yang kosong (Mencegah error BAPI)
      DELETE SINGLE_RESULTS WHERE ( RES_VALUE = '' AND CODE1 = '' ) AND RES_ATTR IS INITIAL.
      REFRESH: BAPIRET2.
      CLEAR: BAPIRET2.
      READ TABLE INSPPOINTS INDEX 1.
      IF SY-SUBRC = 0.
        WA_INSPPOINTDATA = INSPPOINTS.

      ELSE.
        WA_INSPPOINTDATA-INSPLOT    = INSPLOT.
        WA_INSPPOINTDATA-INSPOPER   = INSPOPER.
        WA_INSPPOINTDATA-INSPPOINT  = INSPOINT.
        WA_INSPPOINTDATA-USERC1     = INSPOINT.
        WA_INSPPOINTDATA-USERC2     = INSPOINT.
        WA_INSPPOINTDATA-USERN1     = INSPOINT.
        WA_INSPPOINTDATA-USERN2     = INSPOINT.
        WA_INSPPOINTDATA-INSPECTOR  = V_NIK.
        WA_INSPPOINTDATA-PSEL_SET   = ITAB-WERKS.
        WA_INSPPOINTDATA-SEL_SET    = V_SELECTED.
        WA_INSPPOINTDATA-CODE_GRP   = V_SELECTED.
        LV_NO_STR = V_NO.
        CONDENSE LV_NO_STR.
        CONCATENATE LV_NO_STR LV_NO_STR INTO WA_INSPPOINTDATA-CODE.
      ENDIF.

      CLEAR RETURNTABLE_BAPI[].
      CALL FUNCTION 'BAPI_INSPOPER_RECORDRESULTS'
        EXPORTING
          INSPLOT        = INSPLOT
          INSPOPER       = INSPOPER
          INSPPOINTDATA  = WA_INSPPOINTDATA
        IMPORTING
          RETURN         = BAPIRET2
        TABLES
          CHAR_RESULTS   = CHAR_RESULTS
          SAMPLE_RESULTS = SAMPLE_RESULTS
          SINGLE_RESULTS = SINGLE_RESULTS
          RETURNTABLE    = RETURNTABLE_BAPI.

      CLEAR ERROR_MESSAGES.
      LOOP AT RETURNTABLE_BAPI WHERE TYPE = 'E' OR TYPE = 'A'.
        " Ignore generic Q5 026 if it's the ONLY error, but usually there's another.
        " We will log everything to be sure.
        IF RETURNTABLE_BAPI-ID = 'Q5' AND RETURNTABLE_BAPI-NUMBER = '026'.
          CONTINUE.
        ENDIF.
        CONCATENATE ERROR_MESSAGES '|' RETURNTABLE_BAPI-MESSAGE INTO ERROR_MESSAGES.
      ENDLOOP.

      IF ERROR_MESSAGES IS NOT INITIAL.
        " We have real errors!
        CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
        CONCATENATE 'RR:' ERROR_MESSAGES INTO ITAB-MESS SEPARATED BY SPACE.
        ITAB-ZSTAT = ERROR.
        ITAB-ERR   = 'X'.
        MODIFY ITAB TRANSPORTING MESS ZSTAT ERR WHERE PRUEFLOS EQ IT_PRUEFLOS-PRUEFLOS AND TIMES EQ IT_PRUEFLOS-PROBENR AND INSPECTION EQ IT_PRUEFLOS-INSPECTION.
      ELSE.
        " Check BAPIRET2 as fallback
        IF BAPIRET2-TYPE = 'E' AND NOT ( BAPIRET2-ID = 'Q5' AND BAPIRET2-NUMBER = '026' ).
          CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
          CONCATENATE 'RR(RET):' BAPIRET2-MESSAGE INTO ITAB-MESS SEPARATED BY SPACE.
          ITAB-ZSTAT = ERROR.
          ITAB-ERR   = 'X'.
          MODIFY ITAB TRANSPORTING MESS ZSTAT ERR WHERE PRUEFLOS EQ IT_PRUEFLOS-PRUEFLOS AND TIMES EQ IT_PRUEFLOS-PROBENR AND INSPECTION EQ IT_PRUEFLOS-INSPECTION.
        ELSE.
          CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
            EXPORTING
              WAIT = 'X'.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDLOOP.
  WAIT UP TO 1 SECONDS.
ENDFORM.                    "RESULT_RECORDING

*&---------------------------------------------------------------------*
*&      Form  USAGE_DECISION

*&---------------------------------------------------------------------*
FORM USAGE_DECISION.
  CLEAR: IT_INSPECTION.
  REFRESH: IT_INSPECTION.
  IT_INSPECTION[]  = ITAB[].
  " --- NEW: Hapus yang ERROR atau TIDAK DICENTANG ---
* FIX 07/08/26: lot ber-UD yg sudah di-cancel
* tapi ERR=X JANGAN dibuang; HAS_UD=X wajib
* tetap di-re-UD agar tidak nyangkut.
  DELETE IT_INSPECTION
    WHERE ( ERR EQ 'X' AND HAS_UD NE 'X' )
       OR BOX EQ ''
       OR PRUEFLOS IS INITIAL.
  " ----------------------------------------------------------------------------
  SORT IT_INSPECTION BY PRUEFLOS.
  DELETE ADJACENT DUPLICATES FROM IT_INSPECTION COMPARING PRUEFLOS.
  DATA: V_TIMES_WVTR LIKE QASE-PROBENR,
        V_TIMES_OTR  LIKE QASE-PROBENR.

  DESCRIBE TABLE IT_INSPECTION LINES V_TFILL.

  LOOP AT IT_INSPECTION.
    PERFORM SET_INDICATOR USING SY-TABIX V_TFILL 5 V_PROC_EX 'Usage Decision...'.

    " --- NEW: Skip UD logic if lot didn't have one previously ---
    IF IT_INSPECTION-HAS_UD NE 'X'.
      CONTINUE.
    ENDIF.

    REFRESH: IT_UD[], BAPIRETURN1[].
    CLEAR: IT_UD[], BAPIRETURN1[].
    "Create Data for UD
    IT_UD-INSPLOT             = IT_INSPECTION-PRUEFLOS.
    IT_UD-UD_PLANT            = IT_INSPECTION-WERKS.
    IF IT_UD-UD_PLANT IS INITIAL.
      IT_UD-UD_PLANT = IT_INSPECTION-WERK.
    ENDIF.
    IF IT_UD-UD_PLANT IS INITIAL.
      SELECT SINGLE WERK INTO IT_UD-UD_PLANT FROM QALS WHERE PRUEFLOS = IT_INSPECTION-PRUEFLOS.
    ENDIF.
    IF IT_INSPECTION-OLD_SELECTED_SET IS NOT INITIAL.
      IT_UD-UD_SELECTED_SET = IT_INSPECTION-OLD_SELECTED_SET.
    ELSE.
      IT_UD-UD_SELECTED_SET = IT_INSPECTION-OLD_CODEGRP.
    ENDIF.
    IT_UD-UD_CODE_GROUP       = IT_INSPECTION-OLD_CODEGRP.
    IT_UD-UD_CODE             = IT_INSPECTION-OLD_UD.
    IT_UD-UD_RECORDED_BY_USER = SY-UNAME.
    IT_UD-UD_RECORDED_ON_DATE = SY-DATUM.
    IT_UD-UD_RECORDED_AT_TIME = SY-UZEIT.
    IT_UD-UD_TEXT_LINE        = ''.
    IT_UD-UD_FORCE_COMPLETION = 'X'.
    IT_UD-UD_STOCK_POSTING    = 'X'.
    APPEND IT_UD.
    "Record Data on Table
    CLEAR: BAPIRETURN1.
*  FIX RACE: pastikan cancel UD efektif di DB
*  sebelum set UD ulang (cegah gagal acak).
* FIX RACE + RETRY (06/08/26): cancel UD harus
* efektif dulu, lalu set UD dgn retry maks 3x.
* Cegah stranding lot saat MVTR & OTR diproses
* bersamaan (race melebar 2x volume result rec).
    DATA: LV_UD_OK       TYPE C,
          LV_UD_CLEARED  TYPE C,
          LV_UD_RESTORED TYPE C,
          LS_UD_RETURN   TYPE BAPIRETURN1.

    CLEAR: LV_UD_OK, LV_UD_CLEARED, LV_UD_RESTORED,
           LS_UD_RETURN.

    " Jika UD lama masih aktif, tidak perlu cancel/set ulang.
    PERFORM VERIFY_UD_RESTORED
      USING IT_UD-INSPLOT IT_INSPECTION-OLD_CODEGRP
            IT_INSPECTION-OLD_UD
            IT_INSPECTION-OLD_SELECTED_SET
      CHANGING LV_UD_RESTORED.
    IF LV_UD_RESTORED EQ 'X'.
      LV_UD_OK = 'X'.
    ELSE.
      DO 3 TIMES.
        CLEAR: BAPIRETURN1, LV_UD_CLEARED, LV_UD_RESTORED.
        PERFORM WAIT_UD_CLEARED
          USING IT_UD-INSPLOT
          CHANGING LV_UD_CLEARED.
        IF LV_UD_CLEARED NE 'X'.
          LS_UD_RETURN-TYPE = 'E'.
          LS_UD_RETURN-MESSAGE =
            'Cancel UD belum selesai; restore UD dihentikan'.
          EXIT.
        ENDIF.

        CALL FUNCTION 'BAPI_INSPLOT_SETUSAGEDECISION'
          EXPORTING
            NUMBER  = IT_UD-INSPLOT
            UD_DATA = IT_UD
          IMPORTING
            RETURN  = BAPIRETURN1.

        IF BAPIRETURN1-TYPE CA 'EA'.
          LS_UD_RETURN = BAPIRETURN1.
          CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
          WAIT UP TO 2 SECONDS.
        ELSE.
          PERFORM BAPI_COMMIT.
          PERFORM VERIFY_UD_RESTORED
            USING IT_UD-INSPLOT IT_INSPECTION-OLD_CODEGRP
                  IT_INSPECTION-OLD_UD
                  IT_INSPECTION-OLD_SELECTED_SET
            CHANGING LV_UD_RESTORED.
          IF LV_UD_RESTORED EQ 'X'.
            LV_UD_OK = 'X'.
            EXIT.
          ENDIF.
          LS_UD_RETURN-TYPE = 'E'.
          LS_UD_RETURN-MESSAGE =
            'BAPI selesai tetapi status UD belum kembali'.
          WAIT UP TO 2 SECONDS.
        ENDIF.
      ENDDO.
    ENDIF.

    REFRESH BAPIRETURN1[].
    IF LV_UD_OK NE 'X'.
      BAPIRETURN1 = LS_UD_RETURN.
      APPEND BAPIRETURN1.
      CONCATENATE 'UD gagal dipulihkan:'
        LS_UD_RETURN-MESSAGE INTO ITAB-MESS
        SEPARATED BY SPACE.
      ITAB-ZSTAT = ERROR.
      ITAB-ERR   = 'X'.
    ENDIF.
*   FIX: bila UD gagal, error menempel ke SEMUA
*   baris lot ini (MVTR & OTR sekaligus), bukan
*   hanya baris yg lolos dedup PRUEFLOS di atas.
    READ TABLE BAPIRETURN1 WITH KEY TYPE = 'E'.
    IF SY-SUBRC EQ 0.
      MODIFY ITAB TRANSPORTING MESS ZSTAT ERR
        WHERE PRUEFLOS EQ IT_INSPECTION-PRUEFLOS.
    ELSE.
      MODIFY ITAB TRANSPORTING MESS ZSTAT ERR
        WHERE PRUEFLOS EQ IT_INSPECTION-PRUEFLOS
        AND INSPECTION = IT_INSPECTION-INSPECTION
        AND POSISI = IT_INSPECTION-POSISI
        AND TIMES = IT_INSPECTION-TIMES.
    ENDIF.
  ENDLOOP.
ENDFORM.                    "USAGE_DECISION

*&---------------------------------------------------------------------*
*&      Form  REFRESH

*&---------------------------------------------------------------------*
FORM REFRESH .
  FIELD-SYMBOLS: <FS_OUTPUT> LIKE LINE OF ITAB.
  CLEAR : IT_INSP_DAT, WA_INSP_DAT,IT_COMPARE.
  REFRESH : IT_INSP_DAT,IT_COMPARE.
  LOOP AT IT_BATCHSR_SAMPLE.
    PERFORM GET_INSPECTION USING IT_BATCHSR_SAMPLE-CHARGSR IT_BATCHSR_SAMPLE-MATNRSR IT_BATCHSR_SAMPLE-CHARGJR 'X'.
  ENDLOOP.
  LOOP AT IT_INSP_DAT INTO WA_INSP_DAT.
    READ TABLE ITAB ASSIGNING <FS_OUTPUT> WITH KEY PRUEFLOS = WA_INSP_DAT-INSPLOT TIMES = WA_INSP_DAT-TIMES INSPECTION = WA_INSP_DAT-INSPTEXT .
    IF SY-SUBRC EQ 0.
      <FS_OUTPUT>-APRV_STATUS = WA_INSP_DAT-STATUS.
      IF <FS_OUTPUT>-INSPECTION CS 'WVTR' OR <FS_OUTPUT>-INSPECTION CS 'MVTR'.
        <FS_OUTPUT>-APRV_STATUS2 = WA_INSP_DAT-STATUS(2).
      ELSEIF <FS_OUTPUT>-INSPECTION CS 'OTR' OR <FS_OUTPUT>-INSPECTION CS 'O2TR'.
        <FS_OUTPUT>-APRV_STATUS2 = WA_INSP_DAT-STATUS+2(2).
      ENDIF.
      CASE <FS_OUTPUT>-APRV_STATUS2.
        WHEN 'NG'.
          <FS_OUTPUT>-APRV_STATUS2 = 'REJECTED'.
        WHEN 'OK'.
          <FS_OUTPUT>-APRV_STATUS2 = 'APPROVED'.
        WHEN 'NO'.
          <FS_OUTPUT>-APRV_STATUS2 = 'CREATED'.
      ENDCASE.
    ENDIF.
    SELECT QASE~PRUEFLOS MERKNR PROBENR STUECKNR MESSWERT MBEWERTG PRUEFDATUV AS BUDAT ATTRIBUT
     APPENDING CORRESPONDING FIELDS OF TABLE IT_COMPARE
     FROM QASE
     JOIN QALS ON QALS~PRUEFLOS = QASE~PRUEFLOS
    WHERE QASE~PRUEFLOS EQ WA_INSP_DAT-INSPLOT.
  ENDLOOP.
  " Filter out invalidated records (ATTRIBUT = '/')
  DATA: LV_INVALID_REF TYPE FLAG,
        WA_TAB_REF     LIKE LINE OF ITAB,
        WA_COMP_REF    LIKE LINE OF IT_COMPARE.
  LOOP AT ITAB INTO WA_TAB_REF.
    LV_INVALID_REF = ''.
    LOOP AT IT_COMPARE INTO WA_COMP_REF WHERE PRUEFLOS = WA_TAB_REF-PRUEFLOS
                                          AND ( MERKNR = WA_TAB_REF-WVTR_CHAR OR MERKNR = WA_TAB_REF-OTR_CHAR ).
      IF WA_COMP_REF-ATTRIBUT EQ '/'.
        LV_INVALID_REF = 'X'.
        EXIT.
      ENDIF.
    ENDLOOP.
    IF LV_INVALID_REF EQ 'X'.
      DELETE ITAB.
    ENDIF.
  ENDLOOP.

  LOOP AT ITAB ASSIGNING <FS_OUTPUT> WHERE BOX EQ 'X'.
    DATA: LV_MIC TYPE QPMK-MKMNR, LV_VER TYPE QPMK-VERSION, LV_WERK TYPE QPMK-ZAEHLER.

    IF <FS_OUTPUT>-WVTR_MIC IS INITIAL AND ( <FS_OUTPUT>-INSPECTION CS 'WVTR' OR <FS_OUTPUT>-INSPECTION CS 'MVTR' ).
      <FS_OUTPUT>-WVTR_MIC = <FS_OUTPUT>-VERWMERKM.
      <FS_OUTPUT>-WVTR_VERSION = <FS_OUTPUT>-MKVERSION.
    ELSEIF <FS_OUTPUT>-OTR_MIC IS INITIAL AND ( <FS_OUTPUT>-INSPECTION CS 'OTR' OR <FS_OUTPUT>-INSPECTION CS 'O2TR' ).
      <FS_OUTPUT>-OTR_MIC = <FS_OUTPUT>-VERWMERKM.
      <FS_OUTPUT>-OTR_VERSION = <FS_OUTPUT>-MKVERSION.
    ENDIF.

    IF <FS_OUTPUT>-INSPECTION CS 'WVTR' OR <FS_OUTPUT>-INSPECTION CS 'MVTR'.
      READ TABLE IT_MAP_INSP_CHAR WITH KEY MATNR = <FS_OUTPUT>-MATNR VERWMERKM = <FS_OUTPUT>-WVTR_MIC INTO WA_MAP_INSP_CHAR.
      IF SY-SUBRC NE 0.
        LV_MIC = <FS_OUTPUT>-WVTR_MIC. LV_VER = <FS_OUTPUT>-WVTR_VERSION. LV_WERK = <FS_OUTPUT>-WERKS.
        IF LV_MIC IS INITIAL. LV_MIC = <FS_OUTPUT>-VERWMERKM. ENDIF.
        IF LV_VER IS INITIAL. LV_VER = <FS_OUTPUT>-MKVERSION. ENDIF.
        IF LV_WERK IS INITIAL. LV_WERK = <FS_OUTPUT>-WERK. ENDIF.
        SELECT SINGLE TOLERANZUN TOLERANZOB INTO (WA_MAP_INSP_CHAR-TOLERANZUN, WA_MAP_INSP_CHAR-TOLERANZOB)
          FROM QPMK
         WHERE ZAEHLER = LV_WERK
           AND MKMNR   = LV_MIC
           AND VERSION = LV_VER.
      ENDIF.
    ELSEIF <FS_OUTPUT>-INSPECTION CS 'OTR' OR <FS_OUTPUT>-INSPECTION CS 'O2TR'.
      READ TABLE IT_MAP_INSP_CHAR WITH KEY MATNR = <FS_OUTPUT>-MATNR VERWMERKM = <FS_OUTPUT>-OTR_MIC INTO WA_MAP_INSP_CHAR.
      IF SY-SUBRC NE 0.
        LV_MIC = <FS_OUTPUT>-OTR_MIC. LV_VER = <FS_OUTPUT>-OTR_VERSION. LV_WERK = <FS_OUTPUT>-WERKS.
        IF LV_MIC IS INITIAL. LV_MIC = <FS_OUTPUT>-VERWMERKM. ENDIF.
        IF LV_VER IS INITIAL. LV_VER = <FS_OUTPUT>-MKVERSION. ENDIF.
        IF LV_WERK IS INITIAL. LV_WERK = <FS_OUTPUT>-WERK. ENDIF.
        SELECT SINGLE TOLERANZUN TOLERANZOB INTO (WA_MAP_INSP_CHAR-TOLERANZUN, WA_MAP_INSP_CHAR-TOLERANZOB)
          FROM QPMK
         WHERE ZAEHLER = LV_WERK
           AND MKMNR   = LV_MIC
           AND VERSION = LV_VER.
      ENDIF.
    ENDIF.
    DATA: LV_V1 TYPE STRING, LV_V2 TYPE STRING, LV_V3 TYPE STRING, LV_V4 TYPE STRING.
    LV_V4 = <FS_OUTPUT>-VALUE4. CONDENSE LV_V4.
    LV_V3 = <FS_OUTPUT>-VALUE3. CONDENSE LV_V3.
    LV_V2 = <FS_OUTPUT>-VALUE2. CONDENSE LV_V2.
    LV_V1 = <FS_OUTPUT>-VALUE1. CONDENSE LV_V1.

    IF LV_V4 NE '' AND LV_V4 NE '0.000'.
      <FS_OUTPUT>-LAST_VALUE = <FS_OUTPUT>-VALUE4.
    ELSEIF LV_V3 NE '' AND LV_V3 NE '0.000'.
      <FS_OUTPUT>-LAST_VALUE = <FS_OUTPUT>-VALUE3.
    ELSEIF LV_V2 NE '' AND LV_V2 NE '0.000'.
      <FS_OUTPUT>-LAST_VALUE = <FS_OUTPUT>-VALUE2.
    ELSEIF LV_V1 NE '' AND LV_V1 NE '0.000'.
      <FS_OUTPUT>-LAST_VALUE = <FS_OUTPUT>-VALUE1.
    ELSE.
      CLEAR <FS_OUTPUT>-LAST_VALUE.
    ENDIF.

    IF <FS_OUTPUT>-LAST_VALUE IS NOT INITIAL AND <FS_OUTPUT>-LAST_VALUE NE '0.000' AND <FS_OUTPUT>-LAST_VALUE NE ' '.
      <FS_OUTPUT>-STATUS = 'OK'.
      IF <FS_OUTPUT>-LAST_VALUE < WA_MAP_INSP_CHAR-TOLERANZUN OR <FS_OUTPUT>-LAST_VALUE > WA_MAP_INSP_CHAR-TOLERANZOB.
        <FS_OUTPUT>-STATUS = 'NOT OK'.
      ENDIF.
    ELSE.
      <FS_OUTPUT>-STATUS = 'NOT YET'.
    ENDIF.

    IF ITAB-ZSTAT IS INITIAL.
      ITAB-ZSTAT = GREY.
    ENDIF.
  ENDLOOP.
  CLEAR : IT_OUTPUT.
  REFRESH : IT_OUTPUT.
  APPEND LINES OF ITAB TO IT_OUTPUT.
  IF NOT G_GRID IS INITIAL.
    CALL METHOD G_GRID->REFRESH_TABLE_DISPLAY.
  ENDIF.
ENDFORM.                    " REFRESH

*&---------------------------------------------------------------------*
*&      Form  DOWNLOAD_TEMPLATE

*&---------------------------------------------------------------------*
FORM DOWNLOAD_TEMPLATE .
  DATA : BEGIN OF IT_TEMPLATE OCCURS 0 ,
           INSPDATE       TYPE STRING,
           INSPECTION     TYPE STRING,
           ROLL_JR        TYPE STRING,
           ROLL           TYPE STRING,
           TYPE           TYPE STRING,
           STATUS         TYPE STRING,
           CYCLE          TYPE STRING,
           VALUE1         TYPE STRING,
           VALUE2         TYPE STRING,
           VALUE3         TYPE STRING,
           VALUE4         TYPE STRING,
       LAST_VALUE     TYPE STRING,
           END OF IT_TEMPLATE.
  DATA : WA_TEMPLATE LIKE IT_TEMPLATE.
  IF IT_OUTPUT IS NOT INITIAL.
    CLEAR : WA_OUTPUT.
    WA_TEMPLATE-INSPDATE = 'Est. Date'.
    WA_TEMPLATE-INSPECTION = 'Inspection Type'.
    WA_TEMPLATE-ROLL_JR = 'No. Roll JR'.
    WA_TEMPLATE-ROLL   = 'No. Roll SR'.
    WA_TEMPLATE-TYPE   = 'Type'.
    WA_TEMPLATE-STATUS = 'Status'.
    WA_TEMPLATE-CYCLE = 'Cycle'.
    WA_TEMPLATE-VALUE1 = 'Value 1'.
    WA_TEMPLATE-VALUE2 = 'Value 2'.
    WA_TEMPLATE-VALUE3 = 'Value 3'.
    WA_TEMPLATE-VALUE4 = 'Value 4'.
    WA_TEMPLATE-LAST_VALUE = 'Last Value'.
    APPEND WA_TEMPLATE TO IT_TEMPLATE.
    LOOP AT IT_OUTPUT INTO WA_OUTPUT.
      WA_TEMPLATE-INSPDATE = WA_OUTPUT-INSPDATE.
      WA_TEMPLATE-INSPECTION = WA_OUTPUT-INSPECTION.
      WA_TEMPLATE-ROLL_JR = WA_OUTPUT-ROLL_JR.
      WA_TEMPLATE-ROLL = WA_OUTPUT-ROLL.
      WA_TEMPLATE-TYPE = WA_OUTPUT-TYPE.
      WA_TEMPLATE-STATUS = WA_OUTPUT-STATUS.
      WA_TEMPLATE-CYCLE = WA_OUTPUT-CYCLE.
      WA_TEMPLATE-VALUE1 = WA_OUTPUT-VALUE1.
      WA_TEMPLATE-VALUE2 = WA_OUTPUT-VALUE2.
      WA_TEMPLATE-VALUE3 = WA_OUTPUT-VALUE3.
      WA_TEMPLATE-VALUE4 = WA_OUTPUT-VALUE4.
      WA_TEMPLATE-LAST_VALUE = WA_OUTPUT-LAST_VALUE.
      APPEND WA_TEMPLATE TO IT_TEMPLATE.
    ENDLOOP.
    DATA : OBJFILE TYPE REF TO CL_GUI_FRONTEND_SERVICES,
           PICKEDFOLDER TYPE STRING,
           INITIALFOLDER TYPE STRING,
           LV_FILENAME TYPE STRING .
    CREATE OBJECT OBJFILE.
    OBJFILE->DIRECTORY_BROWSE( EXPORTING    INITIAL_FOLDER        = INITIALFOLDER
                               CHANGING     SELECTED_FOLDER       = PICKEDFOLDER
                               EXCEPTIONS   CNTL_ERROR            = 1
                                            ERROR_NO_GUI          = 2
                                            NOT_SUPPORTED_BY_GUI  = 3 ).
    LV_FILENAME = PICKEDFOLDER && '\' && 'Template_upload' && '_' && SY-DATUM && '_' && SY-TIMLO && '.xls'.
    CLEAR : V_MESSAGE.
    CONCATENATE 'File downloaded in' PICKEDFOLDER INTO V_MESSAGE SEPARATED BY SPACE .
    IF PICKEDFOLDER IS INITIAL.
      EXIT.
    ENDIF.
    CALL FUNCTION 'GUI_DOWNLOAD'
      EXPORTING
        FILENAME              = LV_FILENAME
        FILETYPE              = 'ASC'
        WRITE_FIELD_SEPARATOR = 'X' " FOR TAB-SEPARATED VALUES
      TABLES
        DATA_TAB              = IT_TEMPLATE
      EXCEPTIONS
        FILE_OPEN_ERROR       = 1
        FILE_WRITE_ERROR      = 2
        INVALID_FILESIZE      = 3
        INVALID_TABLE_WIDTH   = 4
        INVALID_TYPE          = 5
        NO_BATCH              = 6
        UNKNOWN_ERROR         = 7
        OTHERS                = 8.
    IF SY-SUBRC <> 0.
      MESSAGE 'Error during file download' TYPE 'E'.
    ELSE.
      MESSAGE V_MESSAGE TYPE 'I'.
    ENDIF.
  ENDIF.
ENDFORM.                    " DOWNLOAD_TEMPLATE

*&---------------------------------------------------------------------*
*& FORM DELETE_CANCELLED_LOTS
*&---------------------------------------------------------------------*
FORM DELETE_CANCELLED_LOTS.
  IF IT_OUTPUT[] IS INITIAL.
    RETURN.
  ENDIF.

  TYPES: BEGIN OF TY_STAT_FILTER,
           PRUEFLOS TYPE QALS-PRUEFLOS,
         END OF TY_STAT_FILTER.
  DATA: LT_STAT_FILTER TYPE TABLE OF TY_STAT_FILTER,
        LS_STAT_FILTER TYPE TY_STAT_FILTER.

  SELECT QALS~PRUEFLOS
    INTO TABLE LT_STAT_FILTER
    FROM QALS
    JOIN JEST ON JEST~OBJNR = QALS~OBJNR
    JOIN TJ02T ON TJ02T~ISTAT = JEST~STAT
    FOR ALL ENTRIES IN IT_OUTPUT
    WHERE QALS~PRUEFLOS EQ IT_OUTPUT-PRUEFLOS
      AND TJ02T~SPRAS EQ SY-LANGU
      AND TJ02T~TXT04 EQ 'LTCA'.

  IF LT_STAT_FILTER[] IS NOT INITIAL.
    SORT LT_STAT_FILTER BY PRUEFLOS.
    LOOP AT IT_OUTPUT INTO WA_OUTPUT.
      READ TABLE LT_STAT_FILTER INTO LS_STAT_FILTER WITH KEY PRUEFLOS = WA_OUTPUT-PRUEFLOS BINARY SEARCH.
      IF SY-SUBRC EQ 0.
        DELETE IT_OUTPUT.
      ENDIF.
    ENDLOOP.
    LOOP AT ITAB INTO WA_OUTPUT.
      READ TABLE LT_STAT_FILTER INTO LS_STAT_FILTER WITH KEY PRUEFLOS = WA_OUTPUT-PRUEFLOS BINARY SEARCH.
      IF SY-SUBRC EQ 0.
        DELETE ITAB.
      ENDIF.
    ENDLOOP.
  ENDIF.
ENDFORM.                    "DELETE_CANCELLED_LOTS

*&---------------------------------------------------------------------*
*&      Form  DELETE_NOT_YET
*&---------------------------------------------------------------------*
FORM DELETE_NOT_YET.
  " 1. Filter Inspection Type (MVTR / OTR)
  IF V_MVTR IS INITIAL.
    DELETE IT_OUTPUT WHERE INSPECTION CS 'MVTR' OR INSPECTION CS 'WVTR'.
  ENDIF.
  IF V_OTR IS INITIAL.
    DELETE IT_OUTPUT WHERE INSPECTION CS 'OTR' OR INSPECTION CS 'O2TR'.
  ENDIF.
  " 2. Filter Status Judgement (OK / NOT OK / NOT YET)
  IF V_OKOK IS INITIAL.
    DELETE IT_OUTPUT WHERE STATUS EQ 'OK'.
  ENDIF.
  IF V_NOTOK IS INITIAL.
    DELETE IT_OUTPUT WHERE STATUS EQ 'NOT OK'.
  ENDIF.
  IF V_NOTYET IS INITIAL.
    DELETE IT_OUTPUT WHERE STATUS EQ 'NOT YET'.
  ENDIF.
ENDFORM.                    " DELETE_NOT_YET

*&---------------------------------------------------------------------*
*&      Form  GET_INSPECTION

*&---------------------------------------------------------------------*
FORM GET_INSPECTION USING P_CHARGSR P_MATNRSR P_CHARGJR P_FILTER.
  DATA: LV_ATTRIBUT TYPE QASR-ATTRIBUT.
  SELECT
     QALS~PRUEFLOS QALS~KTEXTLOS QALS~CHARG QASE~MERKNR QALS~WERK QASE~PROBENR QASE~STUECKNR QASE~MESSWERT QAPP~VCODE QAMV~KURZTEXT QAMV~VERWMERKM QALS~AUFPL QASR~PRUEFDATUV QASR~ATTRIBUT
     INTO (WA_INSP_DAT-INSPLOT, WA_INSP_DAT-POSISI , WA_INSP_DAT-CHARGSR, WA_INSP_DAT-INSPTYPE , WA_INSP_DAT-PLANT, WA_INSP_DAT-TIMES,WA_INSP_DAT-CYCLES, V_VALUE, WA_INSP_DAT-STATUS, WA_INSP_DAT-INSPTEXT ,
     WA_INSP_DAT-MASTERINSP, WA_INSP_DAT-AUFPL, WA_INSP_DAT-ESTDATE, LV_ATTRIBUT)
     FROM QALS
    JOIN QAMV ON QALS~PRUEFLOS = QAMV~PRUEFLOS
    JOIN QASE ON QALS~PRUEFLOS = QASE~PRUEFLOS AND QASE~MERKNR = QAMV~MERKNR
    LEFT JOIN QASR ON QASR~PRUEFLOS = QASE~PRUEFLOS AND QASR~MERKNR = QASE~MERKNR AND QASR~PROBENR = QASE~PROBENR
    LEFT JOIN QAPP ON QAPP~PRUEFLOS = QASE~PRUEFLOS AND QAPP~PROBENR = QASE~PROBENR
   WHERE QALS~CHARG = P_CHARGSR
   AND QALS~KTEXTLOS <> ''.

    IF P_FILTER = 'X' AND LV_ATTRIBUT <> ''.
      CONTINUE.
    ENDIF.
    CALL FUNCTION 'QSS0_FLTP_TO_CHAR_CONVERSION'
      EXPORTING
        I_NUMBER_OF_DIGITS       = 3
        I_FLTP_VALUE             = V_VALUE
        I_VALUE_NOT_INITIAL_FLAG = 'X'
        I_SCREEN_FIELDLENGTH     = 16
      IMPORTING
        E_CHAR_FIELD             = WA_INSP_DAT-VALUE.
    WA_INSP_DAT-CHARGJR = P_CHARGJR.
    WA_INSP_DAT-MATNRSR = P_MATNRSR.
    SELECT SINGLE TJ02T~TXT04
      INTO WA_INSP_DAT-IS_CANCEL
      FROM QALS
    JOIN JEST ON JEST~OBJNR = QALS~OBJNR
    JOIN TJ02T ON TJ02T~ISTAT = JEST~STAT
    WHERE QALS~PRUEFLOS EQ WA_INSP_DAT-INSPLOT
          AND TJ02T~SPRAS EQ 'E'
          AND TJ02T~TXT04 EQ 'LTCA'.
    APPEND WA_INSP_DAT TO IT_INSP_DAT.
    CLEAR : WA_INSP_DAT.
  ENDSELECT.
  CLEAR : WA_INSP_DAT.
  DELETE IT_INSP_DAT WHERE IS_CANCEL = 'LTCA'.
  SORT IT_INSP_DAT BY CHARGJR INSPLOT INSPTYPE TIMES CYCLES ASCENDING.
ENDFORM.                    " GET_INSPECTION

