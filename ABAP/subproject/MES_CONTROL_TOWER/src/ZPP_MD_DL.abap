*----------------------------------------------------------------------*
* FORM: GET_ALL_BOM (Mode ALL)
*----------------------------------------------------------------------*
FORM GET_ALL_BOM USING VALUE(P_MATKL) TYPE STANDARD TABLE
                 CHANGING W_MAST LIKE T_MAST
                          W_STKO LIKE T_STKO
                          W_STPO LIKE T_STPO
                          W_STAS LIKE T_STAS.

  DATA: IT_MAST LIKE MAST OCCURS 0 WITH HEADER LINE,
        IT_STKO LIKE STKO OCCURS 0 WITH HEADER LINE,
        IT_STPO LIKE STPO OCCURS 0 WITH HEADER LINE,
        IT_STAS LIKE STAS OCCURS 0 WITH HEADER LINE,
        BEGIN OF IT_MATNR OCCURS 0,
          MATNR TYPE MARA-MATNR,
        END OF IT_MATNR.

  IF P_MATKL[] IS NOT INITIAL.
    SELECT MATNR FROM MARA INTO TABLE IT_MATNR WHERE MATKL IN P_MATKL.
    IF IT_MATNR[] IS NOT INITIAL.
      SELECT * FROM MAST INTO TABLE IT_MAST
        FOR ALL ENTRIES IN IT_MATNR
        WHERE MATNR = IT_MATNR-MATNR.

      IF IT_MAST[] IS NOT INITIAL.
        SELECT * FROM STKO INTO TABLE IT_STKO
          FOR ALL ENTRIES IN IT_MAST
          WHERE STLNR = IT_MAST-STLNR.

        IF IT_STKO[] IS NOT INITIAL.
          SELECT * FROM STPO INTO TABLE IT_STPO
            FOR ALL ENTRIES IN IT_STKO
            WHERE STLTY = IT_STKO-STLTY AND
                  STLNR = IT_STKO-STLNR.

          IF IT_STPO[] IS NOT INITIAL.
            SELECT * FROM STAS INTO TABLE IT_STAS
              FOR ALL ENTRIES IN IT_STPO
              WHERE STLTY = IT_STPO-STLTY AND
                    STLNR = IT_STPO-STLNR.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ELSE.
    SELECT * FROM MAST INTO TABLE IT_MAST.
    SELECT * FROM STKO INTO TABLE IT_STKO.
    SELECT * FROM STPO INTO TABLE IT_STPO.
    SELECT * FROM STAS INTO TABLE IT_STAS.
  ENDIF.

  IF IT_MAST[] IS NOT INITIAL OR IT_STKO[] IS NOT INITIAL OR
     IT_STPO[] IS NOT INITIAL OR IT_STAS[] IS NOT INITIAL.

    IT_MAST-ANDAT = '19000101'.
    IT_MAST-AEDAT = '19000101'.
    MODIFY IT_MAST TRANSPORTING ANDAT WHERE ANDAT = 00000000.
    MODIFY IT_MAST TRANSPORTING AEDAT WHERE AEDAT = 00000000.

    IT_STKO-DATUV = '19000101'.
    IT_STKO-ANDAT = '19000101'.
    IT_STKO-AEDAT = '19000101'.
    IT_STKO-DVDAT = '19000101'.
    MODIFY IT_STKO TRANSPORTING DATUV WHERE DATUV = 00000000.
    MODIFY IT_STKO TRANSPORTING ANDAT WHERE ANDAT = 00000000.
    MODIFY IT_STKO TRANSPORTING AEDAT WHERE AEDAT = 00000000.
    MODIFY IT_STKO TRANSPORTING DVDAT WHERE DVDAT = 00000000.

    IT_STPO-DATUV = '19000101'.
    IT_STPO-ANDAT = '19000101'.
    IT_STPO-AEDAT = '19000101'.
    IT_STPO-DVDAT = '19000101'.
    MODIFY IT_STPO TRANSPORTING DATUV WHERE DATUV = 00000000.
    MODIFY IT_STPO TRANSPORTING ANDAT WHERE ANDAT = 00000000.
    MODIFY IT_STPO TRANSPORTING AEDAT WHERE AEDAT = 00000000.
    MODIFY IT_STPO TRANSPORTING DVDAT WHERE DVDAT = 00000000.

    IT_STAS-DATUV = '19000101'.
    IT_STAS-ANDAT = '19000101'.
    IT_STAS-AEDAT = '19000101'.
    IT_STAS-DVDAT = '19000101'.
    MODIFY IT_STAS TRANSPORTING DATUV WHERE DATUV = 00000000.
    MODIFY IT_STAS TRANSPORTING ANDAT WHERE ANDAT = 00000000.
    MODIFY IT_STAS TRANSPORTING AEDAT WHERE AEDAT = 00000000.
    MODIFY IT_STAS TRANSPORTING DVDAT WHERE DVDAT = 00000000.

    W_MAST[] = IT_MAST[].
    W_STKO[] = IT_STKO[].
    W_STPO[] = IT_STPO[].
    W_STAS[] = IT_STAS[].

    CLEAR: IT_MAST[], IT_STKO[], IT_STPO[], IT_STAS[].
    REFRESH: IT_MAST[], IT_STKO[], IT_STPO[], IT_STAS[].
  ELSE.
    MESSAGE 'Data Not Found' TYPE 'S' RAISING DATA_NOT_FOUND.
  ENDIF.

ENDFORM.
