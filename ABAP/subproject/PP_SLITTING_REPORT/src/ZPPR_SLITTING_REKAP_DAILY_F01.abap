*&---------------------------------------------------------------------
*&      Form  F_GUI_STATUS
*&---------------------------------------------------------------------
FORM F_GUI_STATUS USING FT_EXTAB TYPE SLIS_T_EXTAB.
  REFRESH FT_EXTAB.
  CLEAR FT_EXTAB.
  APPEND 'DETAIL' TO FT_EXTAB.

  SET PF-STATUS 'STANDARD_FULLSCREEN' EXCLUDING FT_EXTAB.
ENDFORM.                    " F_ALV_STATUS




*&---------------------------------------------------------------------*
*&      Form  WRITE_DATA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM WRITE_DATA .

  DATA : V_PDATE  TYPE CHAR10.
  DATA : O_CX TYPE REF TO CX_ROOT,
         V_CX_MSG(500).

  DATA: V_DL_TM(20) TYPE C.

  EXEC SQL.
    CONNECT TO 'TRIASDB05' AS 'DBTRIAL'
  ENDEXEC.

  EXEC SQL.
    SET CONNECTION 'DBTRIAL'
  ENDEXEC.


  EXEC SQL.
    DELETE FROM XZPP016
  ENDEXEC.

  EXEC SQL.
    COMMIT WORK
  ENDEXEC.

  " set download time
  CONCATENATE SY-DATUM SY-UZEIT INTO V_DL_TM SEPARATED BY SPACE.

  UNASSIGN <FS_MSEG>.
  LOOP AT IT_MSEG ASSIGNING <FS_MSEG>.
    CLEAR V_PDATE.
    CONCATENATE <FS_MSEG>-BUDAT+6(2) '/' <FS_MSEG>-BUDAT+4(2) '/' <FS_MSEG>-BUDAT+0(4) INTO V_PDATE.
    CONDENSE V_PDATE NO-GAPS.

    " extend program runtime
    CALL FUNCTION 'TH_REDISPATCH'
      EXPORTING
        CHECK_RUNTIME = 0.

    " Modified by William at 20.06.2025 (Add ZZCORETYPE)
    EXEC SQL.
      INSERT INTO XZPP016( PRODDATE,COMBINEDORDER,ORIGINALORDER,ORIGINALORDERTYPE,PLANT,SLOC,PRODLINE,RESOURCE,MATERIAL,
                          FILMTYPE,BATCH,ROLLNO,CRITERIAGRADE,GRADE,MSSS,TURUNANMS,POSISIMS,TURUNANSS,POSISISS,TREATMENT,
                          PACKING,WIDTH,LENGTH,EXTRALENGTH,CORETYPE,QUANTITY,STARTDATE,STARTTIME,FINISHDATE,FINISHTIME,PROCESSTIME,SPEED,
                          LASTCRITERIA,LASTGRADE,DOWNLOADTIME,SO,SOITEM,SOTYPE,SOLDTOPARTY,CUSTOMERNAME,ENTEREDAT)
      VALUES(:<FS_MSEG>-BUDAT,:<FS_MSEG>-COMB,:<FS_MSEG>-AUFNR,:<FS_MSEG>-AUART,:<FS_MSEG>-WERKS,:<FS_MSEG>-LGORT,:<FS_MSEG>-LINECD,:<FS_MSEG>-ARBPL,:<FS_MSEG>-MATNR,
             :<FS_MSEG>-ZZCODE,:<FS_MSEG>-CHARG,:<FS_MSEG>-NOROLL,:<FS_MSEG>-CRIT,:<FS_MSEG>-GRADE,:<FS_MSEG>-ZMSSS,:<FS_MSEG>-ZDERMS,:<FS_MSEG>-ZPOSMS,:<FS_MSEG>-ZDERSS,:<FS_MSEG>-ZPOSSS,:<FS_MSEG>-TREAT,
             :<FS_MSEG>-PCKNG,:<FS_MSEG>-WIDTH,:<FS_MSEG>-LENGTH,:<FS_MSEG>-ZEXTRA,:<FS_MSEG>-ZZCORETYPE,:<FS_MSEG>-MENGE,:<FS_MSEG>-ISDD,:<FS_MSEG>-ISDZ,:<FS_MSEG>-IEDD,:<FS_MSEG>-IEDZ,:<FS_MSEG>-ISM01,:<FS_MSEG>-ZSPEED,
             :<FS_MSEG>-V_LASTCRIT,:<FS_MSEG>-V_LASTGRADE,:V_DL_TM,:<FS_MSEG>-KDAUF2,:<FS_MSEG>-KDPOS2,:<FS_MSEG>-AUART2,:<FS_MSEG>-KUNNR,:<FS_MSEG>-NAME1,:<FS_MSEG>-CPUTM)
   ENDEXEC.
  ENDLOOP.

  IF SY-SUBRC EQ 0. " call SP to merge
    CLEAR: V_CX_MSG.
    TRY.
        EXEC SQL.
          EXECUTE PROCEDURE [DBO].[SP_MERGE_ZPP016]
        ENDEXEC.
      CATCH CX_ROOT INTO O_CX.
        V_CX_MSG = O_CX->GET_TEXT( ).
        MESSAGE 'Failed to merge data' TYPE 'S' DISPLAY LIKE 'E'.
        LEAVE LIST-PROCESSING.
    ENDTRY.
  ENDIF.

  MESSAGE 'Penyimpanan Data ke SQL sukses!!!' TYPE 'I'.
ENDFORM.                    " WRITE_DATA