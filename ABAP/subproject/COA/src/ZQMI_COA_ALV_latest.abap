*&--- ZQMI_COA_ALV: mode report ALV (ZQM003) ---
*&--- Value per DO-item dari IT_MIC1 ---
TYPE-POOLS SLIS.
TYPES: BEGIN OF TY_ALVR,
        VBELN LIKE LIPS-VBELN,
        POSNR LIKE LIPS-POSNR,
        CHARG LIKE LIPS-CHARG,
        NOMSR(20),
        ZZTYPE(10),
        MATNR LIKE LIPS-MATNR,
        WERKS LIKE LIPS-WERKS,
        MIC LIKE QPMK-MKMNR,
        MICDES LIKE QPMT-KURZTEXT,
        UOM TYPE C LENGTH 30,
        METHOD(40),
        MICMIN TYPE C LENGTH 17,
        MICMAX TYPE C LENGTH 17,
        INS LIKE QALS-PRUEFLOS,
        CMICMIT(20),
        NEW_VALUE TYPE C LENGTH 25,
      END OF TY_ALVR.
DATA: IT_ALVR TYPE STANDARD TABLE OF TY_ALVR WITH HEADER LINE.
DATA: IT_FCATR TYPE SLIS_T_FIELDCAT_ALV.
DATA: WA_FCATR TYPE SLIS_FIELDCAT_ALV.
DATA: WA_LAYR TYPE SLIS_LAYOUT_ALV.
*&---------------------------------------------------------------------*
*&      Form  RPT_PRESELECT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM RPT_PRESELECT.
  DATA: LT_VB TYPE TABLE OF LIPS-VBELN WITH HEADER LINE.
  IF P_VBELN[] IS INITIAL AND S_ERDAT[] IS INITIAL
     AND P_WERKS IS INITIAL AND P_CHARG[] IS INITIAL
     AND P_MATNR[] IS INITIAL AND P_ATWRT[] IS INITIAL.
    MESSAGE 'Isi minimal 1 filter.' TYPE 'E'.
  ENDIF.
  IF P_VBELN[] IS NOT INITIAL.
    RETURN.
  ENDIF.
  IF S_ERDAT[] IS INITIAL AND P_WERKS IS INITIAL.
    RETURN.
  ENDIF.
  IF S_ERDAT[] IS NOT INITIAL AND P_WERKS IS NOT INITIAL.
    SELECT DISTINCT A~VBELN INTO TABLE LT_VB
      FROM LIPS AS A INNER JOIN LIKP AS B
        ON A~VBELN = B~VBELN
      WHERE B~ERDAT IN S_ERDAT
        AND A~WERKS = P_WERKS.
  ELSEIF S_ERDAT[] IS NOT INITIAL.
    SELECT VBELN INTO TABLE LT_VB
      FROM LIKP WHERE ERDAT IN S_ERDAT.
  ELSE.
    SELECT DISTINCT VBELN INTO TABLE LT_VB
      FROM LIPS WHERE WERKS = P_WERKS.
  ENDIF.
  SORT LT_VB.
  DELETE ADJACENT DUPLICATES FROM LT_VB.
  LOOP AT LT_VB.
    CLEAR P_VBELN.
    P_VBELN-SIGN = 'I'.
    P_VBELN-OPTION = 'EQ'.
    P_VBELN-LOW = LT_VB.
    APPEND P_VBELN.
  ENDLOOP.
  IF P_VBELN[] IS INITIAL.
    MESSAGE 'Tidak ada delivery utk filter.' TYPE 'E'.
  ENDIF.
ENDFORM.                    "RPT_PRESELECT
*&---------------------------------------------------------------------*
*&      Form  RPT_FILTER
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM RPT_FILTER.
  IF P_WERKS IS NOT INITIAL.
    DELETE IT_MIC1 WHERE WERKS NE P_WERKS.
  ENDIF.
ENDFORM.                    "RPT_FILTER
*&---------------------------------------------------------------------*
*&      Form  RPT_BUILD
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM RPT_BUILD.
  DATA: LV_DEC TYPE I,
        LV_UOM TYPE C LENGTH 30.
  DATA: BEGIN OF LT_METHOD OCCURS 0,
          MATNR LIKE ZMAP_COA-MATNR,
          MIC LIKE ZMAP_COA-MIC,
          METHOD LIKE ZMAP_COA-METHOD,
        END OF LT_METHOD.
  DATA: BEGIN OF LT_RESULT OCCURS 0,
          INSLOT LIKE QALS-PRUEFLOS,
          MERKNR LIKE QAMV-MERKNR,
          MITTELWERT LIKE QAMR-MITTELWERT,
          ANZWERTG LIKE QAMR-ANZWERTG,
        END OF LT_RESULT.
  DATA: BEGIN OF LT_UNIQUE OCCURS 0,
          VBELN LIKE LIPS-VBELN,
          MATNR LIKE LIPS-MATNR,
          WERKS LIKE LIPS-WERKS,
          MIC LIKE QAMV-VERWMERKM,
          MICMIT LIKE QAMR-MITTELWERT,
          CMICMIT TYPE C LENGTH 20,
        END OF LT_UNIQUE.
  DATA: BEGIN OF LT_FINAL OCCURS 0,
          VBELN LIKE LIPS-VBELN,
          MATNR LIKE LIPS-MATNR,
          WERKS LIKE LIPS-WERKS,
          MIC LIKE QAMV-VERWMERKM,
          CMICMIT TYPE C LENGTH 17,
        END OF LT_FINAL.
  DATA: LV_FINAL_SUM TYPE QAMR-MITTELWERT,
        LV_FINAL_CNT TYPE I,
        LV_FINAL_VAL TYPE QAMR-MITTELWERT,
        LV_FINAL_DEC TYPE I,
        LV_FINAL_UOM TYPE C LENGTH 30.
  DATA: BEGIN OF LT_VBELN OCCURS 0,
          VBELN LIKE LIKP-VBELN,
        END OF LT_VBELN.
  DATA: BEGIN OF LT_KUNNR OCCURS 0,
          VBELN LIKE LIKP-VBELN,
          KUNNR LIKE LIKP-KUNAG,
        END OF LT_KUNNR.
  DATA: BEGIN OF LT_ZKEY OCCURS 0,
          PRUEFLOS LIKE ZLOG_COA-PRUEFLOS,
          MIC LIKE ZLOG_COA-MIC,
        END OF LT_ZKEY.
  DATA: BEGIN OF LT_ZLOG OCCURS 0,
          PRUEFLOS LIKE ZLOG_COA-PRUEFLOS,
          MIC LIKE ZLOG_COA-MIC,
          KUNNR LIKE ZLOG_COA-KUNNR,
          SEQ LIKE ZLOG_COA-SEQ,
          VALUE1 LIKE ZLOG_COA-VALUE1,
          VALUE2 LIKE ZLOG_COA-VALUE2,
        END OF LT_ZLOG.
  REFRESH: IT_ALVR, LT_METHOD, LT_RESULT, LT_UNIQUE, LT_FINAL,
           LT_VBELN, LT_KUNNR, LT_ZKEY, LT_ZLOG.
  LOOP AT IT_MIC1.
    LT_UNIQUE-VBELN = IT_MIC1-VBELN.
    LT_UNIQUE-MATNR = IT_MIC1-MATNR.
    LT_UNIQUE-WERKS = IT_MIC1-WERKS.
    LT_UNIQUE-MIC = IT_MIC1-MIC.
    LT_UNIQUE-MICMIT = IT_MIC1-MICMIT.
    LT_UNIQUE-CMICMIT = IT_MIC1-CMICMIT.
    APPEND LT_UNIQUE.
  ENDLOOP.
  SORT LT_UNIQUE BY VBELN MATNR MIC MICMIT.
  DELETE ADJACENT DUPLICATES FROM LT_UNIQUE
    COMPARING VBELN MATNR MIC MICMIT.
  CLEAR: LT_FINAL, LV_FINAL_SUM, LV_FINAL_CNT.
  LOOP AT LT_UNIQUE.
    IF LT_FINAL-VBELN IS INITIAL.
      LT_FINAL-VBELN = LT_UNIQUE-VBELN.
      LT_FINAL-MATNR = LT_UNIQUE-MATNR.
      LT_FINAL-WERKS = LT_UNIQUE-WERKS.
      LT_FINAL-MIC = LT_UNIQUE-MIC.
    ELSEIF LT_FINAL-VBELN <> LT_UNIQUE-VBELN OR
           LT_FINAL-MATNR <> LT_UNIQUE-MATNR OR
           LT_FINAL-MIC <> LT_UNIQUE-MIC.
      IF LV_FINAL_CNT > 0.
        PERFORM MICFMT USING LT_FINAL-MIC LT_FINAL-WERKS
          CHANGING LV_FINAL_DEC LV_FINAL_UOM.
        LV_FINAL_VAL = LV_FINAL_SUM / LV_FINAL_CNT.
        WRITE LV_FINAL_VAL TO LT_FINAL-CMICMIT EXPONENT 0
          DECIMALS LV_FINAL_DEC LEFT-JUSTIFIED.
      ELSE.
        LT_FINAL-CMICMIT = '0'.
      ENDIF.
      APPEND LT_FINAL.
      CLEAR: LT_FINAL, LV_FINAL_SUM, LV_FINAL_CNT.
      LT_FINAL-VBELN = LT_UNIQUE-VBELN.
      LT_FINAL-MATNR = LT_UNIQUE-MATNR.
      LT_FINAL-WERKS = LT_UNIQUE-WERKS.
      LT_FINAL-MIC = LT_UNIQUE-MIC.
    ENDIF.
    IF LT_UNIQUE-CMICMIT <> '0'.
      LV_FINAL_SUM = LV_FINAL_SUM + LT_UNIQUE-MICMIT.
      LV_FINAL_CNT = LV_FINAL_CNT + 1.
    ENDIF.
  ENDLOOP.
  IF LT_FINAL-VBELN IS NOT INITIAL.
    IF LV_FINAL_CNT > 0.
      PERFORM MICFMT USING LT_FINAL-MIC LT_FINAL-WERKS
        CHANGING LV_FINAL_DEC LV_FINAL_UOM.
      LV_FINAL_VAL = LV_FINAL_SUM / LV_FINAL_CNT.
      WRITE LV_FINAL_VAL TO LT_FINAL-CMICMIT EXPONENT 0
        DECIMALS LV_FINAL_DEC LEFT-JUSTIFIED.
    ELSE.
      LT_FINAL-CMICMIT = '0'.
    ENDIF.
    APPEND LT_FINAL.
  ENDIF.
  SORT LT_FINAL BY VBELN MATNR MIC.
  LOOP AT IT_MIC1.
    LT_VBELN-VBELN = IT_MIC1-VBELN.
    APPEND LT_VBELN.
    LT_ZKEY-PRUEFLOS = IT_MIC1-INSLOT.
    LT_ZKEY-MIC = IT_MIC1-MIC.
    APPEND LT_ZKEY.
  ENDLOOP.
  SORT LT_VBELN BY VBELN.
  DELETE ADJACENT DUPLICATES FROM LT_VBELN COMPARING VBELN.
  SORT LT_ZKEY BY PRUEFLOS MIC.
  DELETE ADJACENT DUPLICATES FROM LT_ZKEY
    COMPARING PRUEFLOS MIC.
  IF LT_VBELN[] IS NOT INITIAL.
    SELECT VBELN KUNAG INTO TABLE LT_KUNNR
      FROM LIKP
      FOR ALL ENTRIES IN LT_VBELN
      WHERE VBELN = LT_VBELN-VBELN.
    SORT LT_KUNNR BY VBELN.
  ENDIF.
  IF LT_ZKEY[] IS NOT INITIAL.
    SELECT PRUEFLOS MIC KUNNR SEQ VALUE1 VALUE2
      INTO TABLE LT_ZLOG
      FROM ZLOG_COA
      FOR ALL ENTRIES IN LT_ZKEY
      WHERE PRUEFLOS = LT_ZKEY-PRUEFLOS
        AND MIC = LT_ZKEY-MIC
        AND DELETION NE 'X'.
    SORT LT_ZLOG BY PRUEFLOS MIC KUNNR SEQ.
  ENDIF.
  IF IT_MIC1[] IS NOT INITIAL.
    SELECT MATNR MIC METHOD INTO TABLE LT_METHOD
      FROM ZMAP_COA
      FOR ALL ENTRIES IN IT_MIC1
      WHERE MATNR = IT_MIC1-MATNR
        AND MIC = IT_MIC1-MIC
        AND KUNNR = ' '
        AND DELETION NE 'X'.
    SORT LT_METHOD BY MATNR MIC.
    DELETE ADJACENT DUPLICATES FROM LT_METHOD COMPARING MATNR MIC.
    SELECT PRUEFLOS MERKNR MITTELWERT ANZWERTG INTO TABLE LT_RESULT
      FROM QAMR
      FOR ALL ENTRIES IN IT_MIC1
      WHERE PRUEFLOS = IT_MIC1-INSLOT
        AND MERKNR = IT_MIC1-MERKNR
        AND ANZWERTG > 0.
    SORT LT_RESULT BY INSLOT MERKNR.
    DELETE ADJACENT DUPLICATES FROM LT_RESULT COMPARING INSLOT MERKNR.
  ENDIF.
  LOOP AT IT_MIC1.
    CLEAR: IT_ALVR, LV_DEC, LV_UOM.
    PERFORM MICFMT USING IT_MIC1-MIC IT_MIC1-WERKS
            CHANGING LV_DEC LV_UOM.
    IT_ALVR-VBELN  = IT_MIC1-VBELN.
    IT_ALVR-POSNR  = IT_MIC1-POSNR.
    IT_ALVR-CHARG  = IT_MIC1-CHARG.
    IT_ALVR-NOMSR  = IT_MIC1-NOMSR.
    IT_ALVR-ZZTYPE = IT_MIC1-ZZTYPE.
    IT_ALVR-MATNR  = IT_MIC1-MATNR.
    IT_ALVR-WERKS  = IT_MIC1-WERKS.
    IT_ALVR-MIC    = IT_MIC1-MIC.
    IT_ALVR-MICDES = IT_MIC1-MICDES.
    IT_ALVR-UOM    = IT_MIC1-UOM.
    IF IT_ALVR-UOM IS INITIAL.
      IT_ALVR-UOM = LV_UOM.
    ENDIF.
    IT_ALVR-METHOD = IT_MIC1-METHOD.
    IF IT_ALVR-METHOD IS INITIAL.
      READ TABLE LT_METHOD WITH KEY MATNR = IT_MIC1-MATNR
                                   MIC = IT_MIC1-MIC
                                   BINARY SEARCH.
      IF SY-SUBRC = 0.
        IT_ALVR-METHOD = LT_METHOD-METHOD.
      ENDIF.
    ENDIF.
    WRITE IT_MIC1-MICMIN TO IT_ALVR-MICMIN
      EXPONENT 0 DECIMALS LV_DEC LEFT-JUSTIFIED.
    WRITE IT_MIC1-MICMAX TO IT_ALVR-MICMAX
      EXPONENT 0 DECIMALS LV_DEC LEFT-JUSTIFIED.
    IT_ALVR-INS = IT_MIC1-INSLOT.
    CLEAR LT_FINAL.
    READ TABLE LT_FINAL WITH KEY VBELN = IT_MIC1-VBELN
                                 MATNR = IT_MIC1-MATNR
                                 MIC = IT_MIC1-MIC
      BINARY SEARCH.
    IF SY-SUBRC = 0.
      IT_ALVR-CMICMIT = LT_FINAL-CMICMIT.
    ELSE.
      IT_ALVR-CMICMIT = IT_MIC1-CMICMIT.
      IF IT_ALVR-CMICMIT IS INITIAL.
        READ TABLE LT_RESULT WITH KEY INSLOT = IT_MIC1-INSLOT
                                      MERKNR = IT_MIC1-MERKNR
                                      BINARY SEARCH.
        IF SY-SUBRC = 0 AND LT_RESULT-ANZWERTG > 0.
          WRITE LT_RESULT-MITTELWERT TO IT_ALVR-CMICMIT
            EXPONENT 0 DECIMALS LV_DEC LEFT-JUSTIFIED.
        ENDIF.
      ENDIF.
    ENDIF.
    CLEAR: LT_KUNNR, LT_ZLOG.
    READ TABLE LT_KUNNR WITH KEY VBELN = IT_MIC1-VBELN
      BINARY SEARCH.
    IF SY-SUBRC = 0.
      READ TABLE LT_ZLOG WITH KEY PRUEFLOS = IT_MIC1-INSLOT
                                 MIC = IT_MIC1-MIC
                                 KUNNR = LT_KUNNR-KUNNR
        BINARY SEARCH.
      IF SY-SUBRC = 0.
        IF LT_ZLOG-VALUE2 IS NOT INITIAL.
          IT_ALVR-NEW_VALUE = LT_ZLOG-VALUE2.
        ELSEIF LT_ZLOG-VALUE1 IS NOT INITIAL.
          WRITE LT_ZLOG-VALUE1 TO IT_ALVR-NEW_VALUE
            EXPONENT 0 DECIMALS LV_DEC LEFT-JUSTIFIED.
        ENDIF.
      ENDIF.
    ENDIF.
    APPEND IT_ALVR.
  ENDLOOP.
  SORT IT_ALVR BY VBELN POSNR MIC.
ENDFORM.                    "RPT_BUILD
*&---------------------------------------------------------------------*
*&      Form  RPT_FCAT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_F        text
*      -->P_T        text
*----------------------------------------------------------------------*
FORM RPT_FCAT USING P_F P_T.
  CLEAR WA_FCATR.
  WA_FCATR-FIELDNAME = P_F.
  WA_FCATR-SELTEXT_M = P_T.
  WA_FCATR-SELTEXT_L = P_T.
  WA_FCATR-SELTEXT_S = P_T.
  APPEND WA_FCATR TO IT_FCATR.
ENDFORM.                    "RPT_FCAT
*&---------------------------------------------------------------------*
*&      Form  RPT_DISPLAY
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM RPT_DISPLAY.
  REFRESH IT_FCATR.
  PERFORM RPT_FCAT USING 'VBELN'   'Nomor ODO'.
  PERFORM RPT_FCAT USING 'POSNR'   'Item'.
  PERFORM RPT_FCAT USING 'CHARG'   'Batch'.
  PERFORM RPT_FCAT USING 'NOMSR'   'No. Roll SR'.
  PERFORM RPT_FCAT USING 'ZZTYPE'  'Film Type'.
  PERFORM RPT_FCAT USING 'MATNR'   'Material'.
  PERFORM RPT_FCAT USING 'WERKS'   'Plant'.
  PERFORM RPT_FCAT USING 'MIC'     'MIC'.
  PERFORM RPT_FCAT USING 'MICDES'  'MIC Description'.
  PERFORM RPT_FCAT USING 'UOM'     'Unit'.
  PERFORM RPT_FCAT USING 'METHOD'  'Method'.
  PERFORM RPT_FCAT USING 'MICMIN'  'Lower Limit'.
  PERFORM RPT_FCAT USING 'MICMAX'  'Upper Limit'.
  PERFORM RPT_FCAT USING 'INS'     'Insp. Lot'.
  PERFORM RPT_FCAT USING 'CMICMIT' 'Value'.
  PERFORM RPT_FCAT USING 'NEW_VALUE' 'New Value'.
  CLEAR WA_LAYR.
  WA_LAYR-ZEBRA = 'X'.
  WA_LAYR-COLWIDTH_OPTIMIZE = 'X'.
  CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
    EXPORTING
      IS_LAYOUT     = WA_LAYR
      IT_FIELDCAT   = IT_FCATR
    TABLES
      T_OUTTAB      = IT_ALVR
    EXCEPTIONS
      PROGRAM_ERROR = 1
      OTHERS        = 2.
ENDFORM.                    "RPT_DISPLAY