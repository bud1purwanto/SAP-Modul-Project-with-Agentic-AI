        READ TABLE IT_INSP_DAT INTO WA_INSP_DAT WITH KEY CHARGJR = ITAB-CHARGJR POSISI = V_POSISI INSPTEXT = 'OTR' TIMES = 4 CYCLES = V_MAX_CYCLE.
        IF SY-SUBRC EQ 0.
          PERFORM GET_JUDGEMENT_STATUS USING WA_INSP_DAT-VALUE WA_MAP_INSP_CHAR-SOLLWERT WA_MAP_INSP_CHAR-TOLERANZOB WA_MAP_INSP_CHAR-TOLERANZUN CHANGING V_STATUS.
          IF V_STATUS EQ 'NOT OK'.
            ITAB-ZSTAT = ERROR.
            ITAB-ERR   = 'X'.
            ITAB-MESS  = 'This inspection is closed !'.
            V_ERR = 'X'.
            MODIFY ITAB.
            CONTINUE.
          ENDIF.
        ENDIF.
      ELSEIF ITAB-INSPECTION CS 'OTR' OR ITAB-INSPECTION CS 'O2TR'.
        CLEAR : WA_MAP_INSP_CHAR.
        READ TABLE IT_MAP_INSP_CHAR INTO WA_MAP_INSP_CHAR WITH KEY SORTFELD = 'WVTR' MATNR = ITAB-MATNR.
        V_MAX_CYCLE = WA_MAP_INSP_CHAR-STPRUMF.
        READ TABLE IT_INSP_DAT INTO WA_INSP_DAT WITH KEY CHARGJR = ITAB-CHARGJR POSISI = V_POSISI INSPTEXT = 'WVTR' TIMES = 4 CYCLES = V_MAX_CYCLE.
        IF SY-SUBRC EQ 0.
          PERFORM GET_JUDGEMENT_STATUS USING WA_INSP_DAT-VALUE WA_MAP_INSP_CHAR-SOLLWERT WA_MAP_INSP_CHAR-TOLERANZOB WA_MAP_INSP_CHAR-TOLERANZUN CHANGING V_STATUS.
          IF V_STATUS EQ 'NOT OK'.
            IF V_STATUS EQ 'NOT OK'.
              ITAB-ZSTAT = ERROR.
              ITAB-ERR   = 'X'.
              ITAB-MESS  = 'This inspection is closed !'.
              V_ERR = 'X'.
              MODIFY ITAB.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDLOOP.
  IF V_ERR = 'X'.
    CLEAR : IT_OUTPUT.
    REFRESH : IT_OUTPUT.
    APPEND LINES OF ITAB TO IT_OUTPUT.
    IF NOT G_GRID IS INITIAL.
      CALL METHOD G_GRID->REFRESH_TABLE_DISPLAY.
    ENDIF.
    LEAVE SCREEN.
  ELSE.
    READ TABLE ITAB WITH KEY BOX = 'X' ERR = ''.
    IF SY-SUBRC EQ 0.
      CALL FUNCTION 'POPUP_TO_CONFIRM'
        EXPORTING
          TITLEBAR              = 'Confirmation'
          TEXT_QUESTION         = 'Are you sure want to execute?'
          TEXT_BUTTON_1         = 'Yes'
          TEXT_BUTTON_2         = 'No'
          DEFAULT_BUTTON        = '2'
          DISPLAY_CANCEL_BUTTON = ''
        IMPORTING
          ANSWER                = V_ANSWER.
      IF V_ANSWER = 1.
        SELECT SINGLE * INTO LS_ZMAP_WORKCENTER FROM ZMAP_TYPE
               WHERE PROG = SY-REPID AND TYPE = 'BARRIER' AND OPT = 'WORKCENTER'.
        IF SY-SUBRC EQ 0.
          CALL FUNCTION 'CR_PERSONS_OF_WORKCENTER'
            EXPORTING
              ARBPL       = LS_ZMAP_WORKCENTER-VALUE
              WERKS       = LS_ZMAP_WORKCENTER-TEXT1
              DATE        = SY-DATUM
            TABLES
              OUT_PERSONS = PERSONNEL.
        ELSE.
          CALL FUNCTION 'CR_PERSONS_OF_WORKCENTER'
            EXPORTING
              ARBPL       = 'QA-Z04'
              WERKS       = 'TTE'
              DATE        = SY-DATUM
            TABLES
              OUT_PERSONS = PERSONNEL.
        ENDIF.
        IF V_SIGN[] IS INITIAL.
          V_SIGN-TABNAME    = 'PA0001'.
          V_SIGN-FIELDNAME  = 'PERNR'.
          V_SIGN-VALUE      = ''.
          APPEND V_SIGN.
        ENDIF.
        CALL FUNCTION 'POPUP_GET_VALUES'
          EXPORTING
            POPUP_TITLE    = 'Enter Employee Number'
            START_COLUMN   = '5'
            START_ROW      = '05'
            NO_VALUE_CHECK = ' '
          TABLES
            FIELDS         = V_SIGN.
        V_NIK = V_SIGN-VALUE.
        IF SY-UCOMM NE 'CANC'.
          IF V_NIK EQ 0 OR V_NIK IS INITIAL.
            MESSAGE 'Employee number must be filled' TYPE 'S' DISPLAY LIKE 'E'.
            V_ERR = 'X'.
          ELSE.
            READ TABLE PERSONNEL WITH KEY PERNR = V_NIK.
            IF SY-SUBRC NE 0.
              MESSAGE 'Employee number not assigned to this transaction' TYPE 'S' DISPLAY LIKE 'E'.
              V_ERR = 'X'.
            ENDIF.
          ENDIF.
        ELSE.
          V_ERR = 'X'.
        ENDIF.
      ELSE.
        V_ERR = 'X'.
      ENDIF.
    ELSE.
      V_ERR = 'X'.
    ENDIF.
  ENDIF.
  IT_COUNT_ROW[] = ITAB[].
  DELETE IT_COUNT_ROW WHERE BOX EQ '' OR ERR EQ 'X'.
  DESCRIBE TABLE IT_COUNT_ROW LINES V_TFILL.
ENDFORM.                    "CONFIRMATION

