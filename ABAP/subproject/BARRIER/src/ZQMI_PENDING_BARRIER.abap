*&---------------------------------------------------------------------*
*&      Form  GENERATE_ESTIMATION_DATE

*&---------------------------------------------------------------------*
FORM GENERATE_ESTIMATION_DATE TABLES T_TABLE LIKE IT_OUTPUT.
  FIELD-SYMBOLS: <FS_OUTPUT> LIKE LINE OF T_TABLE.
  CLEAR:WA_OUTPUT.
  CLEAR : IT_MAP_ESTIMATION_DATE.
  REFRESH : IT_MAP_ESTIMATION_DATE.
  SELECT * INTO TABLE IT_MAP_ESTIMATION_DATE FROM ZMAP_TYPE WHERE PROG = SY-REPID AND TYPE = 'BARRIER' AND OPT = 'ESTDATE' AND DELETION = ''.
  IF IT_MAP_ESTIMATION_DATE[] IS NOT INITIAL.
    LOOP AT T_TABLE ASSIGNING <FS_OUTPUT> WHERE INSPDATE NE ''.
      CLEAR : WA_MAP_ESTIMATION_DATE.
      READ TABLE IT_MAP_ESTIMATION_DATE INTO WA_MAP_ESTIMATION_DATE WITH KEY VALUE = <FS_OUTPUT>-INSPECTION.
      PERFORM CONVERT_DATE_INPUT USING <FS_OUTPUT>-INSPDATE CHANGING V_DATE.
      CASE <FS_OUTPUT>-TIMES.
        WHEN '1'.
          V_DATE = V_DATE + WA_MAP_ESTIMATION_DATE-TEXT1.
        WHEN '2'.
          V_DATE  = V_DATE + WA_MAP_ESTIMATION_DATE-TEXT2.
        WHEN '3'.
          V_DATE = V_DATE + WA_MAP_ESTIMATION_DATE-TEXT3.
        WHEN '4'.
          V_DATE = V_DATE + WA_MAP_ESTIMATION_DATE-TEXT4.
      ENDCASE.
      <FS_OUTPUT>-INSPDATE2 = V_DATE.
      <FS_OUTPUT>-INSPDATE = V_DATE.
    ENDLOOP.
  ENDIF.
ENDFORM.                    " GENERATE_ESTIMATION_DATE

*&---------------------------------------------------------------------*
*&      Form  POPULATE_INSPECTION_DATA

*&---------------------------------------------------------------------*
FORM POPULATE_INSPECTION_DATA .
  " JANGAN hapus/clear IT_COMPARE di sini agar data dari GET_INITIAL_DATA tetap bertahan
  CLEAR : V_TFILL, V_VALUE, IT_INSP_DAT, WA_INSP_DAT.
  REFRESH : IT_INSP_DAT.
  DESCRIBE TABLE IT_BATCHSR_SAMPLE LINES V_TFILL.
  LOOP AT IT_BATCHSR_SAMPLE.
    PERFORM SET_INDICATOR USING SY-TABIX V_TFILL 2 V_PROC_EX 'Get Inspection...'.
    PERFORM GET_INSPECTION USING IT_BATCHSR_SAMPLE-CHARGSR IT_BATCHSR_SAMPLE-MATNRSR IT_BATCHSR_SAMPLE-CHARGJR 'X'.
  ENDLOOP.
  " ... (Sisa kode di bawahnya tetap sama) ...
  FIELD-SYMBOLS: <FS_OUTPUT> LIKE LINE OF IT_OUTPUT.
  CLEAR:WA_MAP_INSP_CHAR.
  LOOP AT IT_OUTPUT ASSIGNING <FS_OUTPUT>.
    CLEAR : INSP_CHAR, INSP_MIC, INSP_VER, V_CYCLES, WA_MAP_INSP_CHAR,V_INSPTEXT, V_INSPCHAR.
    READ TABLE IT_BATCHSR_SAMPLE WITH KEY CHARGSR = <FS_OUTPUT>-CHARG.
    CLEAR : WA_MAP_INSP_CHAR.
    LOOP AT IT_MAP_INSP_CHAR INTO WA_MAP_INSP_CHAR WHERE MATNR = IT_BATCHSR_SAMPLE-MATNRSR.
      IF WA_MAP_INSP_CHAR-VERWMERKM CS 'WVTR' OR WA_MAP_INSP_CHAR-VERWMERKM CS 'MVTR'.
        <FS_OUTPUT>-WVTR_CHAR    = WA_MAP_INSP_CHAR-MERKNR.
        <FS_OUTPUT>-WVTR_MIC     = WA_MAP_INSP_CHAR-VERWMERKM.
        <FS_OUTPUT>-WVTR_VERSION = WA_MAP_INSP_CHAR-MKVERSION.
      ELSEIF WA_MAP_INSP_CHAR-VERWMERKM CS 'OTR' OR WA_MAP_INSP_CHAR-VERWMERKM CS 'O2TR'.
        <FS_OUTPUT>-OTR_CHAR     = WA_MAP_INSP_CHAR-MERKNR.
        <FS_OUTPUT>-OTR_MIC      = WA_MAP_INSP_CHAR-VERWMERKM.
        <FS_OUTPUT>-OTR_VERSION  = WA_MAP_INSP_CHAR-MKVERSION.
      ENDIF.
    ENDLOOP.
    IF <FS_OUTPUT>-INSPECTION CS 'WVTR' OR <FS_OUTPUT>-INSPECTION CS 'MVTR'.
      V_INSPTEXT = <FS_OUTPUT>-WVTR_MIC.
      V_INSPCHAR = <FS_OUTPUT>-WVTR_CHAR.
    ELSEIF <FS_OUTPUT>-INSPECTION CS 'OTR' OR <FS_OUTPUT>-INSPECTION CS 'O2TR'.
      V_INSPTEXT = <FS_OUTPUT>-OTR_MIC.
      V_INSPCHAR = <FS_OUTPUT>-OTR_CHAR.
    ENDIF.
    CLEAR : V_TFILL.
    DESCRIBE TABLE IT_INSP_DAT LINES V_TFILL.
    LOOP AT IT_INSP_DAT INTO WA_INSP_DAT WHERE CHARGJR = <FS_OUTPUT>-CHARGJR AND TIMES = <FS_OUTPUT>-TIMES AND POSISI CS <FS_OUTPUT>-POSISI AND MASTERINSP CS V_INSPTEXT.
      PERFORM SET_INDICATOR USING SY-TABIX V_TFILL 3 V_PROC_EX 'Get Status...'.
      CLEAR : WA_MAP_INSP_CHAR.
      LOOP AT IT_MAP_INSP_CHAR INTO WA_MAP_INSP_CHAR WHERE  MKMNR = WA_INSP_DAT-MASTERINSP AND MERKNR EQ WA_INSP_DAT-INSPTYPE.
        CASE WA_INSP_DAT-CYCLES.
          WHEN 1.
            <FS_OUTPUT>-VALUE1 = WA_INSP_DAT-VALUE.
          WHEN 2.
            <FS_OUTPUT>-VALUE2 = WA_INSP_DAT-VALUE.
          WHEN 3.
            <FS_OUTPUT>-VALUE3 = WA_INSP_DAT-VALUE.
          WHEN 4.
            <FS_OUTPUT>-VALUE4 = WA_INSP_DAT-VALUE.
        ENDCASE.
        <FS_OUTPUT>-STATUS = 'OK'.
        IF WA_INSP_DAT-VALUE < WA_MAP_INSP_CHAR-TOLERANZUN OR WA_INSP_DAT-VALUE > WA_MAP_INSP_CHAR-TOLERANZOB.
          <FS_OUTPUT>-STATUS = 'NOT OK'.
        ENDIF.
      ENDLOOP.
      <FS_OUTPUT>-PRUEFLOS = WA_INSP_DAT-INSPLOT.
      <FS_OUTPUT>-AUFPL    = WA_INSP_DAT-AUFPL.
      <FS_OUTPUT>-WERKS    = WA_INSP_DAT-PLANT.
      <FS_OUTPUT>-APRV_STATUS = WA_INSP_DAT-STATUS.
      IF <FS_OUTPUT>-INSPECTION CS 'WVTR' OR <FS_OUTPUT>-INSPECTION CS 'MVTR'.
        <FS_OUTPUT>-APRV_STATUS2 = WA_INSP_DAT-STATUS(2).
      ELSEIF <FS_OUTPUT>-INSPECTION CS 'OTR' OR <FS_OUTPUT>-INSPECTION CS 'O2TR'.
        <FS_OUTPUT>-APRV_STATUS2 = WA_INSP_DAT-STATUS+2(2).
      ENDIF.
      CASE <FS_OUTPUT>-APRV_STATUS2.
        WHEN 'NG'.
          <FS_OUTPUT>-APRV_STATUS2 = 'REJECTED'.
        WHEN 'OK'.
          <FS_OUTPUT>-APRV_STATUS2 = 'APPROVED'.
        WHEN 'NO'.
          <FS_OUTPUT>-APRV_STATUS2 = 'CREATED'.
      ENDCASE.
      SELECT QASE~PRUEFLOS MERKNR PROBENR STUECKNR MESSWERT MBEWERTG PRUEFDATUV AS BUDAT ATTRIBUT
        APPENDING CORRESPONDING FIELDS OF TABLE IT_COMPARE
        FROM QASE
        JOIN QALS ON QALS~PRUEFLOS = QASE~PRUEFLOS
       WHERE QASE~PRUEFLOS EQ WA_INSP_DAT-INSPLOT.
    ENDLOOP.
    READ TABLE IT_BATCHSR_SAMPLE WITH KEY CHARGSR = <FS_OUTPUT>-CHARG.
    IF SY-SUBRC EQ 0.
      <FS_OUTPUT>-MATNR    = IT_BATCHSR_SAMPLE-MATNRSR.
      <FS_OUTPUT>-WERKS    = IT_BATCHSR_SAMPLE-WERKS.
    ENDIF.
    CASE <FS_OUTPUT>-POSISI.
      WHEN 'R'.
        <FS_OUTPUT>-SORT_KEY = 1.
      WHEN 'C'.
        <FS_OUTPUT>-SORT_KEY = 2.
      WHEN 'L'.
        <FS_OUTPUT>-SORT_KEY = 3.
    ENDCASE.
    SELECT SINGLE ZZPROLL INTO <FS_OUTPUT>-ROLL_INSP FROM QALS WHERE PRUEFLOS EQ <FS_OUTPUT>-PRUEFLOS.
    IF <FS_OUTPUT>-ROLL_INSP IS NOT INITIAL.
      IF <FS_OUTPUT>-ROLL_INSP NE <FS_OUTPUT>-ROLL.
        CONCATENATE 'Inpection Lot position' <FS_OUTPUT>-POSISI 'used in JR' <FS_OUTPUT>-ROLL_INSP 'while now JR is' <FS_OUTPUT>-ROLL INTO V_MESSAGE SEPARATED BY SPACE.
        <FS_OUTPUT>-MESS  = V_MESSAGE.
        <FS_OUTPUT>-ZSTAT = WARNING.
      ENDIF.
    ENDIF.
  ENDLOOP.

  " Filter out invalidated records (ATTRIBUT = '/')
  DATA: LV_INVALID TYPE FLAG,
        WA_OUT     LIKE LINE OF IT_OUTPUT,
        WA_COMP    LIKE LINE OF IT_COMPARE.
  LOOP AT IT_OUTPUT INTO WA_OUT.
    LV_INVALID = ''.
    LOOP AT IT_COMPARE INTO WA_COMP WHERE PRUEFLOS = WA_OUT-PRUEFLOS
                                      AND PROBENR  = WA_OUT-TIMES
                                      AND ( MERKNR = WA_OUT-WVTR_CHAR OR MERKNR = WA_OUT-OTR_CHAR ).
      IF WA_COMP-ATTRIBUT EQ '/'.
        LV_INVALID = 'X'.
        EXIT.
      ENDIF.
    ENDLOOP.
    IF LV_INVALID EQ 'X'.
      DELETE IT_OUTPUT.
    ENDIF.
  ENDLOOP.

ENDFORM.                    "POPULATE_INSPECTION_DATA

*&---------------------------------------------------------------------*
*&      Form  GET_JUDGEMENT_STATUS

*&---------------------------------------------------------------------*
FORM GET_JUDGEMENT_STATUS  USING    INSP_VAL
                                    SHIP_LEVEL
                                    CUST_LEVEL
                                    MANGT_LEVEL
                           CHANGING STATUS.
  STATUS = 'OK'.
  IF INSP_VAL < MANGT_LEVEL OR INSP_VAL > CUST_LEVEL .
    STATUS = 'NOT OK'.
  ENDIF.
ENDFORM.                    " GET_JUDGEMENT_STATUS

*&---------------------------------------------------------------------*
*&      Form  UPDATE_JUDGEMENT

*&---------------------------------------------------------------------*
FORM UPDATE_JUDGEMENT.
  CALL METHOD G_GRID->REFRESH_TABLE_DISPLAY.
  CLEAR : ITAB, V_ERR .
  REFRESH : ITAB.
  LOOP AT IT_OUTPUT INTO WA_OUTPUT.
    WA_OUTPUT-ZSTAT = GREY.
    WA_OUTPUT-BOX = ''.
    WA_OUTPUT-ERR = ''.
    WA_OUTPUT-MESS = ''.
    MODIFY IT_OUTPUT FROM WA_OUTPUT INDEX SY-TABIX.
  ENDLOOP.
  LOOP AT LT_ROW_NO.
    READ TABLE IT_OUTPUT INTO WA_OUTPUT INDEX LT_ROW_NO-ROW_ID.
    WA_OUTPUT-BOX = 'X'.
    " --- NEW: Cek apakah Lot punya UD sebelumnya ---
    IF WA_OUTPUT-PRUEFLOS IS NOT INITIAL.
      SELECT SINGLE STAT35 INTO WA_OUTPUT-HAS_UD FROM QALS WHERE PRUEFLOS = WA_OUTPUT-PRUEFLOS.
      IF WA_OUTPUT-HAS_UD EQ 'X'.
        SELECT SINGLE VCODE VCODEGRP VAUSWAHLMG
          INTO (WA_OUTPUT-OLD_UD, WA_OUTPUT-OLD_CODEGRP,
                WA_OUTPUT-OLD_SELECTED_SET)
          FROM QAVE
          WHERE PRUEFLOS = WA_OUTPUT-PRUEFLOS.
      ENDIF.
    ENDIF.
    " -----------------------------------------------
    MODIFY IT_OUTPUT FROM WA_OUTPUT INDEX LT_ROW_NO-ROW_ID.
  ENDLOOP.
  APPEND LINES OF IT_OUTPUT TO ITAB.
  PERFORM CONFIRMATION.
  IF V_ERR NE 'X'.
    PERFORM RESULT_RECORDING.
    DATA L_TMP_MERKNR TYPE QMERKNR.
    DATA L_INSPSAMPLE2 LIKE BAPI2045D4-INSPSAMPLE.
    DATA L_INSPSAMPLE LIKE BAPI2045D4-INSPSAMPLE.

    PERFORM PROCESS_DELAYING.
    PERFORM USAGE_DECISION.
    PERFORM REFRESH.
    PERFORM CHECK_ERROR.

    " --- NEW: Auto update ALV after transaction ---
    CLEAR : IT_OUTPUT.
    REFRESH : IT_OUTPUT.
    APPEND LINES OF ITAB TO IT_OUTPUT.
    " ----------------------------------------------
  ENDIF.
ENDFORM.                    " UPDATE_JUDGEMENT

*&---------------------------------------------------------------------*
*&      Form  GET_DATA_PREVIEW

*&---------------------------------------------------------------------*
*&---------------------------------------------------------------------*
*&      Form  GET_DATA_PREVIEW
*&---------------------------------------------------------------------*
*&---------------------------------------------------------------------*
*&      Form  GET_DATA_PREVIEW
*&---------------------------------------------------------------------*
FORM GET_DATA_PREVIEW.
  DATA: LT_ROLL_PARTS TYPE TABLE OF STRING,
        LV_ROLL_PART  TYPE STRING,
        LV_PART_COUNT TYPE I,
        LV_LEN        TYPE I.
  DATA: V_CODEWVTR TYPE STRING, V_CODEOTR TYPE STRING.
  DATA: LV_V1 TYPE STRING, LV_V2 TYPE STRING, LV_V3 TYPE STRING, LV_V4 TYPE STRING.
  DATA: LV_TYPE_T    TYPE ATWRT,
        LV_ALIAS     TYPE ATWRT,
        LV_THICK_P   TYPE P DECIMALS 2,
        LV_THICK_I   TYPE I,
        LV_THICK_STR TYPE C LENGTH 15.

  REFRESH: IT_COMPARE, ITAB, IT_INSP_DAT, IT_MAP_INSP_CHAR.
  CLEAR: IT_COMPARE, V_MATEXCLUDE, IT_INSP_DAT, WA_INSP_DAT, WA_MAP_INSP_CHAR.
  SORT IT_UPLOAD BY ROLL INSPDATE TYPE TIMES ASCENDING.

  TYPES: BEGIN OF TY_BATCH_SR,
           ATWRT    TYPE AUSP-ATWRT,
           MATNR    TYPE MCH1-MATNR,
           CHARG    TYPE MCH1-CHARG,
           CUOBJ_BM TYPE MCH1-CUOBJ_BM,
         END OF TY_BATCH_SR.
  DATA: LT_BATCH_SR TYPE TABLE OF TY_BATCH_SR,
        LS_BATCH_SR TYPE TY_BATCH_SR.

  TYPES: BEGIN OF TY_CHAR_BULK,
           CHARG TYPE MCH1-CHARG,
           ATINN TYPE AUSP-ATINN,
           ATWRT TYPE AUSP-ATWRT,
           ATFLV TYPE AUSP-ATFLV,
         END OF TY_CHAR_BULK.
  DATA: LT_CHAR_BULK TYPE TABLE OF TY_CHAR_BULK,
        LS_CHAR_BULK TYPE TY_CHAR_BULK.

  TYPES: BEGIN OF TY_JR_CACHE,
           CHARG_S TYPE CHARG_D,
           CHARG_J TYPE CHARG_D,
           MATNR_J TYPE MATNR,
         END OF TY_JR_CACHE.
  DATA: LT_JR_CACHE TYPE TABLE OF TY_JR_CACHE,
        LS_JR_CACHE TYPE TY_JR_CACHE.

  TYPES: BEGIN OF TY_QALS_BULK,
           PRUEFLOS  TYPE QALS-PRUEFLOS,
           CHARG     TYPE QALS-CHARG,
           MATNR     TYPE QALS-MATNR,
           WERK      TYPE QALS-WERK,
           AUFPL     TYPE QALS-AUFPL,
           ZZPROLL   TYPE QALS-ZZPROLL,
           ENSTEHDAT TYPE QALS-ENSTEHDAT,
         END OF TY_QALS_BULK.
  DATA: LT_QALS_BULK TYPE TABLE OF TY_QALS_BULK,
        LS_QALS_BULK TYPE TY_QALS_BULK.

  TYPES: BEGIN OF TY_QAMV_BULK,
           PRUEFLOS  TYPE QAMV-PRUEFLOS,
           MERKNR    TYPE QAMV-MERKNR,
           VERWMERKM TYPE QAMV-VERWMERKM,
           MKVERSION TYPE QAMV-MKVERSION,
           KURZTEXT  TYPE QAMV-KURZTEXT,
         END OF TY_QAMV_BULK.
  DATA: LT_QAMV_BULK TYPE TABLE OF TY_QAMV_BULK,
        LS_QAMV_BULK TYPE TY_QAMV_BULK.

  IF V_ZZNOMORROLL IS INITIAL.
    PERFORM GET_ATINN USING 'ZZNOMORROLL' CHANGING V_ZZNOMORROLL.
  ENDIF.
  IF V_ZZTYPE IS INITIAL.
    PERFORM GET_ATINN USING 'ZZTYPE' CHANGING V_ZZTYPE.
  ENDIF.
  IF V_ZZTHICK IS INITIAL.
    PERFORM GET_ATINN USING 'ZZTHICKNESS' CHANGING V_ZZTHICK.
  ENDIF.
  IF V_ZZTOUCH IS INITIAL.
    PERFORM GET_ATINN USING 'ZZSPECIALTOUCH-1' CHANGING V_ZZTOUCH.
  ENDIF.
  IF V_ZZALIAS IS INITIAL.
    PERFORM GET_ATINN USING 'ZZALIAS' CHANGING V_ZZALIAS.
  ENDIF.

  " --- BACKWARD COMPATIBILITY: resolve CHARG from ROLL if old template uploaded ---
  IF IT_UPLOAD[] IS NOT INITIAL.
    READ TABLE IT_UPLOAD INDEX 1.
    IF IT_UPLOAD-CHARG IS INITIAL AND IT_UPLOAD-ROLL IS NOT INITIAL.
      SELECT AUSP~ATWRT MCH1~MATNR MCH1~CHARG MCH1~CUOBJ_BM
        INTO TABLE LT_BATCH_SR
        FROM MCH1
        JOIN AUSP ON AUSP~OBJEK = MCH1~CUOBJ_BM
        FOR ALL ENTRIES IN IT_UPLOAD
       WHERE AUSP~ATWRT = IT_UPLOAD-ROLL
         AND AUSP~KLART = '023'
         AND AUSP~MAFID = 'O'
         AND AUSP~ATINN = V_ZZNOMORROLL.
      SORT LT_BATCH_SR BY ATWRT.
      LOOP AT IT_UPLOAD.
        READ TABLE LT_BATCH_SR INTO LS_BATCH_SR WITH KEY ATWRT = IT_UPLOAD-ROLL BINARY SEARCH.
        IF SY-SUBRC = 0.
          IT_UPLOAD-CHARG = LS_BATCH_SR-CHARG.
          IT_UPLOAD-MATNR = LS_BATCH_SR-MATNR.
          MODIFY IT_UPLOAD.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDIF.

  " --- 1. BULK GET QALS (INSPECTION LOT) DIRECTLY FROM BATCH SR ---
  IF IT_UPLOAD[] IS NOT INITIAL.
    SELECT PRUEFLOS CHARG MATNR WERK AUFPL ZZPROLL ENSTEHDAT
      INTO TABLE LT_QALS_BULK
      FROM QALS
      FOR ALL ENTRIES IN IT_UPLOAD
     WHERE CHARG = IT_UPLOAD-CHARG.
    SORT LT_QALS_BULK BY CHARG ENSTEHDAT DESCENDING PRUEFLOS DESCENDING.
    DELETE ADJACENT DUPLICATES FROM LT_QALS_BULK COMPARING CHARG.
  ENDIF.

  " --- 2. BULK GET CLASSIFICATION (ROLL SR, TYPE, THICK, TOUCH) DIRECTLY FROM BATCH SR ---
  IF IT_UPLOAD[] IS NOT INITIAL.
    SELECT MCH1~CHARG AUSP~ATINN AUSP~ATWRT AUSP~ATFLV
      INTO CORRESPONDING FIELDS OF TABLE LT_CHAR_BULK
      FROM MCH1
      JOIN AUSP ON AUSP~OBJEK = MCH1~CUOBJ_BM
      FOR ALL ENTRIES IN IT_UPLOAD
     WHERE MCH1~CHARG = IT_UPLOAD-CHARG
       AND AUSP~KLART = '023'
       AND ( AUSP~ATINN = V_ZZTYPE OR
             AUSP~ATINN = V_ZZNOMORROLL OR
             AUSP~ATINN = V_ZZTHICK OR
             AUSP~ATINN = V_ZZTOUCH OR
             AUSP~ATINN = V_ZZALIAS ).
    SORT LT_CHAR_BULK BY CHARG ATINN.
    DELETE ADJACENT DUPLICATES FROM LT_CHAR_BULK COMPARING CHARG ATINN.
  ENDIF.

  " --- 3. BULK GET QAMV (LOT CHARACTERISTICS) ---
  IF LT_QALS_BULK[] IS NOT INITIAL.
    SELECT PRUEFLOS MERKNR VERWMERKM MKVERSION KURZTEXT
      INTO TABLE LT_QAMV_BULK
      FROM QAMV
      FOR ALL ENTRIES IN LT_QALS_BULK
     WHERE PRUEFLOS = LT_QALS_BULK-PRUEFLOS.
    SORT LT_QAMV_BULK BY PRUEFLOS MERKNR.
  ENDIF.

  " --- 4. BULK GET ROUTING MASTER CHARACTERISTICS (MAPL + PLKO + PLMK + QDSV) ---
  IF LT_QALS_BULK[] IS NOT INITIAL.
    SELECT MAPL~MATNR PLMK~MERKNR PLMK~VERWMERKM PLMK~MKVERSION QDSV~STPRUMF
           QPMK_ZAEHL AS ZAEHLER PLMK~VERWMERKM AS MKMNR KURZTEXT AS SORTFELD
           SOLLWERT TOLERANZOB TOLERANZUN DELKZ PRUEFEINH
      INTO CORRESPONDING FIELDS OF TABLE IT_MAP_INSP_CHAR
      FROM MAPL
      JOIN PLKO ON PLKO~PLNTY EQ MAPL~PLNTY AND PLKO~PLNNR EQ MAPL~PLNNR AND PLKO~PLNAL EQ MAPL~PLNAL
      JOIN PLMK ON PLKO~PLNTY EQ PLMK~PLNTY AND PLKO~PLNNR EQ PLMK~PLNNR AND PLKO~ZAEHL EQ PLMK~PLNKN
      JOIN QDSV ON PLMK~STICHPRVER EQ QDSV~STICHPRVER
      FOR ALL ENTRIES IN LT_QALS_BULK
     WHERE MAPL~WERKS EQ LT_QALS_BULK-WERK
       AND MAPL~MATNR EQ LT_QALS_BULK-MATNR
       AND PLKO~KTEXT LIKE '%After Slitting%'
       AND MAPL~LOEKZ NE 'X'.
    SORT IT_MAP_INSP_CHAR BY MATNR VERWMERKM.
  ENDIF.

  " --- 5. BULK GET QASE (EXISTING RESULTS) ---
  IF LT_QALS_BULK[] IS NOT INITIAL.
    SELECT PRUEFLOS MERKNR PROBENR STUECKNR MESSWERT MBEWERTG PRUEFDATUV AS BUDAT ATTRIBUT
      INTO CORRESPONDING FIELDS OF TABLE IT_COMPARE
      FROM QASE
      FOR ALL ENTRIES IN LT_QALS_BULK
     WHERE PRUEFLOS = LT_QALS_BULK-PRUEFLOS.
    SORT IT_COMPARE BY PRUEFLOS MERKNR PROBENR STUECKNR.
  ENDIF.

  " --- 6. MAIN LOOP: IN-MEMORY PROCESSING (DIRECT FROM BATCH SR) ---
  CLEAR: LT_JR_CACHE.
  LOOP AT IT_UPLOAD.
    CLEAR: IT_QASE, IT_WVTR, IT_OTR, V_PRUEFLOS, INSP_CHAR, V_DATE.
    REFRESH: IT_QASE, IT_WVTR, IT_OTR.
    V_MINCYCLE = 1.
    REPLACE ALL OCCURRENCES OF '/' IN IT_UPLOAD-INSPDATE WITH '.'.
    IF IT_UPLOAD-INSPDATE2 IS INITIAL OR IT_UPLOAD-INSPDATE2 EQ ''.
      PERFORM CONVERT_DATE_INPUT USING IT_UPLOAD-INSPDATE CHANGING IT_UPLOAD-INSPDATE2.
    ENDIF.
    MOVE-CORRESPONDING IT_UPLOAD TO ITAB.
    ITAB-ZSTAT = GREY.

    " Set Batch SR (ensure 10 digits leading zeroes if numeric)
    ITAB-CHARG = IT_UPLOAD-CHARG.
    IF ITAB-CHARG CO '0123456789' AND ITAB-CHARG IS NOT INITIAL AND STRLEN( ITAB-CHARG ) < 10.
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          INPUT  = ITAB-CHARG
        IMPORTING
          OUTPUT = ITAB-CHARG.
    ENDIF.

    " 1. Map QALS (Inspection Lot) & Inspection Date from QALS
    READ TABLE LT_QALS_BULK INTO LS_QALS_BULK WITH KEY CHARG = ITAB-CHARG BINARY SEARCH.
    IF SY-SUBRC = 0.
      ITAB-PRUEFLOS  = LS_QALS_BULK-PRUEFLOS.
      ITAB-MATNR     = LS_QALS_BULK-MATNR.
      ITAB-WERKS     = LS_QALS_BULK-WERK.
      ITAB-AUFPL     = LS_QALS_BULK-AUFPL.
      ITAB-ROLL_INSP = LS_QALS_BULK-ZZPROLL.
      IF LS_QALS_BULK-ENSTEHDAT IS NOT INITIAL AND LS_QALS_BULK-ENSTEHDAT <> '00000000'.
        ITAB-INSPDATE  = LS_QALS_BULK-ENSTEHDAT.
        ITAB-INSPDATE2 = LS_QALS_BULK-ENSTEHDAT.
      ENDIF.
    ENDIF.

    " 2. Roll SR Characteristic from Batch SR (ZZNOMORROLL)
    READ TABLE LT_CHAR_BULK INTO LS_CHAR_BULK
      WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZNOMORROLL BINARY SEARCH.
    IF SY-SUBRC = 0.
      ITAB-ROLL = LS_CHAR_BULK-ATWRT.
    ENDIF.
    IF ITAB-ROLL IS INITIAL AND ITAB-ROLL_INSP IS NOT INITIAL.
      ITAB-ROLL = ITAB-ROLL_INSP.
    ENDIF.

    " 3. Roll JR, Position, Times from ROLL
    IF ITAB-ROLL IS NOT INITIAL.
      CLEAR: LT_ROLL_PARTS, ITAB-ROLL_JR.
      SPLIT ITAB-ROLL AT SPACE INTO TABLE LT_ROLL_PARTS.
      DESCRIBE TABLE LT_ROLL_PARTS LINES LV_PART_COUNT.
      LOOP AT LT_ROLL_PARTS INTO LV_ROLL_PART.
        IF SY-TABIX <= 4.
          IF ITAB-ROLL_JR IS INITIAL.
            ITAB-ROLL_JR = LV_ROLL_PART.
          ELSE.
            CONCATENATE ITAB-ROLL_JR LV_ROLL_PART INTO ITAB-ROLL_JR SEPARATED BY SPACE.
          ENDIF.
        ELSE.
          EXIT.
        ENDIF.
      ENDLOOP.
      IF LV_PART_COUNT >= 7.
        READ TABLE LT_ROLL_PARTS INTO LV_ROLL_PART INDEX 5.
        LV_LEN = STRLEN( LV_ROLL_PART ) - 1.
        IF LV_LEN >= 0.
          ITAB-POSISI = LV_ROLL_PART+LV_LEN(1).
        ENDIF.
        READ TABLE LT_ROLL_PARTS INTO LV_ROLL_PART INDEX 7.
        IF LV_ROLL_PART CO '0123456789'.
          ITAB-TIMES = LV_ROLL_PART.
        ENDIF.
      ENDIF.
    ENDIF.

    REPLACE ALL OCCURRENCES OF '|' IN ITAB-POSISI WITH SPACE.
    CASE ITAB-POSISI.
      WHEN 'R'. ITAB-SORT_KEY = 1.
      WHEN 'C'. ITAB-SORT_KEY = 2.
      WHEN 'L'. ITAB-SORT_KEY = 3.
    ENDCASE.

    " 4. Batch Jumbo Roll from Function ZQM_GET_BATCH_JR_BY_SR
    READ TABLE LT_JR_CACHE INTO LS_JR_CACHE WITH KEY CHARG_S = ITAB-CHARG BINARY SEARCH.
    IF SY-SUBRC <> 0.
      CLEAR: LS_JR_CACHE.
      LS_JR_CACHE-CHARG_S = ITAB-CHARG.
      CALL FUNCTION 'ZQM_GET_BATCH_JR_BY_SR'
        EXPORTING
          CHARG_S = ITAB-CHARG
        IMPORTING
          MATNR_J = LS_JR_CACHE-MATNR_J
          CHARG_J = LS_JR_CACHE-CHARG_J.
      IF LS_JR_CACHE-CHARG_J IS INITIAL.
        READ TABLE LT_CHAR_BULK INTO LS_CHAR_BULK
          WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZTOUCH BINARY SEARCH.
        IF SY-SUBRC = 0 AND LS_CHAR_BULK-ATWRT IS NOT INITIAL.
          LS_JR_CACHE-CHARG_J = LS_CHAR_BULK-ATWRT.
        ENDIF.
      ENDIF.
      IF LS_JR_CACHE-CHARG_J IS INITIAL AND ITAB-MATNR(2) = 'JR'.
        LS_JR_CACHE-CHARG_J = ITAB-CHARG.
        LS_JR_CACHE-MATNR_J = ITAB-MATNR.
      ENDIF.
      INSERT LS_JR_CACHE INTO TABLE LT_JR_CACHE.
    ENDIF.
    ITAB-CHARGJR = LS_JR_CACHE-CHARG_J.

    " 5. Kolom TYPE: Prioritas ALIAS (jika tidak ada, baru TYPE + THICK)
    CLEAR: LV_ALIAS, LV_TYPE_T, LV_THICK_P, LV_THICK_I, LV_THICK_STR.
    READ TABLE LT_CHAR_BULK INTO LS_CHAR_BULK
      WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZALIAS BINARY SEARCH.
    IF SY-SUBRC = 0 AND LS_CHAR_BULK-ATWRT IS NOT INITIAL.
      LV_ALIAS = LS_CHAR_BULK-ATWRT.
    ENDIF.

    CLEAR ITAB-TYPE.
    IF LV_ALIAS IS NOT INITIAL.
      ITAB-TYPE = LV_ALIAS.
    ELSE.
      READ TABLE LT_CHAR_BULK INTO LS_CHAR_BULK
        WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZTYPE BINARY SEARCH.
      IF SY-SUBRC = 0.
        LV_TYPE_T = LS_CHAR_BULK-ATWRT.
      ENDIF.
      READ TABLE LT_CHAR_BULK INTO LS_CHAR_BULK
        WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZTHICK BINARY SEARCH.
      IF SY-SUBRC = 0.
        ITAB-THICK   = LS_CHAR_BULK-ATFLV.
        LV_THICK_P   = LS_CHAR_BULK-ATFLV.
        LV_THICK_I   = LS_CHAR_BULK-ATFLV.
        IF LV_THICK_P = LV_THICK_I.
          LV_THICK_STR = LV_THICK_I.
        ELSE.
          LV_THICK_STR = LV_THICK_P.
        ENDIF.
        CONDENSE LV_THICK_STR.
      ENDIF.

      IF LV_TYPE_T IS NOT INITIAL AND LV_THICK_STR IS NOT INITIAL.
        CONCATENATE LV_TYPE_T '-' LV_THICK_STR INTO ITAB-TYPE.
      ELSEIF LV_TYPE_T IS NOT INITIAL.
        ITAB-TYPE = LV_TYPE_T.
      ELSEIF LV_THICK_STR IS NOT INITIAL.
        ITAB-TYPE = LV_THICK_STR.
      ENDIF.
    ENDIF.

    CONCATENATE 'S' ITAB-MATNR+2(3) 'WVTR' INTO V_CODEWVTR.
    CONCATENATE 'S' ITAB-MATNR+2(3) 'OTR' INTO V_CODEOTR.

    " Check roll position discrepancy warning
    IF ITAB-ROLL_INSP IS NOT INITIAL AND ITAB-ROLL IS NOT INITIAL
       AND ITAB-ROLL_INSP NE ITAB-ROLL.
      CONCATENATE 'Inpection Lot position' ITAB-POSISI 'used in JR' ITAB-ROLL_INSP 'while now JR is' ITAB-ROLL INTO V_MESSAGE SEPARATED BY SPACE.
      ITAB-MESS  = V_MESSAGE.
      ITAB-ZSTAT = WARNING.
    ENDIF.

    " Match Characteristic from QAMV or Master Routing
    IF ITAB-PRUEFLOS IS NOT INITIAL.
      LOOP AT LT_QAMV_BULK INTO LS_QAMV_BULK WHERE PRUEFLOS = ITAB-PRUEFLOS.
        IF LS_QAMV_BULK-VERWMERKM CS 'WVTR' OR LS_QAMV_BULK-VERWMERKM CS 'MVTR'.
          ITAB-WVTR_CHAR    = LS_QAMV_BULK-MERKNR.
          ITAB-WVTR_MIC     = LS_QAMV_BULK-VERWMERKM.
          ITAB-WVTR_VERSION = LS_QAMV_BULK-MKVERSION.
        ELSEIF LS_QAMV_BULK-VERWMERKM CS 'OTR' OR LS_QAMV_BULK-VERWMERKM CS 'O2TR'.
          ITAB-OTR_CHAR    = LS_QAMV_BULK-MERKNR.
          ITAB-OTR_MIC     = LS_QAMV_BULK-VERWMERKM.
          ITAB-OTR_VERSION = LS_QAMV_BULK-MKVERSION.
        ENDIF.
        IF LS_QAMV_BULK-VERWMERKM CS ITAB-INSPECTION OR LS_QAMV_BULK-VERWMERKM CS ITAB-TYPE.
          ITAB-MERKNR = LS_QAMV_BULK-MERKNR.
        ENDIF.
      ENDLOOP.
    ELSE.
      LOOP AT IT_MAP_INSP_CHAR INTO WA_MAP_INSP_CHAR WHERE MATNR = ITAB-MATNR.
        IF WA_MAP_INSP_CHAR-VERWMERKM CS 'WVTR' OR WA_MAP_INSP_CHAR-VERWMERKM CS 'MVTR'.
          ITAB-WVTR_CHAR    = WA_MAP_INSP_CHAR-MERKNR.
          ITAB-WVTR_MIC     = WA_MAP_INSP_CHAR-VERWMERKM.
          ITAB-WVTR_VERSION = WA_MAP_INSP_CHAR-MKVERSION.
        ELSEIF WA_MAP_INSP_CHAR-VERWMERKM CS 'OTR' OR WA_MAP_INSP_CHAR-VERWMERKM CS 'O2TR'.
          ITAB-OTR_CHAR    = WA_MAP_INSP_CHAR-MERKNR.
          ITAB-OTR_MIC     = WA_MAP_INSP_CHAR-VERWMERKM.
          ITAB-OTR_VERSION = WA_MAP_INSP_CHAR-MKVERSION.
        ENDIF.
        IF WA_MAP_INSP_CHAR-VERWMERKM CS ITAB-INSPECTION OR WA_MAP_INSP_CHAR-VERWMERKM CS ITAB-TYPE.
          ITAB-MERKNR = WA_MAP_INSP_CHAR-MERKNR.
        ENDIF.
      ENDLOOP.
    ENDIF.

    IF ITAB-MERKNR IS INITIAL.
      IF ITAB-INSPECTION CS 'WVTR' OR ITAB-INSPECTION CS 'MVTR'.
        ITAB-MERKNR = ITAB-WVTR_CHAR.
      ELSEIF ITAB-INSPECTION CS 'OTR' OR ITAB-INSPECTION CS 'O2TR'.
        ITAB-MERKNR = ITAB-OTR_CHAR.
      ENDIF.
    ENDIF.

    " Get Cycle limit STPRUMF from master routing
    READ TABLE IT_MAP_INSP_CHAR INTO WA_MAP_INSP_CHAR WITH KEY MATNR = ITAB-MATNR VERWMERKM = ITAB-WVTR_MIC.
    IF SY-SUBRC NE 0.
      READ TABLE IT_MAP_INSP_CHAR INTO WA_MAP_INSP_CHAR WITH KEY MATNR = ITAB-MATNR VERWMERKM = ITAB-OTR_MIC.
    ENDIF.
    IF SY-SUBRC EQ 0 AND WA_MAP_INSP_CHAR-STPRUMF IS NOT INITIAL.
      ITAB-CYCLE = WA_MAP_INSP_CHAR-STPRUMF.
    ENDIF.

    " Coloring Column
    IF ITAB-WVTR_CHAR IS NOT INITIAL AND ITAB-OTR_CHAR IS NOT INITIAL.
      V_MINCYCLE = 1.
      WHILE V_MINCYCLE LE 4.
        PERFORM GENERATE_COLUMN_NAME USING ITAB-INSPECTION ITAB-PRUEFLOS ITAB-TIMES V_MINCYCLE.
        ADD 1 TO V_MINCYCLE.
      ENDWHILE.
    ENDIF.

    " Check Exclude
    LOOP AT IT_COMPARE WHERE PRUEFLOS = ITAB-PRUEFLOS AND MERKNR = ITAB-MERKNR.
      IF IT_COMPARE-ATTRIBUT IS NOT INITIAL AND IT_COMPARE-ATTRIBUT NE ' '.
        V_EXCLUDE = 'X'.
        EXIT.
      ENDIF.
    ENDLOOP.

    " Calculate Last Value and Status
    CLEAR: WA_MAP_INSP_CHAR.
    READ TABLE IT_MAP_INSP_CHAR WITH KEY MERKNR = ITAB-MERKNR INTO WA_MAP_INSP_CHAR.

    LV_V4 = ITAB-VALUE4. CONDENSE LV_V4.
    LV_V3 = ITAB-VALUE3. CONDENSE LV_V3.
    LV_V2 = ITAB-VALUE2. CONDENSE LV_V2.
    LV_V1 = ITAB-VALUE1. CONDENSE LV_V1.

    IF LV_V4 NE '' AND LV_V4 NE '0.000'.
      ITAB-LAST_VALUE = ITAB-VALUE4.
    ELSEIF LV_V3 NE '' AND LV_V3 NE '0.000'.
      ITAB-LAST_VALUE = ITAB-VALUE3.
    ELSEIF LV_V2 NE '' AND LV_V2 NE '0.000'.
      ITAB-LAST_VALUE = ITAB-VALUE2.
    ELSEIF LV_V1 NE '' AND LV_V1 NE '0.000'.
      ITAB-LAST_VALUE = ITAB-VALUE1.
    ELSE.
      CLEAR ITAB-LAST_VALUE.
    ENDIF.

    IF ITAB-LAST_VALUE IS NOT INITIAL AND ITAB-LAST_VALUE NE '0.000' AND ITAB-LAST_VALUE NE ' '.
      ITAB-STATUS = 'OK'.
      IF ITAB-LAST_VALUE < WA_MAP_INSP_CHAR-TOLERANZUN OR ITAB-LAST_VALUE > WA_MAP_INSP_CHAR-TOLERANZOB.
        ITAB-STATUS = 'NOT OK'.
      ENDIF.
    ELSE.
      ITAB-STATUS = 'NOT YET'.
    ENDIF.

    IF V_EXCLUDE = 'X'.
      IF V_MATEXCLUDE NS ITAB-TYPE.
        CONCATENATE V_MATEXCLUDE ',' ITAB-TYPE INTO V_MATEXCLUDE.
      ENDIF.
    ELSE.
      APPEND ITAB.
    ENDIF.
    CLEAR ITAB.
  ENDLOOP.

  PERFORM GENERATE_ESTIMATION_DATE TABLES ITAB.
  CLEAR : V_MESSAGE.
  DELETE ADJACENT DUPLICATES FROM IT_MAP_INSP_CHAR.
  SORT ITAB BY INSPDATE INSPDATE ROLL TIMES SORT_KEY ASCENDING.
ENDFORM.                    "GET_DATA_PREVIEW

*&---------------------------------------------------------------------*
*&      Form  GENERATE_COLUMN_NAME

*&---------------------------------------------------------------------*
FORM GENERATE_COLUMN_NAME USING TYPE PRUEFLOS POINT CYCLE.
  CLEAR: V_COLUMN, CELL_COLOUR.
  IF TYPE CS 'WVTR' OR TYPE CS 'MVTR'.
    INSP_CHAR = ITAB-WVTR_CHAR.
  ELSEIF TYPE CS 'OTR' OR TYPE CS 'O2TR'.
    INSP_CHAR = ITAB-OTR_CHAR.
  ENDIF.
  LV_CYCLE_STR = CYCLE.
  CONDENSE LV_CYCLE_STR.
  CONCATENATE 'VALUE' LV_CYCLE_STR INTO V_COLUMN.
  READ TABLE IT_COMPARE WITH KEY PRUEFLOS = PRUEFLOS MERKNR = INSP_CHAR PROBENR = POINT STUECKNR = CYCLE.
  IF SY-SUBRC NE 0.
    ASSIGN COMPONENT V_COLUMN OF STRUCTURE ITAB TO <FS_VALUE>.
    IF <FS_VALUE> NE 0 OR <FS_VALUE> IS NOT INITIAL.
      CELL_COLOUR     = 5.
      ITAB-EDIT       = 'X'.
    ENDIF.
  ELSEIF SY-SUBRC EQ 0.
    ASSIGN COMPONENT V_COLUMN OF STRUCTURE ITAB TO <FS_VALUE>.
    IF <FS_VALUE> NE 0 OR <FS_VALUE> IS NOT INITIAL.
      IF IT_COMPARE-ATTRIBUT IS NOT INITIAL.                                            "Yellow (If Deleted Result Record
        CELL_COLOUR   = 3.
      ELSEIF <FS_VALUE> NE IT_COMPARE-MESSWERT AND IT_COMPARE-ATTRIBUT IS INITIAL.  "Green (If Change and there are different data
        CELL_COLOUR   = 5.
      ELSEIF <FS_VALUE> EQ IT_COMPARE-MESSWERT
         AND IT_COMPARE-ATTRIBUT IS INITIAL.                                             "Green (If Change and there are different data
        CELL_COLOUR   = 3.
      ENDIF.
    ENDIF.
  ELSE.
    ASSIGN COMPONENT V_COLUMN OF STRUCTURE ITAB TO <FS_VALUE>.
    IF <FS_VALUE> NE 0 OR <FS_VALUE> IS NOT INITIAL.                      "Red (Create or Change not be uploaded
      CELL_COLOUR     = 6.
    ENDIF.
  ENDIF.
  IF CELL_COLOUR IS NOT INITIAL.
    PERFORM SET_CELL_COLOURS TABLES ITAB-CELL_COLOR USING V_COLUMN CELL_COLOUR.
  ENDIF.
  UNASSIGN <FS_VALUE>.
ENDFORM.                    "GENERATE_COLUMN_NAME

