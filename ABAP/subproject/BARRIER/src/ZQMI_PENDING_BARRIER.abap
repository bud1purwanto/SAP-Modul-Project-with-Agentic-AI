*&      Form  CONFIRMATION

*&---------------------------------------------------------------------*
FORM CONFIRMATION.
  CLEAR: V_ERR, V_SIGN, V_NIK, V_ANSWER, V_DATE, V_POSISI.
  DATA : V_PREV_TIMES TYPE I, V_NEXT_TIMES TYPE I,  V_STATUS TYPE C LENGTH 10, V_APRV_STATUS TYPE C LENGTH 10, V_MAX_CYCLE TYPE I.
  DATA: LS_ZMAP_WORKCENTER TYPE ZMAP_TYPE.
  LOOP AT ITAB.
    ITAB-ZSTAT = GREY.
    ITAB-ERR  = ''.
    ITAB-MESS = ''.
    MODIFY ITAB.
  ENDLOOP.
  CLEAR : IT_OUTPUT.
  REFRESH : IT_OUTPUT.
  APPEND LINES OF ITAB TO IT_OUTPUT.
  IF NOT G_GRID IS INITIAL.
    CALL METHOD G_GRID->REFRESH_TABLE_DISPLAY.
  ENDIF.
  CLEAR: IT_RECORD, IT_UD, IT_COUNT_ROW, V_TFILL.


  REFRESH: IT_RECORD, IT_UD, IT_COUNT_ROW.
  LOOP AT ITAB WHERE BOX = 'X'.
    CLEAR : V_PREV_TIMES,V_STATUS,V_APRV_STATUS,V_POSISI,V_MAX_CYCLE.
    IF ITAB-CHARG = ''.
      ITAB-ZSTAT = ERROR.
      ITAB-ERR   = 'X'.
      ITAB-MESS  = 'Jumbo roll not yet slitted !'.
      V_ERR = 'X'.
      MODIFY ITAB.
    ELSE.
      " --- NEW: Validasi Jika Value Kosong Semua ---
      IF ITAB-VALUE1 IS INITIAL AND ITAB-VALUE2 IS INITIAL AND ITAB-VALUE3 IS INITIAL AND ITAB-VALUE4 IS INITIAL.
        ITAB-ZSTAT = ERROR.
        ITAB-ERR   = 'X'.
        ITAB-MESS  = 'Please input at least one value!'.
        V_ERR = 'X'.
        MODIFY ITAB.
        CONTINUE.
      ENDIF.
      " --- Validasi Pengisian Urut ---
      IF ITAB-VALUE4 IS NOT INITIAL AND ( ITAB-VALUE3 IS INITIAL OR ITAB-VALUE2 IS INITIAL OR ITAB-VALUE1 IS INITIAL ).
        ITAB-ZSTAT = ERROR.
        ITAB-ERR   = 'X'.
        ITAB-MESS  = 'Value must be filled sequentially (Val 1 -> Val 2 -> Val 3 -> Val 4)!'.
        V_ERR = 'X'.
        MODIFY ITAB.
        CONTINUE.
      ELSEIF ITAB-VALUE3 IS NOT INITIAL AND ( ITAB-VALUE2 IS INITIAL OR ITAB-VALUE1 IS INITIAL ).
        ITAB-ZSTAT = ERROR.
        ITAB-ERR   = 'X'.
        ITAB-MESS  = 'Value must be filled sequentially (Val 1 -> Val 2 -> Val 3)!'.
        V_ERR = 'X'.
        MODIFY ITAB.
        CONTINUE.
      ELSEIF ITAB-VALUE2 IS NOT INITIAL AND ITAB-VALUE1 IS INITIAL.
        ITAB-ZSTAT = ERROR.
        ITAB-ERR   = 'X'.
        ITAB-MESS  = 'Value must be filled sequentially (Val 1 -> Val 2)!'.
        V_ERR = 'X'.
        MODIFY ITAB.
        CONTINUE.
      ENDIF.

      " --- Validasi Wajib Isi Penuh Sesuai Cycle ---
      IF ITAB-CYCLE = 1.
        IF ITAB-VALUE1 IS INITIAL.
          ITAB-ZSTAT = ERROR.
          ITAB-ERR   = 'X'.
          ITAB-MESS  = 'Please fill Value 1 according to the sampling procedure (Cycle 1)!'.
          V_ERR = 'X'.
          MODIFY ITAB.
          CONTINUE.
        ENDIF.
      ELSEIF ITAB-CYCLE = 2.
        IF ITAB-VALUE1 IS INITIAL OR ITAB-VALUE2 IS INITIAL.
          ITAB-ZSTAT = ERROR.
          ITAB-ERR   = 'X'.
          ITAB-MESS  = 'Please fill up to Value 2 according to the sampling procedure (Cycle 2)!'.
          V_ERR = 'X'.
          MODIFY ITAB.
          CONTINUE.
        ENDIF.
      ELSEIF ITAB-CYCLE = 3.
        IF ITAB-VALUE1 IS INITIAL OR ITAB-VALUE2 IS INITIAL OR ITAB-VALUE3 IS INITIAL.
          ITAB-ZSTAT = ERROR.
          ITAB-ERR   = 'X'.
          ITAB-MESS  = 'Please fill up to Value 3 according to the sampling procedure (Cycle 3)!'.
          V_ERR = 'X'.
          MODIFY ITAB.
          CONTINUE.
        ENDIF.
      ELSEIF ITAB-CYCLE >= 4.
        IF ITAB-VALUE1 IS INITIAL OR ITAB-VALUE2 IS INITIAL OR ITAB-VALUE3 IS INITIAL OR ITAB-VALUE4 IS INITIAL.
          ITAB-ZSTAT = ERROR.
          ITAB-ERR   = 'X'.
          ITAB-MESS  = 'Please fill up to Value 4 according to the sampling procedure (Cycle 4)!'.
          V_ERR = 'X'.
          MODIFY ITAB.
          CONTINUE.
        ENDIF.
      ENDIF.
